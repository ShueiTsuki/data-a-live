+			pt_tm_setup(1);
 			pt_sleep(5000);
 			pt_log_codes("GPIOs as found");
 			pt_gpio_high_z();
 			pt_gpio_dump("after");
 			pt_sleep(3000);
 			pt_log_codes("GPIOs high impedance");
+		} else {
+			/* Android's order: the pins (pinctrl at probe), then the channels */
+			pt_gpio_high_z();
+			pt_tm_setup(1);
 		}
