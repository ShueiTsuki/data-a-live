 		__atomic_store_n(&pa_seen, req, __ATOMIC_RELEASE);
 		thread_wakeup((event_t)&pa_seen);
+		/* 0303: aud31, the user: the speaker's sound grows louder at its start ("声音是逐渐变大的"), where iOS's samples
+		 * in the ring rise about as much as the file's. The firmware's readouts (input into the amp from the DSP, its
+		 * voltage and current out) every 100 ms for 3 s after each power-up show which stage rises; a new request ends
+		 * them. */
+		for (unsigned k = 1; came_up && k <= 30 && __atomic_load_n(&pa_req, __ATOMIC_ACQUIRE) == seen; k++) {
+			char when[24];
+			pa_sleep(100);
+			snprintf(when, sizeof(when), "up +%u ms", k * 100);
+			if (pa_mode == PA_SPEAKER) {
+				pa_levels(0x40, when);
+			}
+			pa_levels(0x42, when);
+		}
 	}
 }
 
