 			fTimerAdded = true;
 			fRunning = true;
 			fTimer->setTimeoutMS(SWEET_BATTERY_POLL_MS);
+#if defined(PANDORA)
+			gPandoraBattery = this;
+#endif
 		} else {
 			fReal = false;
 			poll();
@@ -397,6 +425,9 @@ SweetBattery::stopPolling(OSObject *owner, void *, void *, void *, void *)
 	if (!self) {
 		return kIOReturnBadArgument;
 	}
+#if defined(PANDORA)
