+    uint64_t deadline;
+    clock_interval_to_deadline(1,NSEC_PER_MSEC,&deadline);
+    while ((*ahb&0x80000000) && mach_absolute_time()<deadline) __asm__ volatile("yield");
+    if (*ahb&0x80000000) { *ahb=old; return ETIMEDOUT; }
