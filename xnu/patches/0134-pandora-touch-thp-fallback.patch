+/* Fingers in panel pixels (1220 x 2656) -> SweetHIDTouch, which on PANDORA takes the
+ * presented 1125 x 2436 display's pixels (stretched with sweetfb_fill=1, else centred). */
+static void
+pt_deliver(uint32_t mask, const int *px, const int *py)
+{
+	if (sweet_fb_display_off) {
+		mask = 0;
+	}
+	for (unsigned id = 0; id < PT_MAX; id++) {
+		if (!(mask & (1u << id))) {
+			continue;
+		}
+		int x, y;
+		if (pt.fill) {
+			x = px[id] * 1125 / 1220;
+			y = py[id] * 2436 / 2656;
+		} else {
+			x = px[id] - (1220 - 1125) / 2;
+			y = py[id] - (2656 - 2436) / 2;
+		}
+		pt.px[id] = px[id];
+		pt.py[id] = py[id];
+		pt.x[id] = x;
+		pt.y[id] = y;
+		sweet_hid_touch((int)id, 1, x, y);
+	}
+	for (unsigned id = 0; id < PT_MAX; id++) {
+		if ((pt.active & (1u << id)) && !(mask & (1u << id))) {
+			sweet_hid_touch((int)id, 0, pt.x[id], pt.y[id]);
+		}
+	}
+	pt.active = mask;
+}
