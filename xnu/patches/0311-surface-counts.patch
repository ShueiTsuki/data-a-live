 	}
+	if (sweet_note_lock == NULL) {
+		IOLock *lock = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, lock, &sweet_note_lock)) {
+			IOLockFree(lock);
+		}
+	}
 }
 
