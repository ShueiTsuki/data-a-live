+	static const uint8_t oas_bits[16] = {32, 36, 40, 42, 44, 48};
+	unsigned oas = ((id2 >> 4) & 15) < 6 ? oas_bits[(id2 >> 4) & 15] : 0;
+	if (oas > 40) {
+		oas = 40;
+	}
+
