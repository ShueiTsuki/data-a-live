+/* A new speaker instance, started (described) but not published. */
+static IOAudio2Device *
+pa_new_speaker(IOService *provider)
+{
+	IOAudio2Device *d = OSTypeAlloc(IOAudio2Device);
+	if (d == nullptr || !d->init()) {
+		OSSafeReleaseNULL(d);
+		return nullptr;
+	}
+	if (!d->attach(provider)) {
+		d->release();
+		return nullptr;
+	}
+	if (!d->start(provider)) {
+		d->detach(provider);
+		d->release();
+		return nullptr;
+	}
+	return d;
+}
