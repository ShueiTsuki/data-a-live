+};
+static int pt_step[3] = {-1, -1, -1};
+
+extern void pandora_cpu_body_cap(uint32_t khz0, uint32_t khz6);   /* bsd/dev/pandora_cpu.c */
+extern uint32_t pandora_gpu_body_top;                             /* bsd/dev/pandora_gpu.c */
