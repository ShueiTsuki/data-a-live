--- a/bsd/dev/pandora_gpu.c
+++ b/bsd/dev/pandora_gpu.c
@@ -3249,6 +3249,128 @@ gpu_hang_ib(const char *tag, uint64_t base, uint32_t init, uint32_t rem)
