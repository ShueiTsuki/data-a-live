- * 0x2c while charging (battui §2.2); that filter is not known yet.
+ * The battery itself is the bq27z561 gauge's (bsd/dev/pandora_amp.c, pandora_gauge=3): voltage,
+ * current (positive while charging), temperature, the mAh figures and cycles; the percentage as
+ * ad_display_percent. Android's battery psy (mca_business_battery batt_psy_get_prop, battui RESULT
+ * §3.1, §5): not online is discharging; online with the percentage at 100 and charging done
+ * (BatteryStatus FC, bit 5) is full; otherwise charging. Temperature is 0x06 in 0.1 K less 2730.
+ * Online is ad_set_online's (the SOCCP's, pandora_battery=1) while it is under a minute old, without
+ * it charge current.
+ */
+#define AD_SOC_PROPORTION_C 97           /* DT soc-proportion-c = <0x61>, pandora-live.dts 41344 */
+
+/*
+ * The percentage Android shows (mca_strategy_fg_comp fg_ui_soc_smooth, the path at 0x916c that
+ * non-EU models take charging or not: the EU switch [+0xad8] is set by event 0x3a, "is_eu_model";
+ * battui2 §3.3-3.5): remaining over full charge in 0.01 %, 97 % of it stretched to 100 %. Android
+ * computes it every 5 s (fg_update_status) and then moves what it shows towards it a point at a time;
+ * that step timing is not taken over yet.
  */
+static int
+ad_display_percent(const struct pandora_gauge *g)
+{
+	if (g->full_mah <= 0 || g->remaining_mah < 0) {
+		return g->soc < 0 ? 0 : g->soc > 100 ? 100 : g->soc;
+	}
+	const int64_t r = 10000LL * g->remaining_mah / g->full_mah;
+	if (r <= 0) {
+		return 0;
+	}
+	if (r > AD_SOC_PROPORTION_C * 100) {
+		return 100;
+	}
+	int64_t s = 10000LL * (r + 100) / (AD_SOC_PROPORTION_C * 100 + 100);
+	return (int)(s > 10000 ? 100 : s / 100);
+}
