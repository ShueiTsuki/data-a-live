+		return 0;
+	}
+	if (fScanMaps[slot].s != NULL) {
+		pandora_scanout_unmap(fScanMaps[slot].iova, fScanMaps[slot].pages);
+		OSSafeReleaseNULL(fScanMaps[slot].s);
