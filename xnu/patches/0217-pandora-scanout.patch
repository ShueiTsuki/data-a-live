+	const uint32_t n = (uint32_t)((len + 0xfff) >> 12);
+	uint64_t *pages = (uint64_t *)IOMallocData((vm_size_t)n * sizeof(uint64_t));
+	if (pages == NULL) {
+		return 0;
+	}
+	bool ok = true;
+	for (uint32_t i = 0; i < n && ok; i++) {
