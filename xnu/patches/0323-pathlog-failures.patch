+#if defined(PANDORA)
+/*
+ * PANDORA (0323): boot-arg pandora_pathlog=NAME:TEXT logs each open (plain or data-protected) or mkdir of a
+ * process named NAME that fails on a path containing TEXT, or on a name relative to a directory whose path
+ * contains it, with the directory, the flags, the protection class and the error; the first 400. (Without
+ * ":TEXT" pandora_pathlog keeps 0285's meaning below.) A mkdir of something that exists is not logged.
+ */
+static void
+pandora_pathlog_failed(vfs_context_t ctx, const char *op, int fd, user_addr_t path, enum uio_seg segflg,
+    int flags, int class, int error)
+{
+	static int state;                       /* 0 not read yet, 1 off, 2 on */
+	static char want[32], text[32];
+	static uint32_t lines;
+	if (error == 0) {
+		return;
+	}
+	if (state == 0) {
+		char arg[64];
+		state = 1;
+		if (PE_parse_boot_arg_str("pandora_pathlog", arg, sizeof(arg))) {
+			for (size_t i = 0; arg[i] != 0 && i < sizeof(want) - 1; i++) {
+				if (arg[i] == ':') {
+					memcpy(want, arg, i);
+					strlcpy(text, arg + i + 1, sizeof(text));
+					state = want[0] && text[0] ? 2 : 1;
+					break;
+				}
+			}
+		}
+	}
+	if (state != 2 || lines >= 400) {
+		return;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	if (strncmp(name, want, sizeof(name)) != 0) {
+		return;
+	}
+	char p[256];
+	size_t len = 0;
+	if ((segflg == UIO_SYSSPACE ? copystr(CAST_DOWN(void *, path), p, sizeof(p), &len) :
+	    copyinstr(path, p, sizeof(p), &len)) != 0) {
+		return;
+	}
+	char dir[256] = "";
+	if (p[0] != '/' && fd != AT_FDCWD) {
+		vnode_t dvp = NULLVP;
+		if (vnode_getfromfd(ctx, fd, &dvp) == 0) {
+			int dlen = sizeof(dir);
+			if (vn_getpath(dvp, dir, &dlen) != 0) {
+				dir[0] = 0;
+			}
+			vnode_put(dvp);
+		}
+	}
+	if (strnstr(p, text, sizeof(p)) == NULL && strnstr(dir, text, sizeof(dir)) == NULL) {
+		return;
+	}
+	lines++;
+	printf("PANDORA PATH: %s %s %s%s%s flags %#x class %d -> %d\n", name, op, dir, dir[0] ? "/" : "", p,
+	    flags, class, error);
+}
+#endif /* PANDORA */
