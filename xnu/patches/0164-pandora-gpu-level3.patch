 #define SCM_FN(svc, cmd)  ((1ULL << 30) | (2ULL << 24) | (((uint64_t)(svc) & 0xff) << 8) | ((cmd) & 0xff))
 #define SCM_ARGS(n)       ((uint64_t)(n) & 0xf)
 #define SCM_RW            2u
