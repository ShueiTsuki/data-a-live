+machine		"arm64"						# <arm64>
+
+makeoptions	OSFMK_MACHINE = "arm64"				# <mach>
+
+options		COUNT_SYSCALLS		# count bsd system calls 	# <countcalls>
+options     TRASH_VFP_ON_SAVE   # <debug,trash_vfp>
+options		ALTERNATE_DEBUGGER	# <alternate_debugger>
+
+options   CONFIG_VNODES=1024		# <xsmall>
+
+options   CONFIG_FREEZE_SUSPENDED_MIN=4		# <xsmall>
+
+options	  CONFIG_MACH_APPROXIMATE_TIME
+
+options   CONFIG_KERNEL_INTEGRITY		# <kernel_integrity>
+
+options CONFIG_MACF_LAZY_VNODE_LABELS   # Turn on labels, don't preallocate
+
+options CONFIG_HYPERVISOR_PUBLIC   # unrestricted entitlement for hypervisor
+
+options   CONFIG_RESLIDE_SHARED_CACHE		# <reslide_shared_cache>
+options   CONFIG_KERNEL_TBI		# <kernel_tbi>
diff --git a/libkern/conf/Makefile.template b/libkern/conf/Makefile.template
index 26a56b4..9eae6fe 100644
--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -19,7 +19,7 @@ include $(MakeInc_def)
 CFLAGS+= -include meta_features.h -DLIBKERN_KERNEL_PRIVATE -DOSALLOCDEBUG=1
 SFLAGS+= -include meta_features.h
 
-ifneq ($(filter SWEET FUXI,$(CURRENT_MACHINE_CONFIG)),)
+ifneq ($(filter SWEET FUXI PANDORA,$(CURRENT_MACHINE_CONFIG)),)
 SWEET_AES_ROOT = $(SRCROOT)/libkern/crypto/sweet_bearssl
 SWEET_AES_INC = -I$(SWEET_AES_ROOT)/inc -I$(SWEET_AES_ROOT)/src
 sweet_aes.o_INCFLAGS = $(SWEET_AES_INC)
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 043f6b2..ff2c49a 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET FUXI
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET FUXI PANDORA
 
 endif
 
@@ -64,6 +64,8 @@ MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
 # Reuse the generic ARM/SWEET providers with explicitly gated Fuxi hardware.
 MACHINE_FLAGS_ARM64_FUXI = -DARM64_BOARD_CONFIG_SWEET -DFUXI=1       -march=armv8.2-a+crypto
+# Xiaomi 17 Pro (pandora, SM8850): Fuxi providers with 4 KiB pages (no 16K granule on Oryon).
+MACHINE_FLAGS_ARM64_PANDORA = -DARM64_BOARD_CONFIG_SWEET -DFUXI=1 -DPANDORA=1 -march=armv8.2-a+crypto
 
 
 #
@@ -263,7 +265,7 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
 # sweet's Cortex-A76/A55 have no pointer authentication: stay plain arm64
-ifeq ($(filter SWEET FUXI,$(CURRENT_MACHINE_CONFIG)),)
+ifeq ($(filter SWEET FUXI PANDORA,$(CURRENT_MACHINE_CONFIG)),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
 endif
