+				}
 				if (lc->cmd == LC_SEGMENT_SPLIT_INFO) {
 					isSplitKext = true;
 					continue;
@@ -1066,6 +1115,10 @@ kalloc_type_view_parse(const kalloc_type_variant_t type)
 
 				kernel_segment_command_t *seg_cmd =
 				    (struct segment_command_64 *)(vm_offset_t)lc;
+				if (macho_list && (lc->cmdsize < sizeof(*seg_cmd) ||
