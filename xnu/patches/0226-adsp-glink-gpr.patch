diff --git a/bsd/dev/qcom/QcomGlink.c b/bsd/dev/qcom/QcomGlink.c
new file mode 100644
index 0000000..03fb054
--- /dev/null
+++ b/bsd/dev/qcom/QcomGlink.c
@@ -0,0 +1,448 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomGlink.h"
+
+/* The sender keeps 8 bytes so a full FIFO never looks empty, and 16 more for a READ_NOTIF when it runs out of room. */
+#define FULL_RESERVE 8u
+#define BLOCKED_RESERVE 16u
+#define GLINK_VERSION_1 1u
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb osh" ::: "memory");
+#endif
+}
+static uint32_t align8(uint32_t v) {return (v + 7u) & ~7u;}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;}
+static void put32(uint8_t *p, uint32_t v) {p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);}
+static size_t name_length(const char *s) {size_t n = 0; while (n < QCOM_GLINK_NAME - 1 && s[n]) ++n; return n;}
+
+uint32_t qcom_glink_rx_avail(const QcomGlinkFifo *f)
+{
+    if (!f->data || !f->length) return 0;
+    const uint32_t head = *f->head, tail = *f->tail;
+    if (head >= f->length || tail >= f->length) return 0;
+    return head >= tail ? head - tail : f->length - tail + head;
+}
+
+uint32_t qcom_glink_tx_avail(const QcomGlinkFifo *f)
+{
+    const uint32_t head = *f->head, tail = *f->tail;
+    if (head >= f->length || tail >= f->length) return 0;
+    const uint32_t avail = tail <= head ? f->length - head + tail : tail - head;
+    return avail < FULL_RESERVE + BLOCKED_RESERVE ? 0 : avail - FULL_RESERVE - BLOCKED_RESERVE;
+}
+
+static void rx_peek(const QcomGlinkFifo *f, uint32_t offset, uint8_t *to, uint32_t count)
+{
+    uint32_t at = *f->tail + offset;
+    if (at >= f->length) at -= f->length;
+    for (uint32_t i = 0; i < count; ++i) {
+        to[i] = f->data[at];
+        if (++at == f->length) at = 0;
+    }
+}
+
+static void rx_advance(QcomGlinkFifo *f, uint32_t count)
+{
+    uint32_t tail = *f->tail + count;
+    if (tail >= f->length) tail -= f->length;
+    barrier();
+    *f->tail = tail;
+}
+
+/* Writes header and payload as one message (padded to 8 bytes); the caller checked the room. */
+static void tx_write(QcomGlink *g, const uint8_t *header, uint32_t header_length, const uint8_t *data, uint32_t data_length)
+{
+    QcomGlinkFifo *f = &g->tx;
+    uint32_t head = *f->head;
+    for (uint32_t i = 0; i < header_length; ++i) {f->data[head] = header[i]; if (++head == f->length) head = 0;}
+    for (uint32_t i = 0; i < data_length; ++i) {f->data[head] = data[i]; if (++head == f->length) head = 0;}
+    head = align8(head);
+    if (head >= f->length) head -= f->length;
+    barrier();
+    *f->head = head;
+    g->tx_messages++;
+    g->kick_pending = 1;
+}
+
+static int tx(QcomGlink *g, const uint8_t *header, uint32_t header_length, const uint8_t *data, uint32_t data_length)
+{
+    if (align8(header_length + data_length) > qcom_glink_tx_avail(&g->tx)) return QcomGlinkAgain;
+    tx_write(g, header, header_length, data, data_length);
+    return QcomGlinkOk;
+}
+
+static int command(QcomGlink *g, uint16_t cmd, uint16_t param1, uint32_t param2)
+{
+    uint8_t m[8];
+    m[0] = (uint8_t)cmd; m[1] = (uint8_t)(cmd >> 8); m[2] = (uint8_t)param1; m[3] = (uint8_t)(param1 >> 8);
+    put32(m + 4, param2);
+    return tx(g, m, 8, 0, 0);
+}
+
+void qcom_glink_init(QcomGlink *g, QcomGlinkFifo txf, QcomGlinkFifo rxf, void (*kick)(void *), void *kick_context)
+{
+    for (size_t i = 0; i < sizeof *g; ++i) ((uint8_t *)g)[i] = 0;
+    g->tx = txf;
+    g->rx = rxf;
+    g->kick = kick;
+    g->kick_context = kick_context;
+    g->features = QCOM_GLINK_FEATURE_INTENT_REUSE;
+    g->next_lcid = 1;
+    *g->tx.head = 0;
+    *g->rx.tail = 0;
+    barrier();
+}
+
+void qcom_glink_set_rx(QcomGlink *g, volatile uint8_t *data, uint32_t length)
+{
+    g->rx.data = data;
+    g->rx.length = length;
+}
+
+QcomGlinkChannel *qcom_glink_channel(QcomGlink *g, const char *name, uint32_t intent_size, uint32_t intent_count, uint8_t *storage,
+                                     const QcomGlinkClient *client, void *context, int open_now)
+{
+    if (!name || !client || intent_count > QCOM_GLINK_MAX_LOCAL_INTENTS || (intent_count && (!storage || !intent_size))) return 0;
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS; ++i) {
+        QcomGlinkChannel *c = &g->channel[i];
+        if (c->used) continue;
+        for (size_t b = 0; b < sizeof *c; ++b) ((uint8_t *)c)[b] = 0;
+        const size_t n = name_length(name);
+        for (size_t b = 0; b < n; ++b) c->name[b] = name[b];
+        c->used = 1;
+        c->lcid = g->next_lcid++;
+        c->client = *client;
+        c->context = context;
+        c->storage = storage;
+        c->intent_size = intent_size;
+        c->intent_count = intent_count;
+        c->initiator = open_now != 0;
+        c->open_sent = open_now ? 0 : 2;  /* 2: wait for the remote's OPEN before sending ours */
+        return c;
+    }
+    return 0;
+}
+
+static QcomGlinkChannel *by_lcid(QcomGlink *g, uint32_t lcid)
+{
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS; ++i)
+        if (g->channel[i].used && g->channel[i].lcid == lcid) return &g->channel[i];
+    return 0;
+}
+static QcomGlinkChannel *by_rcid(QcomGlink *g, uint32_t rcid)
+{
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS; ++i)
+        if (g->channel[i].used && g->channel[i].remote_open && g->channel[i].rcid == rcid) return &g->channel[i];
+    return 0;
+}
+
+static int send_open(QcomGlink *g, QcomGlinkChannel *c)
+{
+    uint8_t m[8];
+    const uint32_t n = (uint32_t)name_length(c->name) + 1;
+    m[0] = QCOM_GLINK_OPEN; m[1] = 0; m[2] = (uint8_t)c->lcid; m[3] = (uint8_t)(c->lcid >> 8);
+    put32(m + 4, n);
+    if (align8(8 + n) > qcom_glink_tx_avail(&g->tx)) return QcomGlinkAgain;
+    tx_write(g, m, 8, (const uint8_t *)c->name, n);
+    c->open_sent = 1;
+    return QcomGlinkOk;
+}
+
+static int advertise(QcomGlink *g, QcomGlinkChannel *c, unsigned index)
+{
+    uint8_t m[16];
+    m[0] = QCOM_GLINK_INTENT; m[1] = 0; m[2] = (uint8_t)c->lcid; m[3] = (uint8_t)(c->lcid >> 8);
+    put32(m + 4, 1);
+    put32(m + 8, c->intent_size);
+    put32(m + 12, index + 1);
+    const int rc = tx(g, m, 16, 0, 0);
+    if (!rc) {c->local[index].advertised = 1; c->local[index].fill = 0;}
+    return rc;
+}
+
+static void reset_channel(QcomGlinkChannel *c)
+{
+    c->open_acked = c->remote_open = c->up = c->intent_asked = 0;
+    c->open_sent = c->initiator ? 0 : 2;
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_LOCAL_INTENTS; ++i) c->local[i].advertised = c->local[i].busy = 0, c->local[i].fill = 0;
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_REMOTE_INTENTS; ++i) c->remote[i].valid = 0;
+}
+
+/* Channel bring-up and our intents: whatever is due and fits in the FIFO now. */
+static void progress(QcomGlink *g)
+{
+    if (!g->version_sent) {
+        if (command(g, QCOM_GLINK_VERSION, GLINK_VERSION_1, g->features)) return;
+        g->version_sent = 1;
+    }
+    if (!g->version_agreed) return;
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS; ++i) {
+        QcomGlinkChannel *c = &g->channel[i];
+        if (!c->used) continue;
+        if (c->open_sent == 0 || (c->open_sent == 2 && c->remote_open)) {
+            if (send_open(g, c)) return;
+        }
+        if (c->open_sent == 1 && c->open_acked && c->remote_open && !c->up) {
+            for (unsigned k = 0; k < c->intent_count; ++k)
+                if (!c->local[k].advertised && advertise(g, c, k)) return;
+            c->up = 1;
+            if (c->client.state) c->client.state(c->context, c, 1);
+        }
+        if (c->up)
+            for (unsigned k = 0; k < c->intent_count; ++k)
+                if (!c->local[k].advertised && !c->local[k].busy && advertise(g, c, k)) return;
+    }
+}
+
+static int handle_data(QcomGlink *g, uint16_t cmd, uint32_t rcid, uint32_t liid, uint32_t avail)
+{
+    uint8_t h[16];
+    if (avail < 16) return 0;
+    rx_peek(&g->rx, 0, h, 16);
+    const uint32_t chunk = le32(h + 8), left = le32(h + 12);
+    if (chunk > g->rx.length || align8(16 + chunk) < chunk) return QcomGlinkCorrupt;
+    if (avail < 16 + chunk) return 0;  /* not all there yet */
+    QcomGlinkChannel *c = by_rcid(g, rcid);
+    const unsigned index = liid - 1;
+    if (!c || !liid || index >= c->intent_count || !c->local[index].advertised) {
+        g->dropped++;
+    } else {
+        uint32_t fill = cmd == QCOM_GLINK_TX_DATA ? 0 : c->local[index].fill;
+        if ((uint64_t)fill + chunk + left > c->intent_size) {
+            g->dropped++;
+            fill = 0;
+        } else {
+            rx_peek(&g->rx, 16, c->storage + (size_t)index * c->intent_size + fill, chunk);
+            fill += chunk;
+            if (!left) {
+                c->local[index].busy = 1;
+                g->rx_data++;
+                if (c->client.receive) c->client.receive(c->context, c, c->storage + (size_t)index * c->intent_size, fill);
+                c->local[index].busy = 0;
+                fill = 0;
+                /* The intent is ours again once the remote knows it is done; with reuse it stays advertised. */
+                const int reuse = (g->features & QCOM_GLINK_FEATURE_INTENT_REUSE) != 0;
+                if (command(g, reuse ? QCOM_GLINK_RX_DONE_W_REUSE : QCOM_GLINK_RX_DONE, c->lcid, liid) == QcomGlinkOk && !reuse)
+                    c->local[index].advertised = 0;
+            }
+        }
+        c->local[index].fill = fill;
+    }
+    rx_advance(&g->rx, align8(16 + chunk));
+    return 1;
+}
+
+/* One message at the FIFO tail: 1 handled, 0 incomplete (wait for more), negative on a broken stream. */
+
+/* Adds name to the list of opens nobody serves unless it is there already or does not fit. */
+static void note_unknown(QcomGlink *g, const char *name)
+{
+    char *list = g->unknown_names;
+    const unsigned cap = sizeof g->unknown_names;
+    unsigned n = 0, used = 0;
+    while (n < QCOM_GLINK_NAME && name[n]) ++n;
+    while (used < cap && list[used]) ++used;
+    for (unsigned at = 0; at < used;) {
+        unsigned end = at;
+        while (end < used && list[end] != ' ') ++end;
+        unsigned same = end - at == n;
+        for (unsigned b = 0; same && b < n; ++b) same = list[at + b] == name[b];
+        if (same) return;
+        at = end + 1;
+    }
+    if (!n || used + (used ? 1 : 0) + n + 1 > cap) return;
+    if (used) list[used++] = ' ';
+    for (unsigned b = 0; b < n; ++b) list[used++] = name[b];
+    list[used] = 0;
+}
+static int receive_one(QcomGlink *g)
+{
+    const uint32_t avail = qcom_glink_rx_avail(&g->rx);
+    uint8_t m[8];
+    if (avail < 8) return 0;
+    rx_peek(&g->rx, 0, m, 8);
+    const uint16_t cmd = (uint16_t)(m[0] | m[1] << 8), param1 = (uint16_t)(m[2] | m[3] << 8);
+    const uint32_t param2 = le32(m + 4);
+    QcomGlinkChannel *c;
+    switch (cmd) {
+    case QCOM_GLINK_VERSION:
+        if (param1 == GLINK_VERSION_1) g->features &= param2;
+        if (param1 && command(g, QCOM_GLINK_VERSION_ACK, GLINK_VERSION_1, g->features)) return 0;
+        g->version_agreed = param1 != 0;
+        break;
+    case QCOM_GLINK_VERSION_ACK:
+        if (param1 == GLINK_VERSION_1 && param2 != g->features) {
+            g->features &= param2;
+            if (command(g, QCOM_GLINK_VERSION, GLINK_VERSION_1, g->features)) return 0;
+        }
+        g->version_agreed = param1 != 0;
+        break;
+    case QCOM_GLINK_OPEN: {
+        const uint32_t n = param2 & 0xffff;
+        if (n > g->rx.length || n == 0) return QcomGlinkCorrupt;
+        if (avail < 8 + n) return 0;
+        char name[QCOM_GLINK_NAME] = {0};
+        rx_peek(&g->rx, 8, (uint8_t *)name, n < QCOM_GLINK_NAME ? n : QCOM_GLINK_NAME - 1);
+        name[QCOM_GLINK_NAME - 1] = 0;
+        c = 0;
+        for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS && !c; ++i) {
+            QcomGlinkChannel *k = &g->channel[i];
+            unsigned same = k->used;
+            for (unsigned b = 0; same && b < QCOM_GLINK_NAME; ++b) {
+                if (k->name[b] != name[b]) same = 0;
+                if (!name[b]) break;
+            }
+            if (same) c = k;
+        }
+        if (!c) {
+            g->unknown_opens++;
+            for (unsigned b = 0; b < QCOM_GLINK_NAME; ++b) g->last_unknown[b] = name[b];
+            note_unknown(g, name);
+        } else {
+            if (c->remote_open && c->up && c->client.state) c->client.state(c->context, c, 0);
+            if (c->remote_open) reset_channel(c);
+            if (command(g, QCOM_GLINK_OPEN_ACK, param1, 0)) return 0;
+            c->rcid = param1;
+            c->remote_open = 1;
+        }
+        rx_advance(&g->rx, align8(8 + n));
+        g->rx_messages++;
+        return 1;
+    }
+    case QCOM_GLINK_OPEN_ACK:
+        if ((c = by_lcid(g, param1)) && c->open_sent == 1) c->open_acked = 1;
+        break;
+    case QCOM_GLINK_CLOSE:
+        if (command(g, QCOM_GLINK_CLOSE_ACK, param1, 0)) return 0;
+        if ((c = by_rcid(g, param1))) {
+            const int was = c->up;
+            if (c->open_sent == 1 && command(g, QCOM_GLINK_CLOSE, c->lcid, 0)) return 0;
+            reset_channel(c);
+            if (was && c->client.state) c->client.state(c->context, c, 0);
+        }
+        break;
+    case QCOM_GLINK_CLOSE_ACK:
+        break;
+    case QCOM_GLINK_INTENT: {
+        if (param2 > (g->rx.length - 8) / 8) return QcomGlinkCorrupt;
+        const uint32_t bytes = 8 + 8 * param2;
+        if (avail < bytes) return 0;
+        c = by_rcid(g, param1);
+        for (uint32_t i = 0; i < param2; ++i) {
+            uint8_t pair[8];
+            rx_peek(&g->rx, 8 + 8 * i, pair, 8);
+            if (!c) continue;
+            unsigned slot = QCOM_GLINK_MAX_REMOTE_INTENTS;
+            for (unsigned k = 0; k < QCOM_GLINK_MAX_REMOTE_INTENTS; ++k)
+                if (!c->remote[k].valid) {slot = k; break;}
+            if (slot == QCOM_GLINK_MAX_REMOTE_INTENTS) {g->dropped++; continue;}
+            c->remote[slot].size = le32(pair);
+            c->remote[slot].id = le32(pair + 4);
+            c->remote[slot].valid = 1;
+            c->remote[slot].busy = 0;
+        }
+        if (c) c->intent_asked = 0;
+        rx_advance(&g->rx, align8(bytes));
+        g->rx_messages++;
+        return 1;
+    }
+    case QCOM_GLINK_RX_DONE:
+    case QCOM_GLINK_RX_DONE_W_REUSE:
+        if ((c = by_rcid(g, param1)))
+            for (unsigned k = 0; k < QCOM_GLINK_MAX_REMOTE_INTENTS; ++k)
+                if (c->remote[k].valid && c->remote[k].id == param2) {
+                    c->remote[k].busy = 0;
+                    if (cmd == QCOM_GLINK_RX_DONE) c->remote[k].valid = 0;
+                    break;
+                }
+        break;
+    case QCOM_GLINK_RX_INTENT_REQ: {
+        /* Grant it if a buffer of ours that is big enough is not advertised (all are, normally: then refuse). */
+        int granted = 0;
+        if ((c = by_rcid(g, param1)) && c->up && param2 <= c->intent_size)
+            for (unsigned k = 0; k < c->intent_count; ++k)
+                if (!c->local[k].advertised && !c->local[k].busy) {
+                    if (advertise(g, c, k)) return 0;
+                    granted = 1;
+                    break;
+                }
+        if (command(g, QCOM_GLINK_RX_INTENT_REQ_ACK, c ? c->lcid : param1, (uint32_t)granted)) return 0;
+        break;
+    }
+    case QCOM_GLINK_RX_INTENT_REQ_ACK:
+        if ((c = by_rcid(g, param1)) && !param2) c->intent_asked = 0;
+        break;
+    case QCOM_GLINK_TX_DATA:
+    case QCOM_GLINK_TX_DATA_CONT: {
+        const int rc = handle_data(g, cmd, param1, param2, avail);
+        if (rc == 1) g->rx_messages++;
+        return rc;
+    }
+    case QCOM_GLINK_READ_NOTIF:
+        g->kick_pending = 1;
+        break;
+    case QCOM_GLINK_SIGNALS:
+        break;
+    default:
+        return QcomGlinkCorrupt;
+    }
+    rx_advance(&g->rx, 8);
+    g->rx_messages++;
+    return 1;
+}
+
+int qcom_glink_poll(QcomGlink *g)
+{
+    if (g->broken) return QcomGlinkCorrupt;
+    int handled = 0;
+    g->notify_sent = 0;
+    progress(g);
+    /* Bounded: at most one FIFO's worth of minimal messages per call. */
+    for (uint32_t budget = g->rx.length / 8 + 1; g->rx.data && budget; --budget) {
+        const int rc = receive_one(g);
+        if (rc < 0) {g->broken = 1; handled = rc; break;}
+        if (!rc) break;
+        ++handled;
+    }
+    if (!g->broken) progress(g);
+    if (g->kick_pending && g->kick) {g->kick_pending = 0; g->kick(g->kick_context);}
+    return handled;
+}
+
+int qcom_glink_send(QcomGlink *g, QcomGlinkChannel *c, const void *data, uint32_t length)
+{
+    if (!g || !c || (!data && length)) return QcomGlinkArgument;
+    if (g->broken || !c->up) return QcomGlinkNotOpen;
+    if (align8(16 + length) > g->tx.length / 2) return QcomGlinkTooBig;
+    unsigned best = QCOM_GLINK_MAX_REMOTE_INTENTS;
+    for (unsigned k = 0; k < QCOM_GLINK_MAX_REMOTE_INTENTS; ++k)
+        if (c->remote[k].valid && !c->remote[k].busy && c->remote[k].size >= length &&
+            (best == QCOM_GLINK_MAX_REMOTE_INTENTS || c->remote[k].size < c->remote[best].size))
+            best = k;
+    if (best == QCOM_GLINK_MAX_REMOTE_INTENTS) {
+        if (!c->intent_asked && command(g, QCOM_GLINK_RX_INTENT_REQ, c->lcid, length) == QcomGlinkOk) c->intent_asked = 1;
+        if (g->kick_pending && g->kick) {g->kick_pending = 0; g->kick(g->kick_context);}
+        return QcomGlinkAgain;
+    }
+    uint8_t h[16];
+    h[0] = QCOM_GLINK_TX_DATA; h[1] = 0; h[2] = (uint8_t)c->lcid; h[3] = (uint8_t)(c->lcid >> 8);
+    put32(h + 4, c->remote[best].id);
+    put32(h + 8, length);
+    put32(h + 12, 0);
+    if (tx(g, h, 16, (const uint8_t *)data, length)) {
+        /* Ask the remote to ring us once it has read, so the owner retries then. */
+        const uint32_t head = *g->tx.head, tail = *g->tx.tail;
+        if (!g->notify_sent && head < g->tx.length && tail < g->tx.length) {
+            uint8_t m[8] = {QCOM_GLINK_READ_NOTIF, 0, 0, 0, 0, 0, 0, 0};
+            const uint32_t raw = tail <= head ? g->tx.length - head + tail : tail - head;
+            if (raw >= FULL_RESERVE + 8) {tx_write(g, m, 8, 0, 0); g->notify_sent = 1;}
+        }
+        if (g->kick_pending && g->kick) {g->kick_pending = 0; g->kick(g->kick_context);}
+        return QcomGlinkAgain;
+    }
+    c->remote[best].busy = 1;
+    if (g->kick) {g->kick_pending = 0; g->kick(g->kick_context);}
+    return QcomGlinkOk;
+}
diff --git a/bsd/dev/qcom/QcomGlink.h b/bsd/dev/qcom/QcomGlink.h
new file mode 100644
index 0000000..06975d9
--- /dev/null
+++ b/bsd/dev/qcom/QcomGlink.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* GLINK over shared memory: the native GLINK protocol (version handshake, channel open/close, receive intents, data, done) on a pair of
+ * SMEM FIFOs. Event driven and allocation free: the owner calls qcom_glink_poll whenever the remote rings the GLINK doorbell (and after
+ * sending), every call does a bounded amount of work, and nothing here waits. A send that cannot go out yet (no remote intent, no FIFO
+ * room) returns QcomGlinkAgain and the owner tries again on the next event; an intent is asked for once per pending send. */
+#ifndef QCOM_GLINK_H
+#define QCOM_GLINK_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_GLINK_MAX_CHANNELS 6u
+#define QCOM_GLINK_MAX_REMOTE_INTENTS 24u
+#define QCOM_GLINK_MAX_LOCAL_INTENTS 24u
+#define QCOM_GLINK_NAME 32u
+#define QCOM_GLINK_FEATURE_INTENT_REUSE 1u
+
+enum {
+    QCOM_GLINK_VERSION = 0, QCOM_GLINK_VERSION_ACK = 1, QCOM_GLINK_OPEN = 2, QCOM_GLINK_CLOSE = 3, QCOM_GLINK_OPEN_ACK = 4,
+    QCOM_GLINK_INTENT = 5, QCOM_GLINK_RX_DONE = 6, QCOM_GLINK_RX_INTENT_REQ = 7, QCOM_GLINK_RX_INTENT_REQ_ACK = 8,
+    QCOM_GLINK_TX_DATA = 9, QCOM_GLINK_CLOSE_ACK = 11, QCOM_GLINK_TX_DATA_CONT = 12, QCOM_GLINK_READ_NOTIF = 13,
+    QCOM_GLINK_RX_DONE_W_REUSE = 14, QCOM_GLINK_SIGNALS = 15,
+};
+
+enum {
+    QcomGlinkOk = 0,
+    QcomGlinkAgain = -1,    /* not now: no intent or no FIFO room yet */
+    QcomGlinkNotOpen = -2,
+    QcomGlinkTooBig = -3,
+    QcomGlinkFull = -4,     /* no channel slot */
+    QcomGlinkCorrupt = -5,  /* the receive FIFO holds something that cannot be a message: the link is stopped */
+    QcomGlinkArgument = -6,
+};
+
+/* One direction's FIFO in SMEM: indices are byte offsets into data. */
+typedef struct {
+    volatile uint32_t *head, *tail;
+    volatile uint8_t *data;
+    uint32_t length;
+} QcomGlinkFifo;
+
+typedef struct QcomGlinkChannel QcomGlinkChannel;
+typedef struct {
+    void (*state)(void *context, QcomGlinkChannel *channel, int up);
+    /* A complete message; data stays valid for the duration of the call only. */
+    void (*receive)(void *context, QcomGlinkChannel *channel, const uint8_t *data, uint32_t length);
+} QcomGlinkClient;
+
+struct QcomGlinkChannel {
+    char name[QCOM_GLINK_NAME];
+    uint16_t lcid, rcid;
+    uint8_t used, initiator, open_sent, open_acked, remote_open, up, intent_asked;
+    QcomGlinkClient client;
+    void *context;
+    /* Our receive intents: count buffers of size bytes in storage (count * size). */
+    uint8_t *storage;
+    uint32_t intent_size, intent_count;
+    struct {uint32_t fill; uint8_t advertised, busy;} local[QCOM_GLINK_MAX_LOCAL_INTENTS];
+    /* The remote's intents we may send into. */
+    struct {uint32_t id, size; uint8_t valid, busy;} remote[QCOM_GLINK_MAX_REMOTE_INTENTS];
+};
+
+typedef struct {
+    QcomGlinkFifo tx, rx;
+    void (*kick)(void *context);
+    void *kick_context;
+    uint32_t features;
+    uint8_t version_sent, version_agreed, broken, kick_pending, notify_sent;
+    uint16_t next_lcid;
+    QcomGlinkChannel channel[QCOM_GLINK_MAX_CHANNELS];
+    /* Counters for the log. */
+    uint32_t rx_messages, tx_messages, rx_data, unknown_opens, dropped;
+    char last_unknown[QCOM_GLINK_NAME];
+    char unknown_names[96];  /* the distinct names of those opens, space separated, as many as fit */
+} QcomGlink;
+
+/* Sets up the link on its FIFOs (rx may have no data yet: the remote makes its FIFO later) and resets the indices we own. */
+void qcom_glink_init(QcomGlink *g, QcomGlinkFifo tx, QcomGlinkFifo rx, void (*kick)(void *), void *kick_context);
+/* The remote's FIFO once it exists. */
+void qcom_glink_set_rx(QcomGlink *g, volatile uint8_t *data, uint32_t length);
+/* Registers a channel by name with intent_count receive buffers of intent_size bytes in storage. open_now: we send OPEN ourselves;
+ * otherwise we answer when the remote opens it. */
+QcomGlinkChannel *qcom_glink_channel(QcomGlink *g, const char *name, uint32_t intent_size, uint32_t intent_count, uint8_t *storage,
+                                     const QcomGlinkClient *client, void *context, int open_now);
+/* Sends VERSION (once) and any channel OPEN that is due, then handles every complete message in the receive FIFO. Returns the number of
+ * messages handled or QcomGlinkCorrupt. Rings the remote when anything was written. */
+int qcom_glink_poll(QcomGlink *g);
+/* Queues one message on an open channel (single chunk, up to the remote intent size). */
+int qcom_glink_send(QcomGlink *g, QcomGlinkChannel *channel, const void *data, uint32_t length);
+
+/* FIFO primitives, exposed for the tests. */
+uint32_t qcom_glink_rx_avail(const QcomGlinkFifo *f);
+uint32_t qcom_glink_tx_avail(const QcomGlinkFifo *f);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/qcom/QcomSmem.c b/bsd/dev/qcom/QcomSmem.c
new file mode 100644
index 0000000..515c63f
--- /dev/null
+++ b/bsd/dev/qcom/QcomSmem.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomSmem.h"
+
+#define TOC_MAGIC 0x434f5424u   /* "$TOC" */
+#define PART_MAGIC 0x54525024u  /* "$PRT" */
+#define CANARY 0xa5a5u
+#define TOC_HEADER 32u
+#define TOC_ENTRY 48u
+#define PART_HEADER 32u
+#define ENTRY 16u
+
+uint32_t qcom_smem_read32(const QcomSmem *smem, uint32_t offset) {return *(volatile uint32_t *)(smem->base + offset);}
+void qcom_smem_write32(const QcomSmem *smem, uint32_t offset, uint32_t value)
+{
+    *(volatile uint32_t *)(smem->base + offset) = value;
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb oshst" ::: "memory");
+#endif
+}
+static uint32_t rd(const QcomSmem *s, uint32_t at) {return qcom_smem_read32(s, at);}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+static uint32_t align_up(uint32_t value, uint32_t to) {return (value + to - 1) & ~(to - 1);}
+
+int qcom_smem_partition(const QcomSmem *smem, uint16_t host, uint16_t remote, QcomSmemPartition *out)
+{
+    if (!smem || !smem->base || smem->size < 0x2000 || (smem->size & 0xfff)) return QcomSmemNoTable;
+    const uint32_t toc = smem->size - 0x1000;
+    if (rd(smem, toc) != TOC_MAGIC || rd(smem, toc + 4) != 1) return QcomSmemNoTable;
+    const uint32_t count = rd(smem, toc + 8);
+    if (count > (0x1000 - TOC_HEADER) / TOC_ENTRY) return QcomSmemNoTable;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t e = toc + TOC_HEADER + i * TOC_ENTRY;
+        const uint32_t offset = rd(smem, e), size = rd(smem, e + 4), hosts = rd(smem, e + 12), cacheline = rd(smem, e + 16);
+        const uint16_t h0 = (uint16_t)hosts, h1 = (uint16_t)(hosts >> 16);
+        if (!offset || !size) continue;
+        if (!((h0 == host && h1 == remote) || (h0 == remote && h1 == host))) continue;
+        if (!fits(offset, size, toc) || size < PART_HEADER + 2 * ENTRY || (offset & 7)) return QcomSmemBadPartition;
+        if (cacheline & (cacheline - 1)) return QcomSmemBadPartition;
+        if (rd(smem, offset) != PART_MAGIC || rd(smem, offset + 4) != hosts || rd(smem, offset + 8) != size) return QcomSmemBadPartition;
+        const uint32_t free_uncached = rd(smem, offset + 12), free_cached = rd(smem, offset + 16);
+        if (free_uncached < PART_HEADER || free_uncached > free_cached || free_cached > size) return QcomSmemBadPartition;
+        *out = (QcomSmemPartition){offset, size, cacheline ? cacheline : 8u, h0, h1};
+        return QcomSmemOk;
+    }
+    return QcomSmemNoPartition;
+}
+
+/* Walks the uncached list; returns the offset (relative to the partition) where it ends, or the item's entry when found. */
+static int walk_uncached(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t *at_out, int *found)
+{
+    const uint32_t end = rd(smem, p->offset + 12);
+    uint32_t at = PART_HEADER;
+    *found = 0;
+    while (at < end) {
+        if (!fits(at, ENTRY, end)) return QcomSmemCorrupt;
+        const uint32_t w0 = rd(smem, p->offset + at), size = rd(smem, p->offset + at + 4), pads = rd(smem, p->offset + at + 8);
+        if ((w0 & 0xffff) != CANARY) return QcomSmemCorrupt;
+        const uint32_t padding_header = pads >> 16;
+        if ((uint64_t)at + ENTRY + padding_header + size > end) return QcomSmemCorrupt;
+        if ((w0 >> 16) == item) {*found = 1; *at_out = at; return QcomSmemOk;}
+        at += ENTRY + padding_header + size;
+    }
+    if (at != end) return QcomSmemCorrupt;
+    *at_out = at;
+    return QcomSmemOk;
+}
+
+int qcom_smem_find(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t *offset, uint32_t *size)
+{
+    uint32_t at;
+    int found, rc = walk_uncached(smem, p, item, &at, &found);
+    if (rc) return rc;
+    if (found) {
+        const uint32_t bytes = rd(smem, p->offset + at + 4), pads = rd(smem, p->offset + at + 8);
+        if ((pads & 0xffff) > bytes) return QcomSmemCorrupt;
+        *offset = p->offset + at + ENTRY + (pads >> 16);
+        *size = bytes - (pads & 0xffff);
+        return QcomSmemOk;
+    }
+    /* Cached items: each entry sits at the end of its cache line slot, its data right below it. */
+    const uint32_t header = align_up(ENTRY, p->cacheline), last = rd(smem, p->offset + 16);
+    if (p->size < header) return QcomSmemCorrupt;
+    uint32_t e = p->size - header;
+    while (e > last) {
+        const uint32_t w0 = rd(smem, p->offset + e), bytes = rd(smem, p->offset + e + 4), pads = rd(smem, p->offset + e + 8);
+        if ((w0 & 0xffff) != CANARY || bytes > e || (pads & 0xffff) > bytes) return QcomSmemCorrupt;
+        if ((w0 >> 16) == item) {*offset = p->offset + e - bytes; *size = bytes - (pads & 0xffff); return QcomSmemOk;}
+        if (e < bytes + header) return QcomSmemCorrupt;
+        e -= bytes + header;
+    }
+    return QcomSmemMissing;
+}
+
+int qcom_smem_alloc(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t size)
+{
+    uint32_t at;
+    int found, rc = walk_uncached(smem, p, item, &at, &found);
+    if (rc) return rc;
+    if (found) return QcomSmemExists;
+    uint32_t offset, bytes;
+    if (qcom_smem_find(smem, p, item, &offset, &bytes) == QcomSmemOk) return QcomSmemExists;
+    const uint32_t aligned = align_up(size, 8), need = ENTRY + aligned;
+    if (!size || aligned < size || (uint64_t)at + need > rd(smem, p->offset + 16)) return QcomSmemNoSpace;
+    qcom_smem_write32(smem, p->offset + at, CANARY | (uint32_t)item << 16);
+    qcom_smem_write32(smem, p->offset + at + 4, aligned);
+    qcom_smem_write32(smem, p->offset + at + 8, aligned - size);  /* padding_data, padding_header 0 */
+    qcom_smem_write32(smem, p->offset + at + 12, 0);
+    for (uint32_t i = 0; i < aligned; i += 4) qcom_smem_write32(smem, p->offset + at + ENTRY + i, 0);
+    /* The entry is complete before the free mark moves over it. */
+    qcom_smem_write32(smem, p->offset + 12, at + need);
+    return QcomSmemOk;
+}
diff --git a/bsd/dev/qcom/QcomSmem.h b/bsd/dev/qcom/QcomSmem.h
new file mode 100644
index 0000000..facab04
--- /dev/null
+++ b/bsd/dev/qcom/QcomSmem.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Qualcomm shared memory (SMEM): the partition table at the end of the region, the private partitions two processors share, and the
+ * items in them (uncached ones growing up from the partition header, cached ones down from its end). Every access is an aligned 32-bit
+ * one, so the code works on a device mapping. Allocation must run with the hardware mutex held (the caller takes it); nothing here
+ * waits. */
+#ifndef QCOM_SMEM_H
+#define QCOM_SMEM_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_SMEM_HOST_APPS 0u
+#define QCOM_SMEM_HOST_GLOBAL 0xfffeu
+
+typedef struct {
+    volatile uint8_t *base;
+    uint32_t size;
+} QcomSmem;
+
+typedef struct {
+    uint32_t offset, size, cacheline;  /* offset of the partition header from the SMEM base */
+    uint16_t host0, host1;
+} QcomSmemPartition;
+
+enum {
+    QcomSmemOk = 0,
+    QcomSmemNoTable = -1,
+    QcomSmemNoPartition = -2,
+    QcomSmemBadPartition = -3,
+    QcomSmemCorrupt = -4,
+    QcomSmemExists = -5,
+    QcomSmemNoSpace = -6,
+    QcomSmemMissing = -7,
+};
+
+/* The partition shared by the two hosts (QCOM_SMEM_HOST_GLOBAL twice for the global one). */
+int qcom_smem_partition(const QcomSmem *smem, uint16_t host, uint16_t remote, QcomSmemPartition *out);
+/* Offset of the item's data from the SMEM base and its size; QcomSmemMissing when the item is not there. */
+int qcom_smem_find(const QcomSmem *smem, const QcomSmemPartition *part, uint16_t item, uint32_t *offset, uint32_t *size);
+/* Allocates an uncached item of size bytes (rounded up to 8). QcomSmemExists if it is there already (not an error for callers that
+ * only need it to exist). Hardware mutex held by the caller. */
+int qcom_smem_alloc(const QcomSmem *smem, const QcomSmemPartition *part, uint16_t item, uint32_t size);
+
+uint32_t qcom_smem_read32(const QcomSmem *smem, uint32_t offset);
+void qcom_smem_write32(const QcomSmem *smem, uint32_t offset, uint32_t value);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/qcom/QcomSmp2p.c b/bsd/dev/qcom/QcomSmp2p.c
new file mode 100644
index 0000000..7ba701b
--- /dev/null
+++ b/bsd/dev/qcom/QcomSmp2p.c
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomSmp2p.h"
+
+/* Word offsets: 0 magic, 1 version (bits 7:0) and features (31:8), 2 local pid (15:0) and remote pid (31:16), 3 total entries (15:0)
+ * and valid entries (31:16), 4 flags, then 5 words per entry: a 16-byte name and the value. */
+#define W_VERSION 1
+#define W_PIDS 2
+#define W_COUNTS 3
+#define W_FLAGS 4
+#define W_ENTRY(i) (5 + 5 * (i))
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb oshst" ::: "memory");
+#endif
+}
+static int same_name(const volatile uint32_t *entry, const char *name)
+{
+    for (unsigned i = 0; i < 16; ++i) {
+        const char c = (char)(entry[i / 4] >> (8 * (i % 4)));
+        if (c != name[i]) return 0;
+        if (!c) return 1;
+    }
+    return name[16] == 0;
+}
+
+void qcom_smp2p_init_out(QcomSmp2p *s, volatile uint32_t *out, uint16_t local_pid, uint16_t remote_pid)
+{
+    *s = (QcomSmp2p){0};
+    s->out = out;
+    s->local_pid = local_pid;
+    s->remote_pid = remote_pid;
+    for (unsigned i = 0; i < QCOM_SMP2P_ITEM_BYTES / 4; ++i) out[i] = 0;
+    barrier();
+    out[0] = QCOM_SMP2P_MAGIC;
+    out[W_PIDS] = local_pid | (uint32_t)remote_pid << 16;
+    out[W_COUNTS] = QCOM_SMP2P_MAX_ENTRIES;
+    barrier();
+    out[W_VERSION] = QCOM_SMP2P_VERSION | QCOM_SMP2P_FEATURE_SSR_ACK << 8;
+    barrier();
+}
+
+int qcom_smp2p_add_entry(QcomSmp2p *s, const char *name)
+{
+    const uint32_t valid = s->out[W_COUNTS] >> 16;
+    if (valid >= QCOM_SMP2P_MAX_ENTRIES) return -1;
+    uint32_t words[4] = {0};
+    for (unsigned i = 0; i < 16 && name[i]; ++i) words[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+    for (unsigned i = 0; i < 4; ++i) s->out[W_ENTRY(valid) + i] = words[i];
+    s->out[W_ENTRY(valid) + 4] = 0;
+    barrier();
+    s->out[W_COUNTS] = QCOM_SMP2P_MAX_ENTRIES | (valid + 1) << 16;
+    barrier();
+    return (int)valid;
+}
+
+int qcom_smp2p_update(QcomSmp2p *s, int index, uint32_t mask, uint32_t value)
+{
+    volatile uint32_t *v = &s->out[W_ENTRY(index) + 4];
+    const uint32_t old = *v, next = (old & ~mask) | (value & mask);
+    if (next == old) return 0;
+    *v = next;
+    barrier();
+    return 1;
+}
+
+uint32_t qcom_smp2p_out_value(const QcomSmp2p *s, int index) {return s->out[W_ENTRY(index) + 4];}
+
+int qcom_smp2p_check_in(const volatile uint32_t *in, uint16_t local_pid, uint16_t remote_pid)
+{
+    if (!in || in[0] != QCOM_SMP2P_MAGIC) return -1;
+    if ((in[W_VERSION] & 0xff) != QCOM_SMP2P_VERSION) return -2;
+    /* The remote writes its own pid as local. */
+    if (in[W_PIDS] != (remote_pid | (uint32_t)local_pid << 16)) return -3;
+    const uint32_t counts = in[W_COUNTS];
+    if ((counts & 0xffff) > QCOM_SMP2P_MAX_ENTRIES || (counts >> 16) > (counts & 0xffff)) return -4;
+    return 0;
+}
+
+int qcom_smp2p_find_in(const QcomSmp2p *s, const char *name)
+{
+    if (!s->in) return -1;
+    const uint32_t valid = s->in[W_COUNTS] >> 16;
+    for (uint32_t i = 0; i < valid && i < QCOM_SMP2P_MAX_ENTRIES; ++i)
+        if (same_name(&s->in[W_ENTRY(i)], name)) return (int)i;
+    return -1;
+}
+
+uint32_t qcom_smp2p_in_value(const QcomSmp2p *s, int index) {return s->in[W_ENTRY(index) + 4];}
+
+int qcom_smp2p_service(QcomSmp2p *s, const char *entry, uint32_t *value, uint32_t *changed)
+{
+    int ring = 0;
+    *value = 0;
+    *changed = 0;
+    if (qcom_smp2p_check_in(s->in, s->local_pid, s->remote_pid)) return 0;
+    if (!s->negotiated) {
+        const uint32_t ours = s->out[W_VERSION], theirs = s->in[W_VERSION];
+        if ((ours & 0xff) == (theirs & 0xff)) {
+            const uint32_t features = (ours >> 8) & (theirs >> 8);
+            if (features != ours >> 8) {s->out[W_VERSION] = (ours & 0xff) | features << 8; barrier(); ring = 1;}
+            s->ssr_ack_enabled = (features & QCOM_SMP2P_FEATURE_SSR_ACK) != 0;
+            s->negotiated = 1;
+        }
+    }
+    if (s->ssr_ack_enabled) {
+        const uint8_t done = (s->in[W_FLAGS] & QCOM_SMP2P_FLAG_RESTART_DONE) != 0;
+        if (done != s->ssr_acked) {
+            s->ssr_acked = done;
+            const uint32_t flags = s->out[W_FLAGS];
+            s->out[W_FLAGS] = done ? flags | QCOM_SMP2P_FLAG_RESTART_ACK : flags & ~QCOM_SMP2P_FLAG_RESTART_ACK;
+            barrier();
+            ring = 1;
+        }
+    }
+    const int index = qcom_smp2p_find_in(s, entry);
+    if (index >= 0) {
+        const uint32_t now = qcom_smp2p_in_value(s, index);
+        *value = now;
+        *changed = now ^ s->last[index];
+        s->last[index] = now;
+    }
+    return ring;
+}
diff --git a/bsd/dev/qcom/QcomSmp2p.h b/bsd/dev/qcom/QcomSmp2p.h
new file mode 100644
index 0000000..947a7d7
--- /dev/null
+++ b/bsd/dev/qcom/QcomSmp2p.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Shared memory point-to-point state (SMP2P): each side owns one SMEM item holding named 32-bit entries the other side watches; a change
+ * is signalled with a doorbell. This is the item layout and the bookkeeping for both directions: our outbound item (entries we set bits
+ * in) and the remote's inbound item (entries whose bit changes become events). Doorbells and SMEM placement belong to the caller. */
+#ifndef QCOM_SMP2P_H
+#define QCOM_SMP2P_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_SMP2P_MAGIC 0x504d5324u  /* "$SMP" */
+#define QCOM_SMP2P_VERSION 1u
+#define QCOM_SMP2P_FEATURE_SSR_ACK 1u
+#define QCOM_SMP2P_FLAG_RESTART_DONE 1u
+#define QCOM_SMP2P_FLAG_RESTART_ACK 2u
+#define QCOM_SMP2P_MAX_ENTRIES 16u
+#define QCOM_SMP2P_ITEM_BYTES (20u + 20u * QCOM_SMP2P_MAX_ENTRIES)
+
+/* The two items' storage: 32-bit aligned, possibly device memory. */
+typedef struct {
+    volatile uint32_t *out, *in;  /* in may be null until the remote has made it */
+    uint16_t local_pid, remote_pid;
+    uint8_t negotiated, ssr_ack_enabled, ssr_acked;
+    uint32_t last[QCOM_SMP2P_MAX_ENTRIES];  /* inbound values last seen, by inbound entry index */
+    uint32_t seen_entries;
+} QcomSmp2p;
+
+/* Writes a fresh outbound item (zeroes, header, then the version word last so the remote never sees a half-made item). */
+void qcom_smp2p_init_out(QcomSmp2p *s, volatile uint32_t *out, uint16_t local_pid, uint16_t remote_pid);
+/* Adds a named outbound entry and returns its index, or -1 when full. */
+int qcom_smp2p_add_entry(QcomSmp2p *s, const char *name);
+/* Sets the bits in mask of outbound entry index to value; returns 1 when the value changed (ring the doorbell). */
+int qcom_smp2p_update(QcomSmp2p *s, int index, uint32_t mask, uint32_t value);
+uint32_t qcom_smp2p_out_value(const QcomSmp2p *s, int index);
+
+/* Validates an inbound item (magic, version, the pids seen from the other side); 0 when usable. */
+int qcom_smp2p_check_in(const volatile uint32_t *in, uint16_t local_pid, uint16_t remote_pid);
+/* Index of the named inbound entry, -1 when the remote has not added it. */
+int qcom_smp2p_find_in(const QcomSmp2p *s, const char *name);
+uint32_t qcom_smp2p_in_value(const QcomSmp2p *s, int index);
+
+/* Called on every doorbell from the remote. Agrees on the features once, answers a restart with the restart ack flag, and reports the
+ * bits of the named inbound entry that changed since the last call (changed) and its current value (value). Returns 1 when our item
+ * changed so the remote has to be rung. */
+int qcom_smp2p_service(QcomSmp2p *s, const char *entry, uint32_t *value, uint32_t *changed);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
