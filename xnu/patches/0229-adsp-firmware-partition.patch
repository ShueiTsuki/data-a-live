 static int
 ufs_take_over_host(void)
 {
@@ -2308,5 +2318,86 @@ pandora_fw_read(uint64_t off, void *dst, uint64_t len)
 	lck_mtx_unlock(&sweet_ufs_lock);
 	return error;
 }
+
+/*
+ * 0229: one more GPT partition, read only, on any LUN, for bsd/dev/pandora_adsp.c: the firmware
+ * partition modem_<slot> (LUN 4; Android's /vendor/firmware_mnt), as UniXNU-sheng's
+ * native_ufs_part_find and native_ufs_part_read. Each call switches su.lun for its commands under
+ * sweet_ufs_lock and sets it back to 0; ufs_scsi's filter passes only TEST UNIT READY and READ(10)
+ * there, and pandora_part_pread stays inside the partition found. LUN 4 is asked first, so on
+ * pandora no other LUN is touched.
+ */
+static struct {
+	uint8_t lun;
+	uint64_t first, blocks;
+} pp;
+
+int pandora_part_find(const char *name, uint32_t *lun, uint64_t *first, uint64_t *blocks);
+int
+pandora_part_find(const char *name, uint32_t *lun, uint64_t *first, uint64_t *blocks)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	static const uint8_t order[8] = { 4, 0, 1, 2, 3, 5, 6, 7 };
+	int error = ENOENT;
+	if (!su.ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	pp.blocks = 0;
+	for (unsigned i = 0; i < 8 && error; i++) {
+		int e = 0;
+		uint64_t f = 0, n = 0;
+		su.lun = order[i];
+		/* The first command to a LUN may report a unit attention. */
+		for (int t = 0; t < 3 && (e = ufs_scsi(tur, sizeof(tur), 0, false)); t++) {
+		}
+		if (!e && !ufs_gpt_lookup(name, &f, &n)) {
+			pp.lun = order[i];
+			pp.first = f;
+			pp.blocks = n;
+			error = 0;
+		}
+	}
+	su.lun = 0;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (!error) {
+		*lun = pp.lun;
+		*first = pp.first;
+		*blocks = pp.blocks;
+	}
+	return error;
+}
+
+/* Copy len bytes at byte offset off of that partition into dst. */
+int pandora_part_pread(uint64_t off, void *dst, uint64_t len);
+int
+pandora_part_pread(uint64_t off, void *dst, uint64_t len)
+{
+	if (!pp.blocks || off + len < off || off + len > pp.blocks * UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t *out = dst;
+	int error = 0;
+	lck_mtx_lock(&sweet_ufs_lock);
+	su.lun = pp.lun;
+	while (len && !error) {
+		uint64_t blk = off / UFS_BLOCK;
+		uint32_t in = (uint32_t)(off % UFS_BLOCK);
+		uint64_t need = (in + len + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(need, (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		error = ufs_read_blocks(pp.first + blk, n);
+		if (error) {
+			break;
+		}
+		uint64_t got = MIN((uint64_t)n * UFS_BLOCK - in, len);
+		memcpy(out, (const uint8_t *)(su.dma + DMA_BOUNCE) + in, (size_t)got);
+		out += got;
+		off += got;
+		len -= got;
+	}
+	su.lun = 0;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
