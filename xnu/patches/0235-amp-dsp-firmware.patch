diff --git a/bsd/dev/pandora_csfw.c b/bsd/dev/pandora_csfw.c
new file mode 100644
index 0000000..0d93469
--- /dev/null
+++ b/bsd/dev/pandora_csfw.c
@@ -0,0 +1,273 @@
+/*
+ * Cirrus Logic Halo-core DSP files as register writes (pandora_csfw.h).
+ */
+#include "pandora_csfw.h"
+
+#define WMFW_HEADER   12u     /* magic, header length, rev (16), core, version */
+#define WMFW_SIZES    16u     /* xm, ym, pm, zm */
+#define WMFW_FOOTER   12u     /* timestamp (64), checksum */
+#define WMFW_REGION   8u      /* offset | type << 24, length */
+#define WMDR_HEADER   16u     /* magic, header length, version, core */
+#define WMDR_BLOCK    20u     /* offset (16), type (16), id, version, sample rate, length */
+#define ID_TERMINATOR 0xbedeadu
+
+_Static_assert(sizeof(CsfwAlg) == 6 * sizeof(uint32_t), "CsfwAlg is six words, filled in order");
+
+static uint32_t
+le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8;
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint32_t
+be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | (uint32_t)p[3];
+}
+
+uint32_t
+csfw_region_reg(uint32_t type, uint32_t offset)
+{
+	switch (type) {
+	case CSFW_XM_T:
+		return CSFW_XM + offset * 4u;
+	case CSFW_YM_T:
+		return CSFW_YM + offset * 4u;
+	case CSFW_XM_PACKED_T:
+		return (CSFW_XM_PACKED + offset * 3u) & ~3u;
+	case CSFW_YM_PACKED_T:
+		return (CSFW_YM_PACKED + offset * 3u) & ~3u;
+	case CSFW_PM_PACKED_T:
+		return CSFW_PM_PACKED + offset * 5u;
+	default:
+		return 0;
+	}
+}
+
+void
+csfw_unpack(const uint8_t b[12], uint32_t w[4])
+{
+	const uint32_t r0 = be32(b), r1 = be32(b + 4), r2 = be32(b + 8);
+	w[0] = r0 & 0xffffffu;
+	w[1] = (r0 >> 24) | (r1 & 0xffffu) << 8;
+	w[2] = (r1 >> 16) | (r2 & 0xffu) << 16;
+	w[3] = r2 >> 8;
+}
+
+int
+csfw_wmfw_begin(CsfwIter *it, const uint8_t *file, uint32_t size)
+{
+	it->file = file;
+	it->size = size;
+	it->pos = 0;
+	it->coeff = 0;
+	if (size < WMFW_HEADER + WMFW_SIZES + WMFW_FOOTER) {
+		return CsfwShort;
+	}
+	if (file[0] != 'W' || file[1] != 'M' || file[2] != 'F' || file[3] != 'W') {
+		return CsfwBadMagic;
+	}
+	/* core 4 (Halo) at byte 10, file version 3 at byte 11 */
+	if (le32(file + 4) != WMFW_HEADER + WMFW_SIZES + WMFW_FOOTER || file[10] != 4 || file[11] != 3) {
+		return CsfwBadHeader;
+	}
+	it->pos = le32(file + 4);
+	return CsfwOk;
+}
+
+int
+csfw_coeff_begin(CsfwIter *it, const uint8_t *file, uint32_t size)
+{
+	it->file = file;
+	it->size = size;
+	it->pos = 0;
+	it->coeff = 1;
+	if (size < WMDR_HEADER) {
+		return CsfwShort;
+	}
+	if (file[0] != 'W' || file[1] != 'M' || file[2] != 'D' || file[3] != 'R') {
+		return CsfwBadMagic;
+	}
+	const uint32_t hl = le32(file + 4);
+	if (hl < WMDR_HEADER || hl > size) {
+		return CsfwBadHeader;
+	}
+	it->pos = hl;
+	return CsfwOk;
+}
+
+const CsfwAlg *
+csfw_find_alg(const CsfwInfo *info, uint32_t id)
+{
+	for (unsigned i = 0; info && i < info->n_algs; i++) {
+		if (info->algs[i].id == id) {
+			return &info->algs[i];
+		}
+	}
+	return 0;
+}
+
+static int
+next_wmfw(CsfwIter *it, CsfwWrite *w)
+{
+	while (it->pos < it->size) {
+		if (it->size - it->pos < WMFW_REGION) {
+			return CsfwShort;
+		}
+		const uint8_t *r = it->file + it->pos;
+		const uint32_t word = le32(r), bytes = le32(r + 4), type = word >> 24, offset = word & 0xffffffu;
+		if (bytes > it->size - it->pos - WMFW_REGION) {
+			return CsfwShort;
+		}
+		it->pos += WMFW_REGION + bytes;
+		switch (type) {
+		case CSFW_INFO_T:
+		case CSFW_NAME_T:
+		case CSFW_METADATA_T:
+		case CSFW_ALGDATA_T:
+			continue;
+		case CSFW_ABSOLUTE_T:
+			w->reg = offset;
+			break;
+		case CSFW_XM_T:
+		case CSFW_YM_T:
+		case CSFW_XM_PACKED_T:
+		case CSFW_YM_PACKED_T:
+		case CSFW_PM_PACKED_T:
+			w->reg = csfw_region_reg(type, offset);
+			break;
+		default:
+			return CsfwBadRegion;
+		}
+		if (bytes & 3u) {
+			return CsfwBadRegion;          /* whole 32-bit registers only */
+		}
+		w->type = type;
+		w->alg = w->ver = 0;
+		w->data = r + WMFW_REGION;
+		w->bytes = bytes;
+		return CsfwOk;
+	}
+	return CsfwEnd;
+}
+
+static int
+next_coeff(CsfwIter *it, const CsfwInfo *info, CsfwWrite *w)
+{
+	while (it->pos < it->size) {
+		if (it->size - it->pos < WMDR_BLOCK) {
+			return CsfwShort;
+		}
+		const uint8_t *b = it->file + it->pos;
+		const uint32_t offset = le16(b), type = le16(b + 2), id = le32(b + 4), bytes = le32(b + 16);
+		if (bytes > it->size - it->pos - WMDR_BLOCK) {
+			return CsfwShort;
+		}
+		it->pos += (WMDR_BLOCK + bytes + 3u) & ~3u;
+		if (it->pos > it->size) {
+			it->pos = it->size;
+		}
+		/* text, names and metadata carry their type in the upper byte here (cs_dsp_load_coeff) */
+		if (type == CSFW_NAME_T << 8 || type == CSFW_INFO_T << 8 || type == CSFW_METADATA_T << 8) {
+			continue;
+		}
+		if (type == CSFW_ABSOLUTE_T << 8) {
+			w->reg = offset;
+		} else if (type == CSFW_XM_T || type == CSFW_YM_T || type == CSFW_XM_PACKED_T || type == CSFW_YM_PACKED_T) {
+			const CsfwAlg *a = csfw_find_alg(info, id);
+			if (!a) {
+				return CsfwNoAlg;
+			}
+			const uint32_t base = (type == CSFW_YM_T || type == CSFW_YM_PACKED_T) ? a->ym_base : a->xm_base;
+			w->reg = csfw_region_reg(type, base) + offset;
+		} else {
+			return CsfwBadRegion;
+		}
+		if (bytes & 3u) {
+			return CsfwBadRegion;
+		}
+		w->type = type;
+		w->alg = id;
+		w->ver = le32(b + 8);
+		w->data = b + WMDR_BLOCK;
+		w->bytes = bytes;
+		return CsfwOk;
+	}
+	return CsfwEnd;
+}
+
+int
+csfw_next(CsfwIter *it, const CsfwInfo *info, CsfwWrite *w)
+{
+	return it->coeff ? next_coeff(it, info, w) : next_wmfw(it, w);
+}
+
+int
+csfw_wmfw_info(const uint8_t *file, uint32_t size, CsfwInfo *info)
+{
+	CsfwIter it;
+	CsfwWrite w;
+	int e = csfw_wmfw_begin(&it, file, size);
+	if (e != CsfwOk) {
+		return e;
+	}
+	const uint8_t *xm0 = 0;
+	uint32_t xm0_bytes = 0;
+	while ((e = next_wmfw(&it, &w)) == CsfwOk) {
+		if (w.type == CSFW_XM_PACKED_T && w.reg == CSFW_XM_PACKED) {
+			xm0 = w.data;
+			xm0_bytes = w.bytes;
+			break;
+		}
+	}
+	if (!xm0) {
+		return e < 0 ? e : CsfwNoAlg;
+	}
+	/* the words as the DSP reads them: id header (10 words), 6 per algorithm, then the terminator */
+	const uint32_t nwords = xm0_bytes / 12u * 4u;
+	uint32_t hdr[10];
+	if (nwords < 11) {
+		return CsfwShort;
+	}
+	for (unsigned i = 0; i < 10; i++) {
+		uint32_t q[4];
+		csfw_unpack(xm0 + i / 4u * 12u, q);
+		hdr[i] = q[i % 4u];
+	}
+	info->core_id = hdr[0];
+	info->block_rev = hdr[1];
+	info->vendor = hdr[2];
+	info->fw_id = hdr[3];
+	info->fw_ver = hdr[4];
+	info->xm_base = hdr[5];
+	info->xm_size = hdr[6];
+	info->ym_base = hdr[7];
+	info->ym_size = hdr[8];
+	info->n_algs = hdr[9];
+	if (info->n_algs > CSFW_MAX_ALGS) {
+		return CsfwTooMany;
+	}
+	if (10u + 6u * info->n_algs + 1u > nwords) {
+		return CsfwShort;
+	}
+	for (unsigned k = 0; k <= 6u * info->n_algs; k++) {
+		const unsigned i = 10u + k;
+		uint32_t q[4];
+		csfw_unpack(xm0 + i / 4u * 12u, q);
+		if (k == 6u * info->n_algs) {
+			if (q[i % 4u] != ID_TERMINATOR) {
+				return CsfwBadHeader;
+			}
+			break;
+		}
+		uint32_t *f = &info->algs[k / 6u].id;
+		f[k % 6u] = q[i % 4u];
+	}
+	return CsfwOk;
+}
diff --git a/bsd/dev/pandora_csfw.h b/bsd/dev/pandora_csfw.h
new file mode 100644
index 0000000..735161b
--- /dev/null
+++ b/bsd/dev/pandora_csfw.h
@@ -0,0 +1,89 @@
+/*
+ * Cirrus Logic Halo-core DSP files for the CS35L43 speaker amplifiers, as the register writes they
+ * turn into. Two files per amplifier: the firmware (.wmfw, "WMFW" version 3, core 4 = Halo) and its
+ * coefficients (.bin, "WMDR"); the coefficient blocks are placed relative to the firmware's
+ * algorithms, whose list the firmware carries at XM word 0 (the id header the DSP itself reports).
+ * File layouts as Linux's include/linux/firmware/cirrus/wmfw.h; register placement as cs_dsp.c's
+ * cs_dsp_halo_region_to_reg and the CS35L41 family's DSP1 memory map. Checked against the phone's
+ * own files: all 27 algorithms decode, every coefficient block of both amplifiers and all five
+ * scene deltas resolves to one of them with the same version, and the decoded id header equals what
+ * the amplifier holds at 0x2800000 during Android playback.
+ * No allocation, no I/O: the caller hands in the file bytes and performs the writes.
+ */
+#ifndef PANDORA_CSFW_H
+#define PANDORA_CSFW_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The DSP1 memories in the amplifier's register space (32-bit registers, byte addresses). */
+#define CSFW_PM_PACKED   0x03800000u   /* 40-bit instructions, 5 bytes each */
+#define CSFW_XM_PACKED   0x02000000u   /* 24-bit words, 4 per 3 registers */
+#define CSFW_YM_PACKED   0x02c00000u
+#define CSFW_XM          0x02800000u   /* 24-bit words, one per register */
+#define CSFW_YM          0x03400000u
+
+/* Region and block types. */
+#define CSFW_XM_T        0x05u
+#define CSFW_YM_T        0x06u
+#define CSFW_PM_PACKED_T 0x10u
+#define CSFW_XM_PACKED_T 0x11u
+#define CSFW_YM_PACKED_T 0x12u
+#define CSFW_ABSOLUTE_T  0xf0u
+#define CSFW_ALGDATA_T   0xf2u
+#define CSFW_METADATA_T  0xfcu
+#define CSFW_NAME_T      0xfeu
+#define CSFW_INFO_T      0xffu
+
+#define CSFW_MAX_ALGS    48u
+
+enum {
+	CsfwOk = 0, CsfwEnd = 1, CsfwBadMagic = -1, CsfwBadHeader = -2, CsfwBadRegion = -3, CsfwNoAlg = -4,
+	CsfwTooMany = -5, CsfwShort = -6
+};
+
+typedef struct {
+	uint32_t id, ver, xm_base, xm_size, ym_base, ym_size;   /* bases and sizes in 24-bit words */
+} CsfwAlg;
+
+typedef struct {
+	uint32_t core_id, block_rev, vendor, fw_id, fw_ver, xm_base, xm_size, ym_base, ym_size;
+	unsigned n_algs;
+	CsfwAlg algs[CSFW_MAX_ALGS];
+} CsfwInfo;
+
+typedef struct {
+	const uint8_t *file;
+	uint32_t size, pos;
+	int coeff;                     /* 0 a .wmfw, 1 a .bin */
+} CsfwIter;
+
+/* One write: bytes at data to the registers from reg on (reg steps by 4 per 4 bytes). */
+typedef struct {
+	uint32_t reg, bytes, type, alg, ver;   /* alg, ver: a coefficient block's algorithm and its version field */
+	const uint8_t *data;
+} CsfwWrite;
+
+/* The register of word OFFSET of memory TYPE (cs_dsp_halo_region_to_reg); 0 for a type with no memory. */
+uint32_t csfw_region_reg(uint32_t type, uint32_t offset);
+/* Four 24-bit words from three 32-bit registers as they are on the wire (big endian): word 0 in
+ * the low bits of the first register. */
+void csfw_unpack(const uint8_t b[12], uint32_t w[4]);
+
+int csfw_wmfw_begin(CsfwIter *it, const uint8_t *file, uint32_t size);
+/* The id header and algorithm list from the firmware's packed XM region at word 0. */
+int csfw_wmfw_info(const uint8_t *file, uint32_t size, CsfwInfo *info);
+int csfw_coeff_begin(CsfwIter *it, const uint8_t *file, uint32_t size);
+/* The next write (text, names, metadata and algorithm descriptions are skipped); CsfwEnd at the
+ * end. For a .bin, info places each block at its algorithm's base. */
+int csfw_next(CsfwIter *it, const CsfwInfo *info, CsfwWrite *w);
+const CsfwAlg *csfw_find_alg(const CsfwInfo *info, uint32_t id);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
