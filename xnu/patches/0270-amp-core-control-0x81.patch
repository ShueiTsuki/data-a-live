+/*
+ * 0270: right after the start, as Android's trace shows: the firmware raises the mailbox interrupt (0x10010 bit 31)
+ * within 3 ms; cs35l43_irq clears it (0x10010 <- 0x80000000), the driver writes 0x13020 <- 0x02000003 and reads the
+ * eight mailbox registers from 0x13000 (its log: QUEUE_WT 0x13008, QUEUE_RD 0x13004, MESSAGE 0x2000002, "AWAKE").
+ * Returns whether the firmware answered.
+ */
+static bool
+pa_mbox_after_start(uint8_t addr)
+{
+	uint32_t irq = 0, m[8];
+	bzero(m, sizeof(m));
+	pa_sleep(5);
+	int err = pa_reg(addr, 0x10010, &irq);
+	const bool mbox = !err && (irq & 0x80000000u);
+	err = err ? err : pa_write1(addr, 0x10010, 0x80000000u);
+	err = err ? err : pa_write1(addr, 0x13020, 0x02000003u);
+	pa_sleep(2);
+	err = err ? err : pa_read_regs(addr, 0x13000, m, 8);
+	printf("PANDORA AMP: %#x after start: 0x10010 %#x (mailbox %s), err %d\n", addr, irq, mbox ? "raised" : "not raised",
+	    err);
+	printf("PANDORA AMP: %#x mailbox: %x %x %x %x %x %x %x %x\n", addr, m[0], m[1], m[2], m[3], m[4], m[5], m[6], m[7]);
+	return mbox && !err;
+}
