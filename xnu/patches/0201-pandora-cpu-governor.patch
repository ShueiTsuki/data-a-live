+/* The clock of CPU, measured from a thread bound to it. */
+static uint32_t
+cpu_clock_on(int cpu)
+{
+	processor_t p = cpu_to_processor(cpu);
+	if (p == PROCESSOR_NULL) {
+		return 0;
+	}
+	thread_bind(p);
+	thread_block(THREAD_CONTINUE_NULL);
+	const uint32_t mhz = cpu_clock_mhz();
+	thread_bind(PROCESSOR_NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+	return mhz;
+}
