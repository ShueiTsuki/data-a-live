+	gmu_wr(GMU_GMU2HOST_INTR_CLR, ~0u);
+	gmu_wr(GMU_GMU2HOST_INTR_MASK, ~(1u << 23));
+	/* a6xx_gmu_set_initial_freq -> a6xx_hfi_set_freq */
 	static uint32_t vote[4];
 	vote[1] = 1;            /* ack_type: blocking */
