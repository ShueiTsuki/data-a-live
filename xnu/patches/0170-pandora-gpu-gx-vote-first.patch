+	gmu_wr(GMU_GMU2HOST_INTR_CLR, 1u << 31);
+	printf("PANDORA GPU: OOB GPU_SET %s (intr info %08x, pwr_clk_status %08x)\n", ok ? "acked" : "NOT ACKED",
