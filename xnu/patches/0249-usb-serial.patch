+             * reported as an identity-lease failure (QUSB_RESULT) and not
+             * misread as a QUSB_DOMAIN_RESULT from the private backend. */
+            native.status.dma_mode = QCOM_USB_DEBUG_DMA_INHERITED_IDENTITY;
