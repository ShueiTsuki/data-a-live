+    usb_diag_polling = 0;
+    if (usb_diag_mode >= 201u && usb_diag_mode <= 203u) diag_reset(12);
+    diag_checkpoint(QCOM_USB_DEBUG_DIAG_ENUM_DONE);
+    native.status.phase = QCOM_USB_DEBUG_ACTIVE;
+    ret = 1;
+out:
+    buffer_status_owned();
+    release(flags);
+    if (usb_diag_enabled && native.status.phase == QCOM_USB_DEBUG_REFUSED)
+        diag_reset(12u + 4u * native.status.error);
+    return ret;
+}
+
+static int poll_owned(void)
+{
+    int ret;
+    if (native.status.phase != QCOM_USB_DEBUG_ACTIVE) return 0;
+    backlog_drain_owned();
+    loss_notice_owned();
+    ret = dwc3_poll(native.core, 1);
+    native.status.poll_calls++;
+    native.status.last_poll_events = ret < 0 ? 0u : (uint32_t)ret;
+    buffer_status_owned();
+    if (ret < 0 || native.status.io_failed) {
+        native.status.core_result = ret;
+        native.status.error = native.deadline_active && native.deadline_expired ? QCOM_USB_DEBUG_DEADLINE_EXPIRED :
+                                                      QCOM_USB_DEBUG_CORE_POLL_FAILED;
+        native.status.phase = QCOM_USB_DEBUG_IO_FAILED;
+        return 0;
+    }
+    return 1;
+}
+static uint64_t control_mix(uint64_t value)
+{
+    value ^= value >> 30;
+    value *= UINT64_C(0xbf58476d1ce4e5b9);
+    value ^= value >> 27;
+    value *= UINT64_C(0x94d049bb133111eb);
+    value ^= value >> 31;
+    return value;
+}
+static void control_rotate_session_owned(void)
+{
+    qcom_usb_shot_cancel();
+    uint64_t next = 0;
+    unsigned int attempt;
+    for (attempt = 0; attempt < 4u; attempt++) {
+        usb_control_context.seed += UINT64_C(0x9e3779b97f4a7c15);
+        next = control_mix(counter() ^ usb_control_context.seed);
+        if (!next) next = UINT64_C(0x53584e55314b4559); /* "SXNU1KEY" */
+        if (next != usb_control_context.state.session) break;
+    }
+    /* A transport generation change must never restart sequence numbering in
+     * the same session. The bounded fallback also covers a theoretical mix
+     * collision with the previous value. */
+    if (next == usb_control_context.state.session)
+        next = next == UINT64_MAX ? 1u : next + 1u;
+    sxnu_control_state_reset(&usb_control_context.state, next,
+                             usb_control_context.state.generation);
+    sxnu_control_parser_reset(&usb_control_context.parser);
+}
+static size_t control_reply_queue(const char *reply, size_t bytes)
+{
+    uint8_t wire[SXNU_CONTROL_REPLY_BYTES + 1u];
+    uint64_t flags;
+    int queued = 0;
+    if (!reply || !bytes || bytes > SXNU_CONTROL_REPLY_BYTES || !acquire(&flags)) return 0;
+    if (native.status.phase == QCOM_USB_DEBUG_ACTIVE) {
+        backlog_drain_owned();
+        if (DWC3_TX_BYTES - dwc3_queued(native.core) >= bytes + 1u) {
+            wire[0] = (uint8_t)'\n';
+            bytes_copy(wire + 1u, reply, bytes);
+            if (dwc3_queue(native.core, wire, bytes + 1u) == bytes + 1u) queued = 1;
+        }
+    }
+    release(flags);
+    if (queued) (void)__atomic_add_fetch(&control_reply_count, 1u, __ATOMIC_RELAXED);
+    return queued ? bytes : 0;
+}
+static size_t control_reply_hello(char *reply, size_t capacity,
+                                  const struct sxnu_control_frame *frame)
+{
+    struct sxnu_control_writer writer;
+    sxnu_control_writer_init(&writer, reply, capacity);
+    if (!sxnu_control_reply_start(&writer, usb_control_context.state.session, frame->seq,
+                                  frame->verb, "OK") ||
+        !sxnu_control_writer_text(&writer, " session=") ||
+        !sxnu_control_writer_hex(&writer, usb_control_context.state.session,
+                                 SXNU_CONTROL_SESSION_HEX) ||
+        !sxnu_control_writer_text(&writer, " last_seq=") ||
+        !sxnu_control_writer_hex(&writer, usb_control_context.state.last_seq,
+                                 SXNU_CONTROL_SEQ_HEX) ||
+        !sxnu_control_writer_text(&writer, " control=1")) return 0;
+    return sxnu_control_reply_finish(&writer);
+}
+static size_t control_reply_ping(char *reply, size_t capacity,
+                                 const struct sxnu_control_frame *frame,
+                                 const struct qcom_usb_debug_status *status)
+{
+    struct sxnu_control_writer writer;
+    sxnu_control_writer_init(&writer, reply, capacity);
+    if (!sxnu_control_reply_start(&writer, frame->session, frame->seq, frame->verb, "OK") ||
+        !sxnu_control_writer_text(&writer, " rx=") ||
+        !sxnu_control_writer_decimal(&writer, status->rx_pending) ||
+        !sxnu_control_writer_text(&writer, " rxo=") ||
+        !sxnu_control_writer_decimal(&writer, status->rx_overflow) ||
+        !sxnu_control_writer_text(&writer, " tx=") ||
+        !sxnu_control_writer_decimal(&writer, status->transport_pending) ||
+        !sxnu_control_writer_text(&writer, " poll=") ||
+        !sxnu_control_writer_decimal(&writer, status->poll_calls)) return 0;
+    return sxnu_control_reply_finish(&writer);
+}
+static size_t control_reply_status(char *reply, size_t capacity,
+                                   const struct sxnu_control_frame *frame,
+                                   const struct qcom_usb_debug_status *status)
+{
+    struct sxnu_control_writer writer;
+    sxnu_control_writer_init(&writer, reply, capacity);
+    if (!sxnu_control_reply_start(&writer, frame->session, frame->seq, frame->verb, "OK") ||
+        !sxnu_control_writer_text(&writer, " usb=") ||
+        !sxnu_control_writer_decimal(&writer, status->phase) ||
+        !sxnu_control_writer_text(&writer, " er=") ||
+        !sxnu_control_writer_decimal(&writer, status->error) ||
+        !sxnu_control_writer_text(&writer, " rx=") ||
+        !sxnu_control_writer_decimal(&writer, status->rx_pending) ||
+        !sxnu_control_writer_text(&writer, " rxo=") ||
+        !sxnu_control_writer_decimal(&writer, status->rx_overflow) ||
+        !sxnu_control_writer_text(&writer, " tx=") ||
+        !sxnu_control_writer_decimal(&writer, status->transport_pending) ||
+        !sxnu_control_writer_text(&writer, " bp=") ||
+        !sxnu_control_writer_decimal(&writer, status->buffer_pending) ||
+        !sxnu_control_writer_text(&writer, " bo=") ||
+        !sxnu_control_writer_decimal(&writer, status->buffer_overflow) ||
+        !sxnu_control_writer_text(&writer, " poll=") ||
+        !sxnu_control_writer_decimal(&writer, status->poll_calls) ||
+        !sxnu_control_writer_text(&writer, " ev=") ||
+        !sxnu_control_writer_decimal(&writer, status->last_poll_events) ||
+        !sxnu_control_writer_text(&writer, " gen=") ||
+        !sxnu_control_writer_decimal(&writer, status->rx_generation) ||
+        !sxnu_control_writer_text(&writer, " rej=") ||
+        !sxnu_control_writer_decimal(&writer, status->control_rejected)) return 0;
+    return sxnu_control_reply_finish(&writer);
+}
+static size_t control_reply_reboot(char *reply, size_t capacity,
+                                   const struct sxnu_control_frame *frame,
+                                   const char *status, const char *reason)
+{
+    struct sxnu_control_writer writer;
+    sxnu_control_writer_init(&writer, reply, capacity);
+    if (!sxnu_control_reply_start(&writer, frame->session, frame->seq, frame->verb, status) ||
+        !sxnu_control_writer_text(&writer, " state=") ||
+        !sxnu_control_writer_text(&writer, reason)) return 0;
+    return sxnu_control_reply_finish(&writer);
+}
+static void control_handle_frame(const struct sxnu_control_frame *frame,
+                                 const struct qcom_usb_debug_status *status,
+                                 uint32_t generation)
+{
+    enum sxnu_control_verb accepted = sxnu_control_accept(&usb_control_context.state, frame);
+    char reply[SXNU_CONTROL_REPLY_BYTES];
+    size_t reply_bytes = 0;
+    int queued = 0;
+    int reboot_accepted = 0;
+    size_t shot_bytes = 0;
+
+    if (accepted == SXNU_CONTROL_VERB_INVALID) {
+        (void)__atomic_add_fetch(&control_rejected, 1u, __ATOMIC_RELAXED);
+        return;
+    }
+    switch (accepted) {
+    case SXNU_CONTROL_VERB_HELLO:
+        reply_bytes = control_reply_hello(reply, sizeof(reply), frame);
+        break;
+    case SXNU_CONTROL_VERB_PING:
+        reply_bytes = control_reply_ping(reply, sizeof(reply), frame, status);
+        break;
+    case SXNU_CONTROL_VERB_STATUS:
+        reply_bytes = control_reply_status(reply, sizeof(reply), frame, status);
+        break;
+    case SXNU_CONTROL_VERB_SCREENSHOT: {
+        struct qcom_usb_screenshot_info info;
+        struct sxnu_control_writer writer;
+        int result = __atomic_load_n(&control_reboot_requested, __ATOMIC_ACQUIRE) ?
+                     -3 : qcom_usb_shot_capture(frame->seq);
+        if (result != 1 || !qcom_usb_shot_info(&info)) {
+            reply_bytes = control_reply_reboot(reply, sizeof(reply), frame, "ERR",
+                result == -1 ? "unavailable" : result == -3 ? "busy" : "capture-failed");
+            break;
+        }
+        sxnu_control_writer_init(&writer, reply, sizeof(reply));
+        (void)sxnu_control_reply_start(&writer, frame->session, frame->seq, frame->verb, "OK");
+        (void)sxnu_control_writer_text(&writer, " state=ready width=");
+        (void)sxnu_control_writer_decimal(&writer, info.width);
+        (void)sxnu_control_writer_text(&writer, " height=");
+        (void)sxnu_control_writer_decimal(&writer, info.height);
+        (void)sxnu_control_writer_text(&writer, " bytes=");
+        (void)sxnu_control_writer_decimal(&writer, info.bytes);
+        (void)sxnu_control_writer_text(&writer, " encoded=");
+        (void)sxnu_control_writer_decimal(&writer, info.encoded_bytes);
+        (void)sxnu_control_writer_text(&writer, " crc32=");
+        (void)sxnu_control_writer_hex(&writer, info.crc32, 8);
+        (void)sxnu_control_writer_text(&writer, " frame=");
+        (void)sxnu_control_writer_decimal(&writer, info.frame);
+        (void)sxnu_control_writer_text(&writer, info.rle ? " encoding=rle" : " encoding=rgb");
+        reply_bytes = sxnu_control_reply_finish(&writer);
+        break;
+    }
+    case SXNU_CONTROL_VERB_SHOTNEXT: {
+        struct qcom_usb_screenshot_info info;
+        struct sxnu_control_writer writer;
+        uint8_t chunk[QUD_SCREENSHOT_CHUNK];
+        uint32_t offset;
+        if (!qcom_usb_shot_info(&info)) {
+            reply_bytes = control_reply_reboot(reply, sizeof(reply), frame, "ERR", "noimage");
+            break;
+        }
+        shot_bytes = qcom_usb_shot_peek(chunk, sizeof(chunk), &offset);
+        if (!shot_bytes) {
+            reply_bytes = control_reply_reboot(reply, sizeof(reply), frame, "ERR", "done");
+            break;
+        }
+        sxnu_control_writer_init(&writer, reply, sizeof(reply));
+        (void)sxnu_control_reply_start(&writer, frame->session, frame->seq, frame->verb, "OK");
+        (void)sxnu_control_writer_text(&writer, " state=data frame=");
+        (void)sxnu_control_writer_decimal(&writer, info.frame);
+        (void)sxnu_control_writer_text(&writer, " offset=");
+        (void)sxnu_control_writer_decimal(&writer, offset);
+        (void)sxnu_control_writer_text(&writer, " data=");
+        for (size_t i = 0; i < shot_bytes; ++i)
+            (void)sxnu_control_writer_hex(&writer, chunk[i], 2);
+        reply_bytes = sxnu_control_reply_finish(&writer);
+        break;
+    }
+    case SXNU_CONTROL_VERB_REBOOT:
+        if (!__atomic_load_n(&control_hook_owned, __ATOMIC_ACQUIRE))
+            reply_bytes = control_reply_reboot(reply, sizeof(reply), frame, "ERR", "nohook");
+        else if (__atomic_load_n(&control_reboot_requested, __ATOMIC_ACQUIRE) ||
+                 __atomic_load_n(&control_reboot_taken, __ATOMIC_ACQUIRE))
+            reply_bytes = control_reply_reboot(reply, sizeof(reply), frame, "ERR", "busy");
+        else {
+            reply_bytes = control_reply_reboot(reply, sizeof(reply), frame, "OK", "queued");
+            reboot_accepted = 1;
+        }
+        break;
+    default:
+        return;
+    }
+    if (!reply_bytes) {
+        (void)__atomic_add_fetch(&control_rejected, 1u, __ATOMIC_RELAXED);
+        return;
+    }
+    queued = control_reply_queue(reply, reply_bytes) == reply_bytes;
+    if (!queued || !sxnu_control_commit(&usb_control_context.state, frame, accepted)) {
+        (void)__atomic_add_fetch(&control_rejected, 1u, __ATOMIC_RELAXED);
+        return;
+    }
+    if (shot_bytes) (void)qcom_usb_shot_commit(shot_bytes);
+    if (accepted == SXNU_CONTROL_VERB_REBOOT && reboot_accepted) {
+        qcom_usb_shot_cancel();
+        __atomic_store_n(&control_reboot_seq, frame->seq, __ATOMIC_RELAXED);
+        __atomic_store_n(&control_reboot_session, frame->session, __ATOMIC_RELAXED);
+        __atomic_store_n(&control_reboot_generation, generation, __ATOMIC_RELAXED);
+        __atomic_store_n(&control_reboot_taken, 0u, __ATOMIC_RELAXED);
+        __atomic_store_n(&control_reboot_armed, 0u, __ATOMIC_RELAXED);
+        __atomic_store_n(&control_reboot_requested, 1u, __ATOMIC_RELEASE);
+    }
+}
+static void control_service(const uint8_t *bytes, size_t count, uint32_t generation,
+                            const struct qcom_usb_debug_status *status)
+{
+    size_t i;
+    if (!__atomic_load_n(&control_enabled, __ATOMIC_ACQUIRE)) return;
+    if (generation != usb_control_context.state.generation) {
+        usb_control_context.state.generation = generation;
+        control_rotate_session_owned();
+    }
+    for (i = 0; i < count; i++) {
+        char line[SXNU_CONTROL_FRAME_BYTES];
+        size_t line_bytes = 0;
+        int complete = sxnu_control_parser_feed(&usb_control_context.parser, bytes[i], line,
+                                                 sizeof(line), &line_bytes);
+        if (complete > 0) {
+            struct sxnu_control_frame frame;
+            if (sxnu_control_parse(line, line_bytes, &frame))
+                control_handle_frame(&frame, status, generation);
+            else
+                (void)__atomic_add_fetch(&control_rejected, 1u, __ATOMIC_RELAXED);
+        } else if (complete < 0) {
+            (void)__atomic_add_fetch(&control_rejected, 1u, __ATOMIC_RELAXED);
+        }
+    }
+}
+int qcom_usb_debug_control_start(void)
+{
+    uint64_t flags;
+    unsigned int expected = 0;
+    int (*halt_expected)(unsigned int) = 0;
+    int installed;
+    if (!__atomic_compare_exchange_n(&control_started, &expected, 1u, 0,
+                                     __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+        return __atomic_load_n(&control_started, __ATOMIC_ACQUIRE) == 2u;
+    if (!acquire(&flags)) {
+        __atomic_store_n(&control_started, 0u, __ATOMIC_RELEASE);
+        return 0;
+    }
+    if (native.status.phase != QCOM_USB_DEBUG_ACTIVE) {
+        release(flags);
+        __atomic_store_n(&control_started, 0u, __ATOMIC_RELEASE);
+        return 0;
+    }
+    usb_control_context.seed = counter() ^
+                               ((uint64_t)native.status.counter_frequency << 32) ^
+                               UINT64_C(0x53584e554354524c);
+    usb_control_context.state.generation = dwc3_rx_generation(native.core);
+    control_rotate_session_owned();
+    release(flags);
+    installed = QUD_PSCI_SMC_RESET &&
+                __atomic_compare_exchange_n(&PE_halt_restart, &halt_expected,
+                  qcom_usb_control_halt_restart, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+    __atomic_store_n(&control_hook_owned, installed ? 1u : 0u, __ATOMIC_RELEASE);
+    __atomic_store_n(&control_enabled, 1u, __ATOMIC_RELEASE);
+    __atomic_store_n(&control_started, 2u, __ATOMIC_RELEASE);
+    return 1;
+}
+int qcom_usb_debug_control_take_reboot(void)
+{
+    unsigned int expected = 0;
+    unsigned int claimed;
+    if (!__atomic_load_n(&control_reboot_requested, __ATOMIC_ACQUIRE)) return 0;
+    if (!__atomic_compare_exchange_n(&control_reboot_taken, &expected, 1u, 0,
+                                     __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return 0;
+    if (__atomic_load_n(&control_reboot_requested, __ATOMIC_ACQUIRE)) return 1;
+    /* A concurrent failure cleared the request after the initial load. Release
+     * our now-empty claim so a later acknowledged REBOOT is not left busy. */
+    claimed = 1u;
+    (void)__atomic_compare_exchange_n(&control_reboot_taken, &claimed, 0u, 0,
+                                      __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+    return 0;
+}
+int qcom_usb_debug_control_arm_reboot(void)
+{
+    uint64_t flags;
+    uint32_t generation;
+    int armed = 0;
+    if (!__atomic_load_n(&control_hook_owned, __ATOMIC_ACQUIRE) ||
+        !__atomic_load_n(&control_reboot_requested, __ATOMIC_ACQUIRE) ||
+        !__atomic_load_n(&control_reboot_taken, __ATOMIC_ACQUIRE) || !acquire(&flags)) return 0;
+    generation = __atomic_load_n(&control_reboot_generation, __ATOMIC_ACQUIRE);
+    if (native.status.phase == QCOM_USB_DEBUG_ACTIVE && native.core_initialized &&
+        dwc3_ready(native.core) && dwc3_rx_generation(native.core) == generation) {
+        __atomic_store_n(&control_reboot_armed, 1u, __ATOMIC_RELEASE);
+        armed = 1;
+    }
+    release(flags);
+    return armed;
+}
+void qcom_usb_debug_control_reboot_failed(int result)
+{
+    struct sxnu_control_frame frame;
+    struct sxnu_control_writer writer;
+    char reply[SXNU_CONTROL_REPLY_BYTES];
+    unsigned int requested;
+    requested = __atomic_exchange_n(&control_reboot_requested, 0u, __ATOMIC_ACQ_REL);
+    __atomic_store_n(&control_reboot_taken, 0u, __ATOMIC_RELEASE);
+    __atomic_store_n(&control_reboot_armed, 0u, __ATOMIC_RELEASE);
+    if (!requested) return;
+    (void)__atomic_add_fetch(&control_failures, 1u, __ATOMIC_RELAXED);
+    frame.session = __atomic_load_n(&control_reboot_session, __ATOMIC_RELAXED);
+    frame.seq = __atomic_load_n(&control_reboot_seq, __ATOMIC_RELAXED);
+    frame.verb = SXNU_CONTROL_VERB_REBOOT;
+    frame.crc = 0;
+    sxnu_control_writer_init(&writer, reply, sizeof(reply));
+    if (sxnu_control_reply_start(&writer, frame.session, frame.seq, frame.verb, "ERR") &&
+        sxnu_control_writer_text(&writer, " state=reboot result=") &&
+        sxnu_control_writer_signed(&writer, result)) {
+        size_t bytes = sxnu_control_reply_finish(&writer);
+        if (bytes) (void)control_reply_queue(reply, bytes);
+    }
+}
+int qcom_usb_debug_wait_drained(unsigned int timeout_ms)
+{
+    uint64_t start, ticks;
+    if (timeout_ms > 10000u) timeout_ms = 10000u;
+    if (!timeout_ms || !native.status.counter_frequency) return 0;
+    start = counter();
+    ticks = native.status.counter_frequency * timeout_ms / 1000u;
+    for (;;) {
+        uint64_t flags;
+        int pending;
+        if (!acquire(&flags)) return 0;
+        if (native.status.phase != QCOM_USB_DEBUG_ACTIVE || !poll_owned()) {
+            release(flags);
+            return 0;
+        }
+        buffer_status_owned();
+        pending = native.status.buffer_pending != 0 || native.status.transport_pending != 0;
+        release(flags);
+        if (!pending) return 1;
+        if (counter() - start >= ticks) return 0;
+        delay_us(0, 1000);
+    }
+}
+size_t qcom_usb_debug_write(const void *bytes, size_t count)
+{
+    uint64_t flags;
+    size_t accepted = 0;
+    if (!bytes || !count || native.status.phase == QCOM_USB_DEBUG_DISABLED ||
+        native.status.phase == QCOM_USB_DEBUG_STOPPED) return 0;
+    accepted = backlog_write(bytes, count);
+    if (native.status.phase != QCOM_USB_DEBUG_ACTIVE || !acquire(&flags)) return accepted;
+    if (native.status.phase == QCOM_USB_DEBUG_ACTIVE) {
+        (void)poll_owned();
+        /* Explicit diagnostic mode uses a 1ms flush window for a ready host so
+         * the last character remains observable if a later kernel path
+         * stops servicing USB. One bounded core operation may extend it.
+         * No-host and normal mode remain nonblocking. */
+        if (usb_diag_enabled && native.status.phase == QCOM_USB_DEBUG_ACTIVE && dwc3_ready(native.core)) {
+            uint64_t start = counter();
+            unsigned int attempts = 128u;
+            while (attempts-- && (dwc3_queued(native.core) || soc_usb_buffer_pending(&usb_log_buffer)) &&
+                   counter() - start < native.status.counter_frequency / 1000u) {
+                if (!poll_owned()) break;
+                delay_us(0, 10);
+            }
+        }
+    }
+    release(flags); return accepted;
+}
+void qcom_usb_debug_putc(char c) { (void)qcom_usb_debug_write(&c, 1); }
+void qcom_usb_debug_poll(void)
+{
+    uint64_t flags;
+    uint8_t control_bytes[SXNU_CONTROL_WORK_BYTES];
+    struct qcom_usb_debug_status control_status = {0};
+    uint32_t generation = 0;
+    size_t control_bytes_count = 0;
+    int observed = 0;
+    if (native.status.phase != QCOM_USB_DEBUG_ACTIVE || !acquire(&flags)) return;
+    (void)poll_owned();
+    if (__atomic_load_n(&control_enabled, __ATOMIC_ACQUIRE) &&
+        native.status.phase == QCOM_USB_DEBUG_ACTIVE) {
+        buffer_status_owned();
+        bytes_copy(&control_status, &native.status, sizeof(control_status));
+        generation = dwc3_rx_generation(native.core);
+        control_bytes_count = dwc3_read(native.core, control_bytes,
+                                            sizeof(control_bytes));
+        observed = 1;
+    }
+    release(flags);
+    if (observed)
+        control_service(control_bytes, control_bytes_count, generation, &control_status);
+}
+void qcom_usb_debug_panic_prepare(void)
+{
+    /* An early panic can stall in platform/debugger handling before the final
+     * spin hook. Diagnose PREPARING before entering those paths. */
+    if (usb_diag_enabled && (native.status.phase == QCOM_USB_DEBUG_PREPARING ||
+        (native.status.phase == QCOM_USB_DEBUG_NOT_INITIALIZED && usb_diag_checkpoint)))
+        diag_reset(100u + 2u * usb_diag_checkpoint);
+}
+void qcom_usb_debug_panic_drain(void)
+{
+    static const char end[] = "\nQCOM PANIC END\n";
+    uint64_t flags, now;
+    unsigned int iterations = 200000u, marker_queued = 0, announced = 0;
+    char announcement[192];
+    size_t announcement_bytes;
+    if (usb_diag_enabled && (native.status.phase == QCOM_USB_DEBUG_PREPARING ||
+        (native.status.phase == QCOM_USB_DEBUG_NOT_INITIALIZED && usb_diag_checkpoint)))
+        diag_reset(100u + 2u * usb_diag_checkpoint);
+    /* panic_spin_forever can precede CPU-data initialization. Inactive USB
+     * must not call cpu_number(), touch MMIO or acquire a guard in that case. */
+    if (native.status.phase != QCOM_USB_DEBUG_ACTIVE || !acquire(&flags)) return;
+    if (native.status.phase != QCOM_USB_DEBUG_ACTIVE) goto out;
+    {
+        char *p = append_text(announcement, "\nQCOM USB PANIC pending_at_start=");
+        p = append_decimal(p, soc_usb_buffer_pending(&usb_log_buffer) + dwc3_queued(native.core));
+        p = append_text(p, " dropped_at_start=");
+        p = append_decimal(p, soc_usb_buffer_dropped(&usb_log_buffer) + dwc3_dropped(native.core));
+        p = append_text(p, " buffer_capacity=");
+        p = append_decimal(p, sizeof(usb_log_bytes));
+        *p++ = '\n';
+        announcement_bytes = (size_t)(p - announcement);
+    }
+    now = counter();
+    native.deadline = now + native.status.counter_frequency * 2u;
+    if (native.deadline < now) goto out;
+    native.deadline_expired = 0; native.deadline_active = 1;
+    while (iterations-- && !deadline_expired()) {
+        if (!announced && DWC3_TX_BYTES - dwc3_queued(native.core) >= announcement_bytes)
+            announced = dwc3_queue(native.core, announcement, announcement_bytes) == announcement_bytes;
+        /* End marker follows all queued bytes, and appears only after there
+         * is room for the entire marker. Never partially queue it. */
+        if (announced && !marker_queued && dwc3_queued(native.core) == 0 &&
+            soc_usb_buffer_pending(&usb_log_buffer) == 0) {
+            char text[160];
+            size_t bytes = loss_record(text, 1);
+            (void)dwc3_queue(native.core, text, bytes);
+            marker_queued = dwc3_queue(native.core, end, sizeof(end) - 1) == sizeof(end) - 1;
+        }
+        if (!poll_owned()) break;
+        if (marker_queued && dwc3_queued(native.core) == 0 &&
+            soc_usb_buffer_pending(&usb_log_buffer) == 0) break;
+        delay_us(0, 10);
+    }
+    native.deadline_active = 0;
+    if (native.deadline_expired) {
+        native.status.error = QCOM_USB_DEBUG_DEADLINE_EXPIRED;
+        if (native.status.io_failed) native.status.phase = QCOM_USB_DEBUG_IO_FAILED;
+    }
+out:
+    buffer_status_owned();
+    release(flags);
+    if (usb_diag_enabled) diag_reset(10);
+}
+int qcom_usb_debug_stop(void)
+{
+    uint64_t flags;
+    int ret = 0;
+    if (native.status.phase != QCOM_USB_DEBUG_ACTIVE && native.status.phase != QCOM_USB_DEBUG_IO_FAILED &&
+        !native.lease.active && !native.dma_lease.active && !native.bypass_lease.active &&
+        !native.status.vbus_owned && !native.status.phy_owned) return 0;
+    if (native.status.stop_failed) return 0;
+    if (!acquire(&flags)) return 0;
+    if (native.status.phase != QCOM_USB_DEBUG_ACTIVE && native.status.phase != QCOM_USB_DEBUG_IO_FAILED &&
+        !native.lease.active && !native.dma_lease.active && !native.bypass_lease.active &&
+        !native.status.vbus_owned && !native.status.phy_owned)
+        goto out;
+    native.deadline_active = 0;
+    if ((native.core_initialized && dwc3_stop(native.core)) ||
+        (!native.core_initialized && !halt_inherited())) {
+        native.status.stop_failed = 1;
+        fail(QCOM_USB_DEBUG_HALT_TIMEOUT, 0); goto out;
+    }
+    if (!restore_vbus() || !restore_identity() || !restore_bypass() || !restore_lease() || !restore_phy()) { fail(QCOM_USB_DEBUG_RESTORE_FAILED, 0); goto out; }
+    native.status.phase = QCOM_USB_DEBUG_STOPPED; ret = 1;
+out:
+    release(flags); return ret;
+}
+void qcom_usb_debug_get_status(struct qcom_usb_debug_status *status)
+{
+    uint64_t flags;
+    if (!status || !acquire(&flags)) return;
+    buffer_status_owned();
+    bytes_copy(status, &native.status, sizeof(*status)); release(flags);
+}
diff --git a/bsd/dev/qcomusb/soc/QcomUsbBypass.c b/bsd/dev/qcomusb/soc/QcomUsbBypass.c
new file mode 100644
index 0000000..56596e7
--- /dev/null
+++ b/bsd/dev/qcomusb/soc/QcomUsbBypass.c
@@ -0,0 +1,215 @@
+/* SPDX-License-Identifier: MIT
+ * Bypass-bank stream mapping, ported from the board's own UFS takeover
+ * (drivers/NativeUfs/SmmuTakeover.h) and the sheng port (package/SmmuBypass.h).
+ */
+#include "QcomUsbBypass.h"
+
+static void zero_bytes(void *p, QUSB_U32 n)
+{
+  unsigned char *b = p;
+  while (n--) *b++ = 0;
+}
+
+static QUSB_U32 width_bits(QUSB_U32 code)
+{
+  static const QUSB_U32 bits[] = {32, 36, 40, 42, 44, 48};
+  return code < 6u ? bits[code] : 0u;
+}
+
+static QUSB_U64 cb_address(const QUSB_BYPASS_LEASE *l)
+{
+  return QUSB_SMMU_BASE + (QUSB_U64)(l->pages + l->bank) * 4096u;
+}
+
+static QUSB_U64 cbar_address(const QUSB_BYPASS_LEASE *l)
+{
+  return QUSB_SMMU_BASE + 0x1000u + 4u * l->bank;
+}
+
+static QUSB_U64 cba2r_address(const QUSB_BYPASS_LEASE *l)
+{
+  return QUSB_SMMU_BASE + 0x1800u + 4u * l->bank;
+}
+
+static QUSB_U64 s2cr_address(const QUSB_BYPASS_LEASE *l)
+{
+  return QUSB_SMMU_BASE + 0xc00u + 4u * l->slot;
+}
+
+static QUSB_U64 smr_address(const QUSB_BYPASS_LEASE *l)
+{
+  return QUSB_SMMU_BASE + 0x800u + 4u * l->slot;
+}
+
+QUSB_RESULT QcomUsbBypassPlan(QUSB_READ32 read32, void *cookie, QUSB_U64 dma,
+                              QUSB_U32 bytes, QUSB_BYPASS_LEASE *lease)
+{
+  QUSB_U32 id0, id1, id2, cr0, smr, s2cr, i, shift, bits, mask, id;
+  QUSB_U32 streams, banks, pages, matches = 0;
+  unsigned char used[128];
+  QUSB_BYPASS_LEASE plan;
+
+  if (!read32 || !lease || !bytes) return QusbBadArgument;
+  zero_bytes(&plan, sizeof(plan));
+  plan.slot = 0xffffffffU;
+  plan.bank = 0xffffffffU;
+  if (!read32(cookie, QUSB_SMMU_BASE + 0x20u, &id0) ||
+      !read32(cookie, QUSB_SMMU_BASE + 0x24u, &id1) ||
+      !read32(cookie, QUSB_SMMU_BASE + 0x28u, &id2) ||
+      !read32(cookie, QUSB_SMMU_BASE, &cr0)) return QusbReadFailed;
+  plan.original_cr0 = cr0;
+  if (!(id0 & (1U << 30)) || !(id2 & (1U << 12))) return QusbUnknownSmmu;
+  if (cr0 & 1u) {
+    /* CLIENTPD: the whole non-secure SMMU is already bypassing. Nothing to do. */
+    *lease = plan;
+    return QusbQualified;
+  }
+  for (shift = 0; shift <= 8u; shift += 4u) {
+    bits = width_bits((id2 >> shift) & 15u);
+    if (!bits || dma >= (1ULL << bits) || (QUSB_U64)bytes > (1ULL << bits) - dma)
+      return QusbUnknownSmmu;
+  }
+  streams = id0 & 255u;
+  banks = id1 & 255u;
+  pages = 1u << (((id1 >> 28) & 7u) + 1u);
+  /* Data A Live: the register file has to fit the mapped window (SM8850: 128 global pages and
+   * 81 banks, 0xd1000 bytes of a 0x100000 window), not nabu's 0xd0000. */
+  if ((id1 >> 31) || !streams || streams > 128u || pages > 128u ||
+      banks < 2u || banks > 128u || (QUSB_U64)(pages + banks) * 4096u > QUSB_SMMU_BYTES)
+    return QusbUnknownSmmu;
+  plan.pages = pages;
+
+  /* Exactly one private match for our SID; any other state is left untouched. */
+  for (i = 0; i < streams; ++i) {
+    if (!read32(cookie, QUSB_SMMU_BASE + 0x800u + 4u * i, &smr)) return QusbReadFailed;
+    if (!(smr & 0x80000000u)) continue;
+    mask = (smr >> 16) & 0x7fffu;
+    id = smr & 0x7fffu;
+    if ((QUSB_STREAM_ID & ~mask) != (id & ~mask)) continue;
+    ++matches;
+    if (matches > 1u) return QusbMultipleStreams;
+    if (mask) return QusbSharedStream;
+    if (!read32(cookie, QUSB_SMMU_BASE + 0xc00u + 4u * i, &s2cr)) return QusbReadFailed;
+    plan.slot = i;
+    plan.original_smr = smr;
+    plan.original_s2cr = s2cr;
+  }
+  if (plan.slot == 0xffffffffU) return QusbNoExplicitStream;
+  if (((plan.original_s2cr >> 16) & 3u) == 1u) {
+    /* This firmware never reports BYPASS as BYPASS, so treat it as done only
+     * when the entry really holds type 1 (other implementations). */
+    *lease = plan;
+    return QusbQualified;
+  }
+
+  /* Banks referenced by another valid stream are off limits. */
+  zero_bytes(used, sizeof(used));
+  for (i = 0; i < streams; ++i) {
+    if (i == plan.slot) continue;
+    if (!read32(cookie, QUSB_SMMU_BASE + 0x800u + 4u * i, &smr)) return QusbReadFailed;
+    if (!(smr & 0x80000000u)) continue;
+    if (!read32(cookie, QUSB_SMMU_BASE + 0xc00u + 4u * i, &s2cr)) return QusbReadFailed;
+    if (((s2cr >> 16) & 3u) == 0u && (s2cr & 0xffu) < banks) used[s2cr & 0xffu] = 1;
+  }
+  /* Prefer the bank our entry already selects, then the top bank downwards. */
+  for (i = 0; i < banks; ++i) {
+    QUSB_U32 candidate = i == 0u ? (plan.original_s2cr & 0xffu) : (banks - i);
+    QUSB_U32 sctlr;
+    if (candidate >= banks || used[candidate]) continue;
+    if (!read32(cookie, QUSB_SMMU_BASE + (QUSB_U64)(pages + candidate) * 4096u, &sctlr))
+      return QusbReadFailed;
+    if (sctlr & 1u) continue;   /* translation enabled: live bank */
+    plan.bank = candidate;
+    break;
+  }
+  if (plan.bank >= banks) return QusbNoFreeStream;
+
+  /* Save the bank state and decide the minimum set of writes. */
+  if (!read32(cookie, cb_address(&plan), &plan.saved_sctlr) ||
+      !read32(cookie, cbar_address(&plan), &plan.saved_cbar) ||
+      !read32(cookie, cba2r_address(&plan), &plan.saved_cba2r)) return QusbReadFailed;
+  plan.changed = 0;
+  /* Data A Live: what passes the stream untranslated is SCTLR.M clear (a candidate's already
+   * is) and CBAR.TYPE 1, S1_TRANS_S2_BYPASS; the bank SM8850's bootloader leaves for stream
+   * 0x40 has SCTLR 0xe0 (fault reporting bits) and CBAR 0x1f000 (bypass memory attributes
+   * in bits 15:12), and is used as it is rather than rewritten to 0 and 0x10000. */
+  if (plan.saved_sctlr & 1u) plan.changed |= 1u;
+  if (((plan.saved_cbar >> 16) & 3u) != 1u) plan.changed |= 2u;
+  if (plan.saved_cba2r != 1u) plan.changed |= 4u;
+  if ((plan.original_s2cr & 0xffu) != plan.bank || ((plan.original_s2cr >> 16) & 3u) != 0u)
+    plan.changed |= 8u;
+  plan.active = plan.changed ? 1u : 0u;
+  plan.phase = plan.active ? 1u : 0u;   /* commit phase until Restore */
+  *lease = plan;
+  return QusbQualified;
+}
+
+QUSB_RESULT QcomUsbBypassEnter(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                               QUSB_BARRIER barrier, void *cookie,
+                               QUSB_BYPASS_LEASE *lease)
+{
+  if (!read32 || !write32 || !barrier || !lease) return QusbBadArgument;
+  if (!lease->active) return QusbQualified;
+  lease->phase = 1u;
+  barrier(cookie);
+  if ((lease->changed & 1u) && !write32(cookie, cb_address(lease), 0u)) return QusbWriteFailed;
+  if ((lease->changed & 4u) && !write32(cookie, cba2r_address(lease), 1u)) return QusbWriteFailed;
+  if ((lease->changed & 2u) && !write32(cookie, cbar_address(lease), 0x10000u)) return QusbWriteFailed;
+  barrier(cookie);
+  if ((lease->changed & 8u) && !write32(cookie, s2cr_address(lease), lease->bank))
+    return QusbWriteFailed;
+  if (!(lease->original_smr & 0x80000000u) &&
+      !write32(cookie, smr_address(lease), 0x80000000u | QUSB_STREAM_ID))
+    return QusbWriteFailed;
+  barrier(cookie);
+  lease->readback = 0u;
+  (void)read32(cookie, s2cr_address(lease), &lease->readback);
+  return QusbQualified;
+}
+
+QUSB_RESULT QcomUsbBypassRestore(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                                 QUSB_BARRIER barrier, void *cookie,
+                                 QUSB_BYPASS_LEASE *lease)
+{
+  if (!read32 || !write32 || !barrier || !lease) return QusbBadArgument;
+  if (!lease->active) return QusbQualified;
+  lease->phase = 2u;
+  barrier(cookie);
+  if ((lease->changed & 8u) && !write32(cookie, s2cr_address(lease), lease->original_s2cr))
+    return QusbWriteFailed;
+  if ((lease->changed & 1u) && !write32(cookie, cb_address(lease), lease->saved_sctlr))
+    return QusbWriteFailed;
+  if ((lease->changed & 2u) && !write32(cookie, cbar_address(lease), lease->saved_cbar))
+    return QusbWriteFailed;
+  if ((lease->changed & 4u) && !write32(cookie, cba2r_address(lease), lease->saved_cba2r))
+    return QusbWriteFailed;
+  barrier(cookie);
+  lease->active = 0u;
+  return QusbQualified;
+}
+
+int QcomUsbBypassWriteAllowed(const QUSB_BYPASS_LEASE *lease,
+                              QUSB_U64 address, QUSB_U32 value)
+{
+  if (!lease || !lease->active || lease->bank >= 128u) return 0;
+  if (lease->phase == 1u) {
+    if ((lease->changed & 1u) && address == cb_address(lease) && value == 0u) return 1;
+    if ((lease->changed & 4u) && address == cba2r_address(lease) && value == 1u) return 1;
+    if ((lease->changed & 2u) && address == cbar_address(lease) && value == 0x10000u) return 1;
+    if ((lease->changed & 8u) && address == s2cr_address(lease) && value == lease->bank) return 1;
+    if (!(lease->original_smr & 0x80000000u) && address == smr_address(lease) &&
+        value == (0x80000000u | QUSB_STREAM_ID)) return 1;
+    return 0;
+  }
+  if (lease->phase == 2u) {
+    if ((lease->changed & 8u) && address == s2cr_address(lease) &&
+        value == lease->original_s2cr) return 1;
+    if ((lease->changed & 1u) && address == cb_address(lease) &&
+        value == lease->saved_sctlr) return 1;
+    if ((lease->changed & 2u) && address == cbar_address(lease) &&
+        value == lease->saved_cbar) return 1;
+    if ((lease->changed & 4u) && address == cba2r_address(lease) &&
+        value == lease->saved_cba2r) return 1;
+  }
+  return 0;
+}
diff --git a/bsd/dev/qcomusb/soc/QcomUsbBypass.h b/bsd/dev/qcomusb/soc/QcomUsbBypass.h
new file mode 100644
index 0000000..4b198d4
--- /dev/null
+++ b/bsd/dev/qcomusb/soc/QcomUsbBypass.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: MIT
+ * USB stream pass-through through the firmware's bypass context bank.
+ *
+ * On this firmware a TYPE=BYPASS S2CR reads back as FAULT (evidence: the sheng
+ * port's SmmuBypass.h and the board's own UFS takeover in
+ * drivers/NativeUfs/SmmuTakeover.h). The working configuration is a context
+ * bank with S1 translation off (SCTLR=0), CBAR.TYPE=S1_TRANS_S2_BYPASS
+ * (0x10000) and CBA2R.VA64=1; the stream selects it with an ordinary
+ * TYPE=TRANSLATE S2CR holding the bank number. Writes to S2CR/CBAR/SCTLR on
+ * SM8150 do not read back the written value, so nothing here treats a
+ * mismatched readback as failure - the caller verifies with real DMA (host
+ * reset / event ring), and every register we changed is saved and written back
+ * by QcomUsbBypassRestore().
+ */
+#ifndef QCOM_USB_BYPASS_H
+#define QCOM_USB_BYPASS_H
+
+#include "QcomUsbQualify.h"
+
+typedef struct {
+  QUSB_U32 active, phase;     /* phase 1 = commit, 2 = restore */
+  QUSB_U32 slot, bank, pages;
+  QUSB_U32 original_cr0, original_s2cr, original_smr;
+  QUSB_U32 saved_sctlr, saved_cbar, saved_cba2r;
+  QUSB_U32 changed;           /* 1 = SCTLR, 2 = CBAR, 4 = CBA2R, 8 = S2CR */
+  QUSB_U32 readback;          /* S2CR read after the commit (diagnostic only) */
+} QUSB_BYPASS_LEASE;
+
+/* Read-only planning: geometry, our stream slot and the bank to use. The DMA
+ * range is only checked against the SMMU's declared address widths. */
+QUSB_RESULT QcomUsbBypassPlan(QUSB_READ32 read32, void *cookie, QUSB_U64 dma,
+                              QUSB_U32 bytes, QUSB_BYPASS_LEASE *lease);
+QUSB_RESULT QcomUsbBypassEnter(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                               QUSB_BARRIER barrier, void *cookie,
+                               QUSB_BYPASS_LEASE *lease);
+QUSB_RESULT QcomUsbBypassRestore(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                                 QUSB_BARRIER barrier, void *cookie,
+                                 QUSB_BYPASS_LEASE *lease);
+/* Callback policy: only the planned register/value pairs are writable. */
+int QcomUsbBypassWriteAllowed(const QUSB_BYPASS_LEASE *lease,
+                              QUSB_U64 address, QUSB_U32 value);
+
+#endif
diff --git a/bsd/dev/qcomusb/soc/QcomUsbDmaDomain.c b/bsd/dev/qcomusb/soc/QcomUsbDmaDomain.c
new file mode 100644
index 0000000..3a09220
--- /dev/null
+++ b/bsd/dev/qcomusb/soc/QcomUsbDmaDomain.c
@@ -0,0 +1,450 @@
+/* SPDX-License-Identifier: MIT
+ * Private AArch64 SMMUv2 S1 domain: exactly eight RW/NX/nG pages, no bypass.
+ */
+#include "QcomUsbDmaDomain.h"
+
+#define MAGIC 0x51534431U
+#define PA_MASK 0x0000fffffffff000ULL
+#define LEAF_FLAGS 0x0060000000000f43ULL
+#define SCTLR_VALUE 0x27U /* CFRE, AFE, TRE, M; optional ASIDPNE hint remains zero. */
+#define TCR2_CRITICAL 0x38017U /* SEP, ASID width and output address size. */
+#define FSR_FAULT 0xc00001feU /* Linux: MULTI/SS/UUT/ASF/TLBLKF/TLBMCF/EF/PF/AFF/TF. */
+#define FSR_FORMAT 0x600U     /* Read-only status, generated from VA64/effective EAE. */
+#define FSR_RESERVED (~(FSR_FAULT|FSR_FORMAT))
+enum { CFG=1, TLBI=2, SYNC=3, ENABLE=4, S2PREP=5, SMRPREP=6, COMMIT=7,
+       LIVE=8, INVALIDATE=9, DISABLE=10, RESTORE_CFG=11, PAIR_FIRST=12, PAIR_LAST=13 };
+
+static void zero(void *p,QUSB_U32 n) { unsigned char *b=p; while(n--) *b++=0; }
+static QUSB_U32 physical_bits(QUSB_U32 code)
+{
+  static const QUSB_U32 bits[]={32,36,40,42,44,48};
+  return code<6?bits[code]:0;
+}
+static int fsr_idle(QUSB_U32 value)
+{
+  /* FORMAT2=0x400 is normal AArch64 status, not a recorded fault. Unknown
+   * reserved bits remain a refusal rather than being labelled a fault. */
+  return !(value&FSR_FAULT)&&!(value&FSR_RESERVED);
+}
+static int fsr_a64(QUSB_U32 value)
+{
+  return fsr_idle(value)&&(value&FSR_FORMAT)==0x400U;
+}
+static int extent(QUSB_U64 pa,QUSB_U32 n,QUSB_U32 bits)
+{
+  return bits>=32 && bits<=48 && !(pa&4095U) && pa && pa+n>pa && pa+n<=(1ULL<<bits);
+}
+
+QUSB_DOMAIN_RESULT QcomUsbDomainBuildTables(void *cpu,QUSB_U64 pa,QUSB_U32 bytes,
+                                           QUSB_U64 dma,QUSB_U32 dma_bytes,QUSB_U32 bits)
+{
+  QUSB_U64 *p=cpu;
+  QUSB_U32 i;
+  if(!cpu || ((QUSB_U64)cpu&4095U) || bytes!=QUSB_DOMAIN_PT_BYTES ||
+     dma_bytes!=QUSB_DOMAIN_DMA_BYTES || !extent(pa,bytes,bits) || !extent(dma,dma_bytes,bits) ||
+     (pa<dma+dma_bytes && dma<pa+bytes)) return QusbDomainBadArgument;
+  zero(cpu,bytes);
+  p[(QUSB_DOMAIN_IOVA>>30)&511U]=(pa+4096)|3U;
+  p[512+((QUSB_DOMAIN_IOVA>>21)&511U)]=(pa+8192)|3U;
+  for(i=0;i<8;i++) p[1024+i]=(dma+4096ULL*i)|LEAF_FLAGS;
+  return QusbDomainOkay;
+}
+
+static int platform_ok(const QUSB_DOMAIN_PLATFORM *p)
+{
+  return p&&p->read32&&p->write32&&p->read64&&p->write64&&p->barrier&&p->delay_us&&p->clean_tables;
+}
+static QUSB_U64 reg_address(const QUSB_DOMAIN_LEASE *l,QUSB_U32 i)
+{
+  static const QUSB_U32 offset[]={0,0,0x10,0x30,0x20,0x28,0x38,0x3c,0x34,0};
+  if(i==0) return l->gr1_base+0x800+4*l->cb;
+  if(i==1) return l->gr1_base+4*l->cb;
+  return l->cb_base+offset[i];
+}
+static QUSB_U64 reg_value(const QUSB_DOMAIN_LEASE *l,QUSB_U32 i)
+{
+  QUSB_U32 ps=l->id2&15U; /* S1 output IPA size; physical extents also obey OAS. */
+  switch(i) {
+    case 0:return 1; /* CBA2R.VA64; VMID0 for S1 domain, 16-bit ASID in TCR2. */
+    case 1:return 0x1f300U; /* CBAR S1_TRANS/S2_BYPASS, WB, NSH per Linux. */
+    case 2:return l->tcr2_preserved|0x38010U|ps; /* Preserve current noncritical controls. */
+    case 3:return 0x803520U; /* TCR EPD1, SH_IS, ORGN/IRGN_WBWA, T0SZ32. */
+    case 4:return l->table_pa|((QUSB_U64)l->asid<<48);
+    case 5:return (QUSB_U64)l->asid<<48;
+    case 6:return 0xffU; /* MAIR index0 normal WBWA. */
+    case 7:case 8:return 0;
+    case 9:return SCTLR_VALUE;
+    default:return 0;
+  }
+}
+static int lease_shape(const QUSB_DOMAIN_LEASE *l)
+{
+  QUSB_U32 i,shift,pages,bits1,bits2;
+  if(!l||l->magic!=MAGIC||l->active!=1||!l->stream_count||l->stream_count>128||
+     !l->bank_count||l->bank_count>128||l->index>=l->stream_count||l->cb>=l->bank_count||
+     l->cb<((l->id1>>16)&255U)||
+     l->extended_stream_ids>1||l->enable_attempted>1||l->tlb_released>1||l->tlb_poisoned>1||
+     l->tcr2_bound>1||l->tcr2_view_owned>1||l->tcr2_capture_pending>1||
+     (l->tcr2_preserved&TCR2_CRITICAL)||(l->tcr2_view_owned&&!l->tcr2_bound)||
+     l->asid<256||l->asid>65535||l->iova!=QUSB_DOMAIN_IOVA||
+     (l->original_cr0&0x409U)!=(0x400U|(l->extended_stream_ids<<3))) return 0;
+  bits1=physical_bits(l->id2&15U);bits2=physical_bits((l->id2>>4)&15U);
+  if(!bits1||!bits2||!(l->id0&(1U<<30))||!(l->id0&(1U<<27))||!(l->id2&(1U<<12))||
+     !extent(l->table_pa,QUSB_DOMAIN_PT_BYTES,bits1<bits2?bits1:bits2)||
+     !extent(l->dma_pa,QUSB_DOMAIN_DMA_BYTES,bits1<bits2?bits1:bits2)||
+     (l->table_pa<l->dma_pa+QUSB_DOMAIN_DMA_BYTES&&l->dma_pa<l->table_pa+QUSB_DOMAIN_PT_BYTES))return 0;
+  shift=(l->id1>>31)?16U:12U;pages=2U<<((l->id1>>28)&7U);
+  if(l->gr1_base!=QUSB_SMMU_BASE+(1ULL<<shift)||
+     l->cb_base!=QUSB_SMMU_BASE+(((QUSB_U64)pages+l->cb)<<shift)||
+     l->cb_base+0x8f4U>QUSB_SMMU_BASE+QUSB_SMMU_BYTES||
+     l->new_smr!=(l->extended_stream_ids?QUSB_STREAM_ID:(0x80000000U | QUSB_STREAM_ID))||
+     l->new_s2cr!=(l->cb|(l->extended_stream_ids<<10))||
+     (l->extended_stream_ids?(l->old_s2cr&(1U<<10)):(l->old_smr&0x80000000U))) return 0;
+  for(i=0;i<QUSB_DOMAIN_REGISTER_COUNT;i++) {
+    if(l->regs[i].address!=reg_address(l,i)||l->regs[i].installed!=reg_value(l,i)||
+       l->regs[i].width!=((i==4||i==5)?8U:4U)||l->regs[i].touched>1U) return 0;
+  }
+  if(l->tcr2_bound&&
+     ((l->tcr2_format_cba2r!=l->regs[0].saved&&l->tcr2_format_cba2r!=l->regs[0].installed)||
+      (l->tcr2_format_cbar!=l->regs[1].saved&&l->tcr2_format_cbar!=l->regs[1].installed)))return 0;
+  return !(l->regs[9].saved&1U);
+}
+int QcomUsbDomainWriteAllowed(const QUSB_DOMAIN_LEASE *l,QUSB_U64 a,QUSB_U64 v,QUSB_U32 width)
+{
+  QUSB_U64 smr,s2cr;
+  if(!lease_shape(l)) return 0;
+  smr=QUSB_SMMU_BASE+0x800+4*l->index;s2cr=QUSB_SMMU_BASE+0xc00+4*l->index;
+  if(l->phase==CFG||l->phase==RESTORE_CFG) {
+    if(l->operation>=10||(l->phase==CFG&&l->operation>=9)) return 0;
+    if(l->phase==CFG&&l->operation==2&&
+       (!l->tcr2_bound||!l->tcr2_view_owned||
+        l->tcr2_format_cba2r!=l->regs[0].installed||l->tcr2_format_cbar!=l->regs[1].installed||
+        l->tcr2_preserved!=(l->tcr2_observed&~TCR2_CRITICAL)))return 0;
+    return a==l->regs[l->operation].address&&width==l->regs[l->operation].width&&
+      v==(l->phase==CFG?l->regs[l->operation].installed:l->regs[l->operation].saved);
+  }
+  if(width!=4) return 0;
+  switch(l->phase) {
+    case TLBI:return a==l->cb_base+0x610&&v==l->asid;
+    case SYNC:return a==l->cb_base+0x7f0&&v==0xffffffffU;
+    case ENABLE:return a==l->cb_base&&v==SCTLR_VALUE;
+    case DISABLE:return a==l->cb_base&&v==0;
+    case S2PREP:return a==s2cr&&v==l->cb;
+    case SMRPREP:return a==smr&&v==QUSB_STREAM_ID;
+    case COMMIT:return l->extended_stream_ids?a==s2cr&&v==l->new_s2cr:a==smr&&v==l->new_smr;
+    case INVALIDATE:return l->extended_stream_ids?a==s2cr&&v==l->cb:a==smr&&v==QUSB_STREAM_ID;
+    case PAIR_FIRST:return l->extended_stream_ids?a==smr&&v==l->old_smr:a==s2cr&&v==l->old_s2cr;
+    case PAIR_LAST:return l->extended_stream_ids?a==s2cr&&v==l->old_s2cr:a==smr&&v==l->old_smr;
+    default:return 0;
+  }
+}
+static int read_reg(const QUSB_DOMAIN_PLATFORM *p,QUSB_U64 a,QUSB_U32 width,QUSB_U64 *v)
+{
+  QUSB_U32 small;
+  if(width==8) return p->read64(p->cookie,a,v);
+  if(!p->read32(p->cookie,a,&small)) return 0;
+  *v=small;return 1;
+}
+static QUSB_DOMAIN_RESULT mode_ok(const QUSB_DOMAIN_PLATFORM *p,const QUSB_DOMAIN_LEASE *l)
+{
+  QUSB_U32 v,cr2;
+  if(!p->read32(p->cookie,QUSB_SMMU_BASE,&v)||!p->read32(p->cookie,QUSB_SMMU_BASE+8,&cr2))
+    return QusbDomainReadFailed;
+  return (v&0x409U)==(l->original_cr0&0x409U)&&!(cr2&0xa0000000U)?
+    QusbDomainOkay:QusbDomainOwnershipChanged;
+}
+/* A format write may change read-only/reserved or inherited functional bits in
+ * the TCR2 view. Capture that exact view immediately; never mask later checks.
+ * Pending captures are retried only while the selected bank is disabled.
+ */
+static QUSB_DOMAIN_RESULT capture_tcr2(const QUSB_DOMAIN_PLATFORM *p,QUSB_DOMAIN_LEASE *l)
+{
+  QUSB_U32 a,b,s,v;
+  if(!p->read32(p->cookie,l->regs[0].address,&a)||
+     !p->read32(p->cookie,l->regs[1].address,&b)||
+     !p->read32(p->cookie,l->cb_base,&s)||
+     !p->read32(p->cookie,l->regs[2].address,&v))return QusbDomainReadFailed;
+  if((s&1U)||(a!=l->regs[0].saved&&a!=l->regs[0].installed)||
+     (b!=l->regs[1].saved&&b!=l->regs[1].installed))return QusbDomainOwnershipChanged;
+  l->tcr2_observed=v;l->tcr2_format_cba2r=a;l->tcr2_format_cbar=b;
+  l->tcr2_bound=1;l->tcr2_view_owned=1;l->tcr2_capture_pending=0;
+  return QusbDomainOkay;
+}
+static QUSB_DOMAIN_RESULT halted(const QUSB_DOMAIN_PLATFORM *p)
+{
+  QUSB_U32 g,c,s;
+  if(!p->read32(p->cookie,QUSB_DWC3_BASE+0xc110,&g)||
+     !p->read32(p->cookie,QUSB_DWC3_BASE+0xc704,&c)||
+     !p->read32(p->cookie,QUSB_DWC3_BASE+0xc70c,&s)) return QusbDomainReadFailed;
+  return ((g>>12)&3U)==2U&&!(c&(1U<<31))&&(s&(1U<<22))?QusbDomainOkay:QusbDomainCoreRunning;
+}
+static QUSB_DOMAIN_RESULT write_value(const QUSB_DOMAIN_PLATFORM *p,QUSB_DOMAIN_LEASE *l,
+                                     QUSB_U32 phase,QUSB_U32 op,QUSB_U64 a,QUSB_U64 v,QUSB_U32 width,int check)
+{
+  QUSB_DOMAIN_RESULT r;int written;
+  l->phase=phase;l->operation=op;l->stage=phase;l->last_address=a;l->last_expected=v;
+  if(!QcomUsbDomainWriteAllowed(l,a,v,width)) return QusbDomainBadArgument;
+  r=mode_ok(p,l);if(r) return r;
+  p->barrier(p->cookie);
+  written=width==8?p->write64(p->cookie,a,v):p->write32(p->cookie,a,(QUSB_U32)v);
+  p->barrier(p->cookie);
+  if(!written) return QusbDomainWriteFailed;
+  if(check) {
+    if(!read_reg(p,a,width,&l->last_readback)) return QusbDomainReadFailed;
+    if(l->last_readback!=v) return QusbDomainWriteFailed;
+  }
+  return QusbDomainOkay;
+}
+static QUSB_DOMAIN_RESULT tlb_sync(const QUSB_DOMAIN_PLATFORM *p,QUSB_DOMAIN_LEASE *l)
+{
+  QUSB_DOMAIN_RESULT r;QUSB_U32 n,v;
+  if(l->tlb_poisoned)return QusbDomainTlbTimeout;
+  /* A failed/timeout maintenance request must never be queued again: the
+   * QSMMUv500 driver warns a non-draining TBU queue can stall later stores. */
+  l->tlb_poisoned=1;
+  r=write_value(p,l,TLBI,0,l->cb_base+0x610,l->asid,4,0);if(r)return r;
+  r=write_value(p,l,SYNC,0,l->cb_base+0x7f0,0xffffffffU,4,0);if(r)return r;
+  for(n=0;n<1000;n++) {
+    if(!p->read32(p->cookie,l->cb_base+0x7f4,&v))return QusbDomainReadFailed;
+    if(!(v&1U)){l->tlb_poisoned=0;return QusbDomainOkay;}
+    p->delay_us(p->cookie,1);
+  }
+  return QusbDomainTlbTimeout;
+}
+
+/* Scans the complete supported NS table. No other stream may cover SID40. */
+static QUSB_DOMAIN_RESULT scan(const QUSB_DOMAIN_PLATFORM *p,QUSB_DOMAIN_LEASE *l,
+                               unsigned char used[128],int installed)
+{
+  QUSB_U32 i,smr,s2cr,mask,id,matches=0,first=0xffffffffU,oldsmr=0,olds2cr=0;
+  for(i=0;i<l->stream_count;i++) {
+    if(!p->read32(p->cookie,QUSB_SMMU_BASE+0x800+4*i,&smr)||
+       !p->read32(p->cookie,QUSB_SMMU_BASE+0xc00+4*i,&s2cr))return QusbDomainReadFailed;
+    if(l->extended_stream_ids?!(s2cr&(1U<<10)):!(smr&0x80000000U)) {
+      if(first==0xffffffffU) {first=i;oldsmr=smr;olds2cr=s2cr;} continue;
+    }
+    if(used&&(s2cr&255U)<l->bank_count) used[s2cr&255U]=1;
+    mask=(smr>>16)&(l->extended_stream_ids?0xffffU:0x7fffU);
+    id=smr&(l->extended_stream_ids?0xffffU:0x7fffU);
+    if((QUSB_STREAM_ID&~mask)!=(id&~mask))continue;
+    matches++;
+    if(!installed||i!=l->index||smr!=l->new_smr||s2cr!=l->new_s2cr) {
+      /* Report the conflicting slot and pair instead of a zeroed lease. */
+      if(!installed&&matches==1){l->index=i;l->old_smr=smr;l->old_s2cr=s2cr;}
+      return QusbDomainStreamExists;
+    }
+  }
+  if(installed)return matches==1?QusbDomainOkay:QusbDomainOwnershipChanged;
+  if(matches)return QusbDomainStreamExists;
+  if(first==0xffffffffU)return QusbDomainNoSlot;
+  l->index=first;l->old_smr=oldsmr;l->old_s2cr=olds2cr;return QusbDomainOkay;
+}
+
+QUSB_DOMAIN_RESULT QcomUsbDomainInstall(const QUSB_DOMAIN_PLATFORM *p,void *cpu,QUSB_U64 pt,
+                                       QUSB_U32 pt_bytes,QUSB_U64 dma,QUSB_U32 dma_bytes,
+                                       QUSB_DOMAIN_LEASE *l)
+{
+  QUSB_U32 i,j,v,cr2,shift,pages,ns2,chosen=0xffffffffU,bits,ps;
+  QUSB_U64 tt0,tt1,used_asid[256],value;unsigned char used[128];
+  QUSB_DOMAIN_RESULT r;
+  if(!platform_ok(p)||!l||l->active)return QusbDomainBadArgument;
+  zero(l,sizeof(*l));zero(used,sizeof(used));zero(used_asid,sizeof(used_asid));
+  r=halted(p);if(r)return r;
+  if(!p->read32(p->cookie,QUSB_SMMU_BASE+0x20,&l->id0)||
+     !p->read32(p->cookie,QUSB_SMMU_BASE+0x24,&l->id1)||
+     !p->read32(p->cookie,QUSB_SMMU_BASE+0x28,&l->id2)||
+     !p->read32(p->cookie,QUSB_SMMU_BASE,&l->original_cr0)||
+     !p->read32(p->cookie,QUSB_SMMU_BASE+8,&cr2))return QusbDomainReadFailed;
+  l->stream_count=l->id0&255U;l->bank_count=l->id1&255U;
+  l->extended_stream_ids=(l->original_cr0>>3)&1U;
+  if(!l->stream_count||l->stream_count>128||!l->bank_count||l->bank_count>128||
+     !(l->id0&(1U<<30))||!(l->id0&(1U<<27))||!(l->id2&(1U<<12))||
+     (l->original_cr0&0x401U)!=0x400U||(cr2&0xa0000000U)||
+     (l->extended_stream_ids&&!(l->id0&(1U<<8))))return QusbDomainUnsupported;
+  ps=(l->id2&15U)<((l->id2>>4)&15U)?(l->id2&15U):((l->id2>>4)&15U);
+  bits=physical_bits(ps);if(!bits)return QusbDomainUnsupported;
+  r=QcomUsbDomainBuildTables(cpu,pt,pt_bytes,dma,dma_bytes,bits);if(r)return r;
+  shift=(l->id1>>31)?16U:12U;pages=2U<<((l->id1>>28)&7U);
+  l->gr1_base=QUSB_SMMU_BASE+(1ULL<<shift);
+  if(QUSB_SMMU_BASE+(((QUSB_U64)pages+l->bank_count)<<shift)>QUSB_SMMU_BASE+QUSB_SMMU_BYTES)
+    return QusbDomainUnsupported;
+  ns2=(l->id1>>16)&255U;if(ns2>=l->bank_count)return QusbDomainNoBank;
+  r=scan(p,l,used,0);if(r)return r;
+  for(i=0;i<l->bank_count;i++) {
+    if(!p->read32(p->cookie,l->gr1_base+4*i,&v))return QusbDomainReadFailed;
+    if(((v>>16)&3U)==3U&&((v>>8)&255U)<l->bank_count)used[(v>>8)&255U]=1;
+    /* Stage2 banks have VMIDs, not S1 ASIDs, and no TTBR1 register. */
+    if(((v>>16)&3U)==0U)continue;
+    value=QUSB_SMMU_BASE+(((QUSB_U64)pages+i)<<shift);
+    if(!p->read64(p->cookie,value+0x20,&tt0)||!p->read64(p->cookie,value+0x28,&tt1))return QusbDomainReadFailed;
+    used_asid[2*i]=tt0>>48;used_asid[2*i+1]=tt1>>48;
+  }
+  for(i=ns2;i<l->bank_count;i++) {
+    value=QUSB_SMMU_BASE+(((QUSB_U64)pages+i)<<shift);
+    if(used[i])continue;
+    if(!p->read32(p->cookie,value,&v))return QusbDomainReadFailed;
+    if(v&1U)continue;
+    if(!p->read32(p->cookie,value+0x58,&v))return QusbDomainReadFailed;
+    if(fsr_idle(v)){chosen=i;break;}
+  }
+  if(chosen==0xffffffffU)return QusbDomainNoBank;
+  l->cb=chosen;l->cb_base=QUSB_SMMU_BASE+(((QUSB_U64)pages+chosen)<<shift);
+  for(i=0xff00U;i>0xfd00U;i--) {
+    for(j=0;j<2*l->bank_count;j++)if(used_asid[j]==i)break;
+    if(j==2*l->bank_count){l->asid=i;break;}
+  }
+  if(!l->asid)return QusbDomainNoAsid;
+  l->table_pa=pt;l->dma_pa=dma;l->iova=QUSB_DOMAIN_IOVA;
+  l->new_smr=l->extended_stream_ids?QUSB_STREAM_ID:(0x80000000U | QUSB_STREAM_ID);
+  l->new_s2cr=l->cb|(l->extended_stream_ids<<10);
+  for(i=0;i<QUSB_DOMAIN_REGISTER_COUNT;i++) {
+    l->regs[i].address=reg_address(l,i);l->regs[i].width=(i==4||i==5)?8:4;
+    l->regs[i].installed=reg_value(l,i);
+    if(!read_reg(p,l->regs[i].address,l->regs[i].width,&l->regs[i].saved))return QusbDomainReadFailed;
+  }
+  l->tcr2_preserved=(QUSB_U32)l->regs[2].saved&~TCR2_CRITICAL;
+  l->regs[2].installed=reg_value(l,2);
+  if(l->regs[9].saved&1U)return QusbDomainOwnershipChanged;
+  if(!p->read32(p->cookie,l->cb_base+4,&l->old_actlr))return QusbDomainReadFailed;
+  if(!p->clean_tables(p->cookie,cpu,pt_bytes))return QusbDomainCleanFailed;
+  p->barrier(p->cookie);
+  r=mode_ok(p,l);if(r)return r;
+  /* Re-read the selected inactive bank and pair before the first MMIO write. */
+  for(i=0;i<QUSB_DOMAIN_REGISTER_COUNT;i++) {
+    if(!read_reg(p,l->regs[i].address,l->regs[i].width,&value))return QusbDomainReadFailed;
+    if(value!=l->regs[i].saved)return QusbDomainOwnershipChanged;
+  }
+  if(!p->read32(p->cookie,QUSB_SMMU_BASE+0x800+4*l->index,&v)||v!=l->old_smr||
+     !p->read32(p->cookie,QUSB_SMMU_BASE+0xc00+4*l->index,&v)||v!=l->old_s2cr)
+    return QusbDomainOwnershipChanged;
+  l->magic=MAGIC;l->active=1;
+  for(i=0;i<9;i++) {
+    if(i==2) {
+      r=capture_tcr2(p,l);if(r)return r;
+      l->tcr2_preserved=l->tcr2_observed&~TCR2_CRITICAL;
+      l->regs[2].installed=reg_value(l,2);
+    }
+    if(i<2)l->tcr2_capture_pending=1;
+    l->regs[i].touched=1;
+    r=write_value(p,l,CFG,i,l->regs[i].address,l->regs[i].installed,l->regs[i].width,1);
+    if(i<2) {
+      QUSB_DOMAIN_RESULT captured=capture_tcr2(p,l);
+      if(r)return r;
+      if(captured)return captured;
+    } else if(r)return r;
+    if(i==2)l->tcr2_view_owned=0;
+  }
+  r=tlb_sync(p,l);if(r)return r;
+  l->enable_attempted=1;l->regs[9].touched=1;
+  r=write_value(p,l,ENABLE,9,l->cb_base,SCTLR_VALUE,4,1);if(r)return r;
+  r=write_value(p,l,S2PREP,0,QUSB_SMMU_BASE+0xc00+4*l->index,l->cb,4,1);if(r)return r;
+  r=write_value(p,l,SMRPREP,0,QUSB_SMMU_BASE+0x800+4*l->index,QUSB_STREAM_ID,4,1);if(r)return r;
+  {
+    QUSB_DOMAIN_LEASE checked=*l;
+    r=scan(p,&checked,0,0);if(r)return r;
+    if(checked.index!=l->index)return QusbDomainOwnershipChanged;
+    if(!p->read32(p->cookie,QUSB_SMMU_BASE+0x800+4*l->index,&v)||v!=QUSB_STREAM_ID||
+       !p->read32(p->cookie,QUSB_SMMU_BASE+0xc00+4*l->index,&v)||v!=l->cb)
+      return QusbDomainOwnershipChanged;
+    for(i=0;i<QUSB_DOMAIN_REGISTER_COUNT;i++) {
+      if(!read_reg(p,l->regs[i].address,l->regs[i].width,&value))return QusbDomainReadFailed;
+      if(value!=l->regs[i].installed)return QusbDomainOwnershipChanged;
+    }
+    if(!p->read32(p->cookie,l->cb_base+0x58,&v))return QusbDomainReadFailed;
+    if(!fsr_a64(v))return QusbDomainOwnershipChanged;
+  }
+  r=write_value(p,l,COMMIT,0,QUSB_SMMU_BASE+(l->extended_stream_ids?0xc00:0x800)+4*l->index,
+                l->extended_stream_ids?l->new_s2cr:l->new_smr,4,1);if(r)return r;
+  r=scan(p,l,0,1);if(r)return r;
+  for(i=0;i<QUSB_DOMAIN_REGISTER_COUNT;i++) {
+    if(!read_reg(p,l->regs[i].address,l->regs[i].width,&value))return QusbDomainReadFailed;
+    if(value!=l->regs[i].installed)return QusbDomainOwnershipChanged;
+  }
+  if(!p->read32(p->cookie,l->cb_base+0x58,&v))return QusbDomainReadFailed;
+  if(!fsr_a64(v))return QusbDomainOwnershipChanged;
+  l->phase=LIVE;l->stage=LIVE;return QusbDomainOkay;
+}
+
+QUSB_DOMAIN_RESULT QcomUsbDomainRestore(const QUSB_DOMAIN_PLATFORM *p,QUSB_DOMAIN_LEASE *l)
+{
+  QUSB_DOMAIN_RESULT r;QUSB_U32 i,smr,s2cr,v;QUSB_U64 value;
+  if(!platform_ok(p)||!l)return QusbDomainBadArgument;
+  if(!l->active)return QusbDomainOkay;
+  if(!lease_shape(l))return QusbDomainBadArgument;
+  if(l->tlb_poisoned)return QusbDomainTlbTimeout;
+  r=halted(p);if(r)return r;r=mode_ok(p,l);if(r)return r;
+  if(!p->read32(p->cookie,l->cb_base+0x58,&v))return QusbDomainReadFailed;
+  if(!fsr_idle(v)||(l->phase==LIVE&&!fsr_a64(v)))
+    return QusbDomainOwnershipChanged; /* Preserve actual fault/unknown evidence. */
+  if(l->tcr2_capture_pending) {
+    r=capture_tcr2(p,l);if(r)return r;
+  }
+  if(!p->read32(p->cookie,QUSB_SMMU_BASE+0x800+4*l->index,&smr)||
+     !p->read32(p->cookie,QUSB_SMMU_BASE+0xc00+4*l->index,&s2cr)||
+     !p->read32(p->cookie,l->cb_base+4,&v))return QusbDomainReadFailed;
+  if(v!=l->old_actlr)return QusbDomainOwnershipChanged;
+  if((smr!=l->old_smr&&smr!=QUSB_STREAM_ID&&smr!=l->new_smr)||
+     (s2cr!=l->old_s2cr&&s2cr!=l->cb&&s2cr!=l->new_s2cr))return QusbDomainOwnershipChanged;
+  for(i=0;i<QUSB_DOMAIN_REGISTER_COUNT;i++) {
+    if(!read_reg(p,l->regs[i].address,l->regs[i].width,&value))return QusbDomainReadFailed;
+    if(l->phase==LIVE&&value!=l->regs[i].installed)return QusbDomainOwnershipChanged;
+    /* Before our ASID flush completes, no format register has legitimately
+     * been restored. Retrying an invalidate/disable failure cannot accept
+     * old ASID-width/TCR words and flush under the wrong format.
+     */
+    if(l->enable_attempted&&!l->tlb_released&&i<9&&value!=l->regs[i].installed)
+      return QusbDomainOwnershipChanged;
+    if(i==2&&l->tcr2_view_owned&&value==l->tcr2_observed) {
+      QUSB_U32 a,b;
+      if(!p->read32(p->cookie,l->regs[0].address,&a)||!p->read32(p->cookie,l->regs[1].address,&b))
+        return QusbDomainReadFailed;
+      if(a!=l->tcr2_format_cba2r||b!=l->tcr2_format_cbar)return QusbDomainOwnershipChanged;
+      continue;
+    }
+    if(value!=l->regs[i].saved&&(!l->regs[i].touched||
+       (value!=l->regs[i].installed&&!(i==9&&value==0))))return QusbDomainOwnershipChanged;
+  }
+  if(l->extended_stream_ids?(s2cr&(1U<<10)):(smr&0x80000000U)) {
+    if(smr!=l->new_smr||s2cr!=l->new_s2cr)return QusbDomainOwnershipChanged;
+    r=write_value(p,l,INVALIDATE,0,QUSB_SMMU_BASE+(l->extended_stream_ids?0xc00:0x800)+4*l->index,
+                  l->extended_stream_ids?l->cb:QUSB_STREAM_ID,4,1);if(r)return r;
+  }
+  /* Flush before restoring address-format registers. Once released, retries
+   * must not issue a 16-bit ASID invalidation under an old 8-bit format. A bank
+   * never enabled cannot have used our tables/ASID and needs no such flush. */
+  if(!l->tlb_released) {
+    if(l->enable_attempted) {
+      l->regs[9].touched=1;r=write_value(p,l,DISABLE,9,l->cb_base,0,4,1);if(r)return r;
+      r=tlb_sync(p,l);if(r)return r;
+    }
+    l->tlb_released=1;
+  }
+  if(!p->read32(p->cookie,l->cb_base+0x58,&v))return QusbDomainReadFailed;
+  if(!fsr_idle(v))return QusbDomainOwnershipChanged;
+  for(i=0;i<9;i++) {
+    if(i<2)l->tcr2_capture_pending=1;
+    r=write_value(p,l,RESTORE_CFG,i,l->regs[i].address,l->regs[i].saved,l->regs[i].width,1);
+    if(i<2) {
+      QUSB_DOMAIN_RESULT captured=capture_tcr2(p,l);
+      if(r)return r;
+      if(captured)return captured;
+    } else if(r)return r;
+    if(i==2)l->tcr2_view_owned=0;
+    l->regs[i].touched=0;
+  }
+  /* Original SCTLR.M0 is restored last after its original format and TTBRs. */
+  r=write_value(p,l,RESTORE_CFG,9,l->cb_base,l->regs[9].saved,4,1);if(r)return r;
+  l->regs[9].touched=0;
+  r=write_value(p,l,PAIR_FIRST,0,QUSB_SMMU_BASE+(l->extended_stream_ids?0x800:0xc00)+4*l->index,
+                l->extended_stream_ids?l->old_smr:l->old_s2cr,4,1);if(r)return r;
+  r=write_value(p,l,PAIR_LAST,0,QUSB_SMMU_BASE+(l->extended_stream_ids?0xc00:0x800)+4*l->index,
+                l->extended_stream_ids?l->old_s2cr:l->old_smr,4,1);if(r)return r;
+  l->active=0;return QusbDomainOkay;
+}
+const char *QcomUsbDomainResultName(QUSB_DOMAIN_RESULT r)
+{
+  static const char *const names[]={"okay","bad argument","read failed","unsupported SMMU",
+    "USB not halted in DEVICE role","USB stream exists","no free stream slot","no free NS context bank",
+    "no unused ASID","ownership changed","write failed","local TLB timeout","table cache clean failed"};
+  return (QUSB_U32)r<sizeof(names)/sizeof(names[0])?names[r]:"unknown";
+}
diff --git a/bsd/dev/qcomusb/soc/QcomUsbDmaDomain.h b/bsd/dev/qcomusb/soc/QcomUsbDmaDomain.h
new file mode 100644
index 0000000..a9b70ab
--- /dev/null
+++ b/bsd/dev/qcomusb/soc/QcomUsbDmaDomain.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SOCRATES_QCOM_USB_DMA_DOMAIN_H
+#define SOCRATES_QCOM_USB_DMA_DOMAIN_H
+#include "QcomUsbQualify.h"
+
+#define QUSB_DOMAIN_IOVA QUD_DMA_IOVA
+#define QUSB_DOMAIN_DMA_BYTES 32768U
+#define QUSB_DOMAIN_PT_BYTES 12288U
+#define QUSB_DOMAIN_PAGE_BYTES 4096U
+#define QUSB_DOMAIN_REGISTER_COUNT 10U
+
+typedef int (*QUSB_READ64)(void *, QUSB_U64, QUSB_U64 *);
+typedef int (*QUSB_WRITE64)(void *, QUSB_U64, QUSB_U64);
+typedef int (*QUSB_CLEAN_TABLES)(void *, void *cpu, QUSB_U32 bytes);
+typedef struct {
+  void *cookie;
+  QUSB_READ32 read32;
+  QUSB_WRITE32 write32;
+  QUSB_READ64 read64;
+  QUSB_WRITE64 write64;
+  QUSB_BARRIER barrier;
+  QUSB_DELAY_US delay_us;
+  QUSB_CLEAN_TABLES clean_tables;
+} QUSB_DOMAIN_PLATFORM;
+
+typedef enum {
+  QusbDomainOkay = 0,
+  QusbDomainBadArgument,
+  QusbDomainReadFailed,
+  QusbDomainUnsupported,
+  QusbDomainCoreRunning,
+  QusbDomainStreamExists,
+  QusbDomainNoSlot,
+  QusbDomainNoBank,
+  QusbDomainNoAsid,
+  QusbDomainOwnershipChanged,
+  QusbDomainWriteFailed,
+  QusbDomainTlbTimeout,
+  QusbDomainCleanFailed
+} QUSB_DOMAIN_RESULT;
+
+typedef struct {
+  QUSB_U64 address, saved, installed;
+  QUSB_U32 width, touched;
+} QUSB_DOMAIN_REGISTER;
+
+typedef struct {
+  QUSB_U32 magic, active, phase, operation;
+  QUSB_U32 index, cb, asid, extended_stream_ids, stream_count, bank_count;
+  QUSB_U32 original_cr0, id0, id1, id2, old_smr, old_s2cr;
+  QUSB_U32 new_smr, new_s2cr, old_actlr, stage;
+  QUSB_U32 enable_attempted, tlb_released, tlb_poisoned;
+  QUSB_U32 tcr2_preserved, tcr2_observed, tcr2_bound, tcr2_view_owned;
+  QUSB_U32 tcr2_format_cba2r, tcr2_format_cbar, tcr2_capture_pending;
+  QUSB_U64 cb_base, gr1_base, table_pa, dma_pa;
+  QUSB_U64 iova, last_address, last_expected, last_readback;
+  QUSB_DOMAIN_REGISTER regs[QUSB_DOMAIN_REGISTER_COUNT];
+} QUSB_DOMAIN_LEASE;
+
+/* Caller provides separately owned contiguous 3x4K page-table pages and an
+ * owned 32KiB DMA arena. CPU table pointer can differ from its physical PA.
+ * Install maps only the eight DMA pages at fixed IOVA0x90000000 using enabled
+ * AArch64 S1 translation. No identity/BYPASS fallback exists.
+ * No device/MMIO access in the page-table-only builder below.
+ */
+QUSB_DOMAIN_RESULT QcomUsbDomainBuildTables(void *table_cpu, QUSB_U64 table_pa,
+                                           QUSB_U32 table_bytes, QUSB_U64 dma_pa,
+                                           QUSB_U32 dma_bytes, QUSB_U32 pa_bits);
+QUSB_DOMAIN_RESULT QcomUsbDomainInstall(const QUSB_DOMAIN_PLATFORM *platform,
+                                       void *table_cpu, QUSB_U64 table_pa,
+                                       QUSB_U32 table_bytes, QUSB_U64 dma_pa,
+                                       QUSB_U32 dma_bytes, QUSB_DOMAIN_LEASE *lease);
+QUSB_DOMAIN_RESULT QcomUsbDomainRestore(const QUSB_DOMAIN_PLATFORM *platform,
+                                       QUSB_DOMAIN_LEASE *lease);
+/* Pure phase/address/value policy for the platform's write callbacks.
+ * width must be4 or8. Only selected CB configuration/localTLB and selected
+ * exactSID40 SMR/S2CR can be written. Platform still checks MMIO mappings.
+ */
+int QcomUsbDomainWriteAllowed(const QUSB_DOMAIN_LEASE *lease,
+                              QUSB_U64 address, QUSB_U64 value, QUSB_U32 width);
+const char *QcomUsbDomainResultName(QUSB_DOMAIN_RESULT result);
+#endif
diff --git a/bsd/dev/qcomusb/soc/QcomUsbPrepare.c b/bsd/dev/qcomusb/soc/QcomUsbPrepare.c
new file mode 100644
index 0000000..903d1d3
--- /dev/null
+++ b/bsd/dev/qcomusb/soc/QcomUsbPrepare.c
@@ -0,0 +1,400 @@
+/* SPDX-License-Identifier: MIT
+ * SM8150/nabu device-mode bring-up for the USB log module.
+ *
+ * The log module inherits a ready PHY and a device-mode core. ABL hands the
+ * controller over in host mode and halted, so this file does the missing half:
+ * GDSC power, branch clocks, reset release, the femto HS PHY sequence and the
+ * core's device-mode soft reset. Every wait is bounded and every read can come
+ * back as zero when the caller's own deadline has expired.
+ *
+ * Order matters and follows the board's measured sequence (see the archived
+ * NativeDwc3 driver): clocks before reset release, PHY before the core is put
+ * into device mode, and VBUSVLDEXT0 must stay set across the D+ pulse.
+ */
+#include <stddef.h>
+#include "../include/QcomUsbPrepare.h"
+
+/* DWC3 core registers (offsets from the core base). */
+#define DWC3_GSNPSID        0x0c120u
+#define DWC3_GCTL           0x0c110u
+#define DWC3_GSTS           0x0c118u
+#define DWC3_GUSB2PHYCFG0   0x0c200u
+#define DWC3_GUSB3PIPECTL0  0x0c2c0u
+#define DWC3_DCFG           0x0c700u
+#define DWC3_DCTL           0x0c704u
+#define DWC3_DSTS           0x0c70cu
+
+#define GCTL_CORESOFTRESET  (1u << 11)
+#define GCTL_PRTCAP_DEVICE  (2u << 12)
+#define GCTL_DSBLCLKGTNG    (1u << 0)
+#define GSTS_CURMOD         0x3u
+#define GSTS_CURMOD_DEVICE  0u   /* 0 = device, 1 = host, 2 = DRD */
+#define GUSB2PHYCFG_PHYSOFTRST (1u << 31)
+#define GUSB2PHYCFG_SUSPHY  (1u << 6)
+#define GUSB2PHYCFG_ENBLSLPM (1u << 8)
+#define GUSB3PIPECTL_SUSPHY (1u << 17)
+#define DCTL_CSFTRST        (1u << 30)
+#define DCTL_RUN_STOP       (1u << 31)
+#define DSTS_DEVCTRLHLT     (1u << 22)
+#define DCFG_DEVSPD_HS      0u   /* DCFG.DEVSPD: 0 = high speed (1 is full speed!) */
+
+/* dwc3_set_mode() settles for 100 ms after the mode write; the module's
+ * delay_us() refuses anything above 10 ms, so the wait is split. */
+#define CORE_MODE_SETTLE_STEP_US 10000u
+#define CORE_MODE_SETTLE_STEPS   10u
+
+/* GCC bits. */
+#define GDSCR_SW_COLLAPSE   (1u << 0)
+#define GDSCR_HW_CONTROL    (1u << 1)
+#define GDSCR_PWR_ON        (1u << 31)
+#define CBCR_CLK_OFF        (1u << 31)
+#define CBCR_ENABLE         (1u << 0)
+
+/* femto HS PHY (phy-msm-snps-hs), offsets inside the QUD_PHY window. */
+#define PHY_UTMI_CTRL0      0x3cu
+#define PHY_UTMI_CTRL1      0x40u
+#define PHY_UTMI_CTRL5      0x50u
+#define PHY_COMMON0         0x54u
+#define PHY_COMMON1         0x58u
+#define PHY_COMMON2         0x5cu
+#define PHY_CTRL1           0x60u
+#define PHY_CTRL2           0x64u
+#define PHY_OVERRIDE_X1     0x70u
+#define PHY_OVERRIDE_X2     0x74u
+#define PHY_CFG0            0x94u
+#define PHY_REFCLK_CTRL     0xa0u
+
+struct prep {
+    const QCOM_PREPARE_PLATFORM *p;
+    uint32_t *last;
+};
+
+static int
+prep_read(struct prep *c, uint64_t address, uint32_t *value)
+{
+    if (!c->p->read32(c->p->cookie, address, value)) {
+        return 0;
+    }
+    if (c->last) {
+        *c->last = *value;
+    }
+    return 1;
+}
+
+static int
+prep_write(struct prep *c, uint64_t address, uint32_t value)
+{
+    if (!c->p->write32(c->p->cookie, address, value)) {
+        return 0;
+    }
+    if (c->last) {
+        *c->last = value;
+    }
+    return 1;
+}
+
+static int
+prep_mask(struct prep *c, uint64_t address, uint32_t mask, uint32_t set)
+{
+    uint32_t value;
+
+    if (!prep_read(c, address, &value)) {
+        return 0;
+    }
+    value = (value & ~mask) | (set & mask);
+    return prep_write(c, address, value);
+}
+
+static void
+prep_delay(struct prep *c, uint32_t usec)
+{
+    if (c->p->delay_us) {
+        c->p->delay_us(c->p->cookie, usec);
+    }
+}
+
+/* GDSC: clear SW_COLLAPSE/HW_CONTROL, then wait for PWR_ON. */
+static QCOM_PREPARE_RESULT
+prep_power(struct prep *c)
+{
+    uint32_t value;
+    unsigned int i;
+
+    if (!prep_read(c, QUD_GCC_BASE + QUD_GCC_GDSCR_OFFSET, &value)) {
+        return QPREP_DEADLINE;
+    }
+    if (!prep_write(c, QUD_GCC_BASE + QUD_GCC_GDSCR_OFFSET,
+                    value & ~(GDSCR_SW_COLLAPSE | GDSCR_HW_CONTROL))) {
+        return QPREP_DEADLINE;
+    }
+    for (i = 0; i < 200u; ++i) {
+        if (!prep_read(c, QUD_GCC_BASE + QUD_GCC_GDSCR_OFFSET, &value)) {
+            return QPREP_DEADLINE;
+        }
+        if (value & GDSCR_PWR_ON) {
+            return QPREP_OK;
+        }
+        prep_delay(c, 100);
+    }
+    return QPREP_GDSC;
+}
+
+/* Every USB branch clock: enable, then wait for CLK_OFF to drop. */
+static QCOM_PREPARE_RESULT
+prep_clocks(struct prep *c)
+{
+    static const uint32_t cbcr[] = QUD_GCC_CLOCK_OFFSETS;
+    unsigned int i;
+
+    for (i = 0; i < sizeof(cbcr) / sizeof(cbcr[0]); ++i) {
+        if (!prep_mask(c, QUD_GCC_BASE + cbcr[i], CBCR_ENABLE, CBCR_ENABLE)) {
+            return QPREP_DEADLINE;
+        }
+    }
+    for (i = 0; i < sizeof(cbcr) / sizeof(cbcr[0]); ++i) {
+        static const uint32_t no_poll[] = QUD_GCC_CLOCK_NO_POLL_OFFSETS;
+        unsigned int tries, skip = 0;
+        uint32_t value = CBCR_CLK_OFF;
+
+        for (tries = 0; tries < sizeof(no_poll) / sizeof(no_poll[0]); ++tries) {
+            if (no_poll[tries] && no_poll[tries] == cbcr[i]) {
+                skip = 1;
+            }
+        }
+        if (skip) {
+            continue;   /* branch reports no usable halt status */
+        }
+        for (tries = 0; tries < 200u; ++tries) {
+            if (!prep_read(c, QUD_GCC_BASE + cbcr[i], &value)) {
+                return QPREP_DEADLINE;
+            }
+            if (!(value & CBCR_CLK_OFF)) {
+                break;
+            }
+            prep_delay(c, 100);
+        }
+        if (value & CBCR_CLK_OFF) {
+            return QPREP_CLOCKS;
+        }
+    }
+    return QPREP_OK;
+}
+
+/* The USB30_PRIM reset does not self-clear: assert, then release explicitly. */
+static QCOM_PREPARE_RESULT
+prep_reset(struct prep *c)
+{
+    uint32_t value;
+
+    if (!prep_write(c, QUD_GCC_BASE + QUD_GCC_BCR_OFFSET, 1u)) {
+        return QPREP_DEADLINE;
+    }
+    prep_delay(c, 1000);
+    if (!prep_write(c, QUD_GCC_BASE + QUD_GCC_BCR_OFFSET, 0u)) {
+        return QPREP_DEADLINE;
+    }
+    prep_delay(c, 1000);
+    /* The PHY's own resets do not self-clear either. */
+    if (QUD_GCC_AHB2PHY_BCR_OFFSET) {
+        if (!prep_write(c, QUD_GCC_BASE + QUD_GCC_AHB2PHY_BCR_OFFSET, 1u)) return QPREP_DEADLINE;
+        prep_delay(c, 1000);
+        if (!prep_write(c, QUD_GCC_BASE + QUD_GCC_AHB2PHY_BCR_OFFSET, 0u)) return QPREP_DEADLINE;
+    }
+    if (QUD_GCC_QUSB2PHY_BCR_OFFSET) {
+        if (!prep_write(c, QUD_GCC_BASE + QUD_GCC_QUSB2PHY_BCR_OFFSET, 1u)) return QPREP_DEADLINE;
+        prep_delay(c, 1000);
+        if (!prep_write(c, QUD_GCC_BASE + QUD_GCC_QUSB2PHY_BCR_OFFSET, 0u)) return QPREP_DEADLINE;
+    }
+    if (!prep_read(c, QUD_GCC_BASE + QUD_GCC_BCR_OFFSET, &value)) {
+        return QPREP_DEADLINE;
+    }
+    return (value & 1u) ? QPREP_RESET : QPREP_OK;
+}
+
+static QCOM_PREPARE_RESULT
+prep_identity(struct prep *c)
+{
+    uint32_t id;
+    uint32_t family;
+
+    if (!prep_read(c, QUD_DWC3_BASE + DWC3_GSNPSID, &id)) {
+        return QPREP_DEADLINE;
+    }
+    family = id & 0xffff0000u;
+    if (family != 0x55330000u && family != 0x33310000u) {
+        return QPREP_ID;
+    }
+    return QPREP_OK;
+}
+
+/* femto HS PHY: msm_hsphy_init() order, then the D+ pulse with XCVRSEL at 0x40. */
+static QCOM_PREPARE_RESULT
+prep_phy(struct prep *c)
+{
+    uint32_t value;
+    unsigned int i;
+
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_CFG0, 1u << 1, 1u << 1)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_UTMI_CTRL5, 1u << 1, 1u << 1)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_COMMON0, 0x70u, 0u)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_COMMON1, 1u << 5, 1u << 5)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_REFCLK_CTRL, 0x3u, 0x2u)) return QPREP_DEADLINE;
+    /* Software VBUS: select the external source and drive it to 1. */
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_COMMON1, 1u << 4, 1u << 4)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_CTRL1, 1u << 0, 1u << 0)) return QPREP_DEADLINE;
+    /* qcom,param-override-seq = <0x04 0x70 0x2c 0x74>: value first, then offset. */
+    if (!prep_write(c, QUD_PHY_BASE + PHY_OVERRIDE_X1, 0x04u)) return QPREP_DEADLINE;
+    if (!prep_write(c, QUD_PHY_BASE + PHY_OVERRIDE_X2, 0x2cu)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_COMMON2, 1u << 0, 1u << 0)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_CTRL2, (1u << 3) | (1u << 2), (1u << 3) | (1u << 2))) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_UTMI_CTRL0, 1u << 0, 1u << 0)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_UTMI_CTRL5, 1u << 1, 0u)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_CTRL2, 1u << 3, 0u)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_CFG0, 1u << 1, 0u)) return QPREP_DEADLINE;
+    prep_delay(c, 5000);
+
+    /* D+ pulse (msm_hsphy_drive_dp_pulse): XCVRSEL lives at 0x40; 0x60 bit0 is
+     * VBUSVLDEXT0 and must not be touched here. */
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_CFG0, 0x3u, 0x3u)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_UTMI_CTRL0, 0x18u, 0x00u)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_UTMI_CTRL0, 1u << 5, 1u << 5)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_UTMI_CTRL1, 1u << 0, 1u << 0)) return QPREP_DEADLINE;
+    prep_delay(c, 200000 / 1000);
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_UTMI_CTRL0, 1u << 5, 0u)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_UTMI_CTRL1, 1u << 0, 0u)) return QPREP_DEADLINE;
+    if (!prep_mask(c, QUD_PHY_BASE + PHY_CFG0, 0x3u, 0u)) return QPREP_DEADLINE;
+
+    /* VBUS select + override must both still read back as 1. */
+    if (!prep_read(c, QUD_PHY_BASE + PHY_COMMON1, &value)) return QPREP_DEADLINE;
+    if (!(value & (1u << 4))) return QPREP_PHY;
+    if (!prep_read(c, QUD_PHY_BASE + PHY_CTRL1, &value)) return QPREP_DEADLINE;
+    if (!(value & 1u)) return QPREP_PHY;
+    /* The core's QSCRATCH VBUS bit is a second, independent assertion. */
+    if (!prep_mask(c, QUD_DWC3_BASE + QUD_QSCRATCH_HS_PHY_CTRL_OFFSET,
+                   QUD_QSCRATCH_VBUS_MASK, QUD_QSCRATCH_VBUS_MASK)) return QPREP_DEADLINE;
+    (void)i;
+    return QPREP_OK;
+}
+
+/* The core latches CORESOFTRESET: software has to clear it, exactly as Linux
+ * dwc3_core_init() does. The board read GCTL back as 0x00102800 after a 20 ms
+ * poll (2026-10-26), i.e. the bit never fell on its own. */
+static QCOM_PREPARE_RESULT
+prep_core_reset(struct prep *c)
+{
+    uint32_t value;
+    unsigned int i;
+
+    if (!prep_read(c, QUD_DWC3_BASE + DWC3_GCTL, &value)) return QPREP_DEADLINE;
+    if (!prep_write(c, QUD_DWC3_BASE + DWC3_GCTL, value | GCTL_CORESOFTRESET)) return QPREP_DEADLINE;
+    /* Observing the bit set is best effort: a fast core may finish first. */
+    for (i = 0; i < 20u; ++i) {
+        if (!prep_read(c, QUD_DWC3_BASE + DWC3_GCTL, &value)) return QPREP_DEADLINE;
+        if (value & GCTL_CORESOFTRESET) break;
+        prep_delay(c, 100);
+    }
+    if (!prep_write(c, QUD_DWC3_BASE + DWC3_GCTL,
+                    value & ~GCTL_CORESOFTRESET)) return QPREP_DEADLINE;
+    for (i = 0; i < 200u; ++i) {
+        if (!prep_read(c, QUD_DWC3_BASE + DWC3_GCTL, &value)) return QPREP_DEADLINE;
+        if (!(value & GCTL_CORESOFTRESET)) return QPREP_OK;
+        prep_delay(c, 100);
+    }
+    return QPREP_CORE;
+}
+
+/* Core: soft reset, device mode, HS speed, RUN.
+ *
+ * Acceptance reads GSTS, not GCTL: GCTL is a control register and reads back
+ * whatever was written, so it cannot prove the core switched. The reset is
+ * cleared and verified first, otherwise a core still held in reset can report
+ * CURMOD = 0 and pass by accident. */
+static QCOM_PREPARE_RESULT
+prep_core(struct prep *c)
+{
+    QCOM_PREPARE_RESULT result;
+    uint32_t value;
+    unsigned int i;
+
+    result = prep_core_reset(c);
+    if (result != QPREP_OK) return result;
+
+    if (!prep_write(c, QUD_DWC3_BASE + DWC3_GCTL,
+                    GCTL_PRTCAP_DEVICE | GCTL_DSBLCLKGTNG)) return QPREP_DEADLINE;
+    for (i = 0; i < CORE_MODE_SETTLE_STEPS; ++i) {
+        prep_delay(c, CORE_MODE_SETTLE_STEP_US);
+    }
+    if (!prep_read(c, QUD_DWC3_BASE + DWC3_GSTS, &value)) return QPREP_DEADLINE;
+    if ((value & GSTS_CURMOD) != GSTS_CURMOD_DEVICE) return QPREP_CORE;
+
+    /* High-speed-only port: a live SS pipe makes the core negotiate a
+     * SuperSpeed link that has no lane, and the host sees nothing. */
+    if (!prep_mask(c, QUD_DWC3_BASE + DWC3_GUSB3PIPECTL0,
+                   GUSB3PIPECTL_SUSPHY, GUSB3PIPECTL_SUSPHY)) return QPREP_DEADLINE;
+
+    /* PHY soft reset pulse with sleep mode and LPM suspend released. */
+    if (!prep_mask(c, QUD_DWC3_BASE + DWC3_GUSB2PHYCFG0,
+                   GUSB2PHYCFG_PHYSOFTRST | GUSB2PHYCFG_SUSPHY | GUSB2PHYCFG_ENBLSLPM,
+                   GUSB2PHYCFG_PHYSOFTRST)) return QPREP_DEADLINE;
+    prep_delay(c, 1000);
+    if (!prep_mask(c, QUD_DWC3_BASE + DWC3_GUSB2PHYCFG0,
+                   GUSB2PHYCFG_PHYSOFTRST, 0u)) return QPREP_DEADLINE;
+
+    if (!prep_write(c, QUD_DWC3_BASE + DWC3_DCFG, DCFG_DEVSPD_HS)) return QPREP_DEADLINE;
+
+    /* Same latched behaviour on the device-controller reset. */
+    if (!prep_mask(c, QUD_DWC3_BASE + DWC3_DCTL, DCTL_CSFTRST, DCTL_CSFTRST)) return QPREP_DEADLINE;
+    prep_delay(c, 1000);
+    if (!prep_mask(c, QUD_DWC3_BASE + DWC3_DCTL, DCTL_CSFTRST, 0u)) return QPREP_DEADLINE;
+    for (i = 0; i < 200u; ++i) {
+        if (!prep_read(c, QUD_DWC3_BASE + DWC3_DCTL, &value)) return QPREP_DEADLINE;
+        if (!(value & DCTL_CSFTRST)) break;
+        prep_delay(c, 100);
+    }
+    if (value & DCTL_CSFTRST) return QPREP_CORE;
+
+    if (!prep_mask(c, QUD_DWC3_BASE + DWC3_DCTL, DCTL_RUN_STOP, DCTL_RUN_STOP)) return QPREP_DEADLINE;
+
+    /* The core must leave halt. Connect speed is recorded, not gated: the host
+     * has not reset the port yet, so CONNECTSPD still holds the previous
+     * connection's value and gating on it would fail a healthy core. */
+    for (i = 0; i < 200u; ++i) {
+        if (!prep_read(c, QUD_DWC3_BASE + DWC3_DSTS, &value)) return QPREP_DEADLINE;
+        if (!(value & DSTS_DEVCTRLHLT)) return QPREP_OK;
+        prep_delay(c, 100);
+    }
+    return QPREP_CORE;
+}
+
+QCOM_PREPARE_RESULT
+QcomUsbPrepare(const QCOM_PREPARE_PLATFORM *platform, uint32_t *failed_stage,
+               uint32_t *last_readback)
+{
+    struct prep c;
+    QCOM_PREPARE_RESULT result;
+
+    if (failed_stage) *failed_stage = QPREP_STAGE_START;
+    if (last_readback) *last_readback = 0;
+    if (!platform || !platform->read32 || !platform->write32 || !QUD_PHY_BASE) {
+        return QPREP_ARG;
+    }
+    c.p = platform;
+    c.last = last_readback;
+
+    if (failed_stage) *failed_stage = QPREP_STAGE_CLOCKS;
+    result = prep_power(&c);
+    if (result == QPREP_OK) result = prep_clocks(&c);
+    if (result == QPREP_OK) result = prep_reset(&c);
+    if (result != QPREP_OK) return result;
+
+    if (failed_stage) *failed_stage = QPREP_STAGE_ID;
+    result = prep_identity(&c);
+    if (result != QPREP_OK) return result;
+
+    if (failed_stage) *failed_stage = QPREP_STAGE_PHY;
+    result = prep_phy(&c);
+    if (result != QPREP_OK) return result;
+
+    if (failed_stage) *failed_stage = QPREP_STAGE_CORE;
+    return prep_core(&c);
+}
diff --git a/bsd/dev/qcomusb/soc/QcomUsbQualify.c b/bsd/dev/qcomusb/soc/QcomUsbQualify.c
new file mode 100644
index 0000000..4cfa7f5
--- /dev/null
+++ b/bsd/dev/qcomusb/soc/QcomUsbQualify.c
@@ -0,0 +1,505 @@
+/* SPDX-License-Identifier: MIT */
+#include "QcomUsbQualify.h"
+
+static void clear_bytes(void *pointer, unsigned int size)
+{
+  unsigned char *bytes = (unsigned char *)pointer;
+  while (size--) *bytes++ = 0;
+}
+
+static int supported_dwc3(QUSB_U32 id)
+{
+  /* Pinned kernel core.h: DWC3_IP=0x5533, DWC31_IP=0x3331. USB 3.2 and
+   * DWC4 are not qualified by the current portable core backend.
+   */
+  return (id & 0xffff0000U) == 0x55330000U ||
+         (id & 0xffff0000U) == 0x33310000U;
+}
+
+QUSB_RESULT QcomUsbInspectInherited(QUSB_READ32 read32, void *cookie,
+                                   QUSB_INHERITED *state)
+{
+  static const QUSB_U32 cbcr[] = QUD_GCC_CBCR_OFFSETS;
+  unsigned int i;
+  if (!read32 || !state) return QusbBadArgument;
+  clear_bytes(state, sizeof(*state));
+  for (i = 0; i < 5; ++i) {
+    if (!QUD_OFFSET_OK(cbcr[i], QUD_GCC_BYTES)) return QusbBadArgument;
+    if (!read32(cookie, QUSB_GCC_BASE + cbcr[i], &state->gcc_cbcr[i]))
+      return QusbReadFailed;
+  }
+  if (!read32(cookie, QUSB_GCC_BASE + QUD_GCC_BCR_OFFSET, &state->gcc_bcr))
+    return QusbReadFailed;
+  if (!read32(cookie, QUSB_GCC_BASE + QUD_GCC_GDSCR_OFFSET, &state->gcc_gdscr))
+    return QusbReadFailed;
+  if (!read32(cookie, QUSB_GCC_BASE + QUD_GCC_CFG_GDSCR_OFFSET, &state->gcc_cfg_gdscr))
+    return QusbReadFailed;
+#if QUD_GDSC_LEGACY_PWR_ON
+  /* No qcom,support-cfg-gdscr on this block: PWR_ON is GDSCR bit31 and it is
+   * stable once SW_COLLAPSE (bit0) has been cleared by the firmware. */
+  if (!(state->gcc_gdscr & (1U << 31))) return QusbPowerDomainOff;
+#else
+  /* Live GDSC has qcom,support-cfg-gdscr. Its driver checks CFG_GDSCR
+   * POWER_UP_COMPLETE bit16, not legacy GDSCR.PWR_ON bit31.
+   */
+  if (!(state->gcc_cfg_gdscr & (1U << 16))) return QusbPowerDomainOff;
+#endif
+  if (state->gcc_bcr & 1U) return QusbResetAsserted;
+  /* CLK_OFF is bit 31 for clk_branch2. A voted clock can be running even
+   * when this CPU's enable bit is zero, hence do not require enable bit 0.
+   */
+  for (i = 0; i < 5; ++i)
+    if (state->gcc_cbcr[i] & 0x80000000U) return QusbClockOff;
+  if (!read32(cookie, QUSB_DWC3_BASE + 0xc120, &state->gsnpsid))
+    return QusbReadFailed;
+  if (!supported_dwc3(state->gsnpsid))
+    return QusbUnknownDwc3;
+  if (!read32(cookie, QUSB_DWC3_BASE + 0xc110, &state->gctl) ||
+      !read32(cookie, QUSB_DWC3_BASE + 0xc200, &state->gusb2phycfg) ||
+      !read32(cookie, QUSB_DWC3_BASE + 0xc700, &state->dcfg) ||
+      !read32(cookie, QUSB_DWC3_BASE + 0xc704, &state->dctl) ||
+      !read32(cookie, QUSB_DWC3_BASE + 0xc70c, &state->dsts))
+    return QusbReadFailed;
+  return QusbQualified;
+}
+
+QUSB_RESULT QcomUsbQualifyIdentityDma(QUSB_READ32 read32, void *cookie,
+                                    QUSB_SMMU_STATE *state)
+{
+  QUSB_U32 i, smr, s2cr, mask, id, type, page_shift, num_pages, cb, extended;
+  QUSB_U64 cb_offset;
+  QUSB_U32 low, high;
+  if (!read32 || !state) return QusbBadArgument;
+  clear_bytes(state, sizeof(*state));
+  state->index = 0xffffffffU;
+  if (!read32(cookie, QUSB_SMMU_BASE + 0x20, &state->id0) ||
+      !read32(cookie, QUSB_SMMU_BASE + 0x24, &state->id1) ||
+      !read32(cookie, QUSB_SMMU_BASE + 0x3c, &state->id7) ||
+      !read32(cookie, QUSB_SMMU_BASE, &state->scr0))
+    return QusbReadFailed;
+  /* This backend implements SMMUv2 stream matching, not indexing. No ID
+   * probing by temporary register writes.
+   */
+  /* ID7.MAJOR is the implementation revision (e.g. MMU-500 r2), not the
+   * architecture version. The known qcom,qsmmu-v500 platform supplies the
+   * SMMUv2 layout. Reject inaccessible/implausible ID registers rather than
+   * falsely requiring implementation revision 2.
+   */
+  if (!(state->id0 & 0x60000000U) || !(state->id1 & 255U) ||
+      (state->id1 & 255U) > 128U || (state->id0 & 255U) > 128U)
+    return QusbUnknownSmmu;
+  state->extended_stream_ids = (state->scr0 >> 3) & 1U;
+  /* Arm IHI0062D.c 2.3.5: CLIENTPD bypasses the Stream mapping table and
+   * address translation for the corresponding Security state. USFCFG only
+   * affects unmatched streams when CLIENTPD=0. Reading the non-secure CR0
+   * view for non-secure USB DMA is an explicit platform precondition.
+   */
+  if (state->scr0 & 1U) {
+    state->mode = QusbDmaInheritedGlobalBypass;
+    return QusbQualified;
+  }
+  if (!(state->id0 & (1U << 27))) return QusbUnknownSmmu;
+  extended = state->extended_stream_ids;
+  if (extended && !(state->id0 & (1U << 8))) return QusbExtendedStreamIds;
+  state->extended_stream_ids = extended;
+  state->stream_count = state->id0 & 255U;
+  if (!state->stream_count) return QusbUnknownSmmu;
+  for (i = 0; i < state->stream_count; ++i) {
+    if (!read32(cookie, QUSB_SMMU_BASE + 0x800 + 4U * i, &smr))
+      return QusbReadFailed;
+    if (extended) {
+      /* EXIDENABLE moves validity out of SMR[31] into S2CR[10]. The SMR
+       * then has a full 16-bit mask and ID. In particular SMR[31] is mask
+       * bit15, and cannot be interpreted as a legacy validity bit.
+       */
+      if (!read32(cookie, QUSB_SMMU_BASE + 0xc00 + 4U * i, &s2cr))
+        return QusbReadFailed;
+      if (!(s2cr & (1U << 10))) continue;
+      mask = smr >> 16;
+      id = smr & 0xffffU;
+    } else {
+      if (!(smr & 0x80000000U)) continue;
+      mask = (smr >> 16) & 0x7fffU;
+      id = smr & 0x7fffU;
+    }
+    if ((QUSB_STREAM_ID & ~mask) != (id & ~mask)) continue;
+    if (!extended && !read32(cookie, QUSB_SMMU_BASE + 0xc00 + 4U * i, &s2cr))
+      return QusbReadFailed;
+    ++state->match_count;
+    state->index = i;
+    state->smr = smr;
+    state->s2cr = s2cr;
+    state->stream_id = id;
+    state->stream_mask = mask;
+  }
+  if (!state->match_count) {
+    /* IHI0062D.c 2.3.5/2.3.6: a proven unmatched non-secure stream bypasses
+     * when NS CR0.USFCFG=0. No stream/global mutation or lease is needed.
+     */
+    if (!(state->scr0 & (1U << 10))) {
+      state->mode = QusbDmaInheritedUnmatchedBypass;
+      return QusbQualified;
+    }
+    return QusbNoExplicitStream;
+  }
+  if (state->match_count != 1U) return QusbMultipleStreams;
+  type = (state->s2cr >> 16) & 3U;
+  if (type == 1U) {
+    state->mode = state->stream_mask ? QusbDmaInheritedSharedStreamBypass :
+                                      QusbDmaExactStreamBypass;
+    return QusbQualified;
+  }
+  if (type == 2U) return QusbStreamFaulting;
+  if (type != 0U) return QusbUnsupportedStreamType;
+  if (state->stream_mask) return QusbSharedStream;
+
+  /* Read-only diagnostics for a translated stream. Never dereference its
+   * page tables, change its context or pretend a fresh DMA allocation is
+   * covered by the old bootloader IOVA mapping.
+   */
+  cb = state->s2cr & 255U;
+  state->context_bank = cb;
+  page_shift = (state->id1 & 0x80000000U) ? 16U : 12U;
+  num_pages = 2U << ((state->id1 >> 28) & 7U);
+  cb_offset = ((QUSB_U64)num_pages + cb) << page_shift;
+  if (cb >= (state->id1 & 255U) || cb_offset + 0x34U > QUSB_SMMU_BYTES)
+    return QusbUnknownSmmu;
+  if (!read32(cookie, QUSB_SMMU_BASE + cb_offset, &state->context_sctlr) ||
+      !read32(cookie, QUSB_SMMU_BASE + ((QUSB_U64)1U << page_shift) + 4U * cb,
+              &state->context_cbar) ||
+      !read32(cookie, QUSB_SMMU_BASE + cb_offset + 0x30, &state->context_tcr) ||
+      !read32(cookie, QUSB_SMMU_BASE + cb_offset + 0x20, &low) ||
+      !read32(cookie, QUSB_SMMU_BASE + cb_offset + 0x24, &high))
+    return QusbReadFailed;
+  state->context_ttbr0 = ((QUSB_U64)high << 32) | low;
+  return QusbStreamTranslated;
+}
+
+static QUSB_RESULT core_halted(QUSB_READ32 read32, void *cookie)
+{
+  QUSB_U32 id, control, status, global_control;
+  if (!read32(cookie, QUSB_DWC3_BASE + 0xc120, &id) ||
+      !read32(cookie, QUSB_DWC3_BASE + 0xc110, &global_control) ||
+      !read32(cookie, QUSB_DWC3_BASE + 0xc704, &control) ||
+      !read32(cookie, QUSB_DWC3_BASE + 0xc70c, &status))
+    return QusbReadFailed;
+  if (!supported_dwc3(id)) return QusbUnknownDwc3;
+  /* Device-side halted does not qualify an active host/OTG DMA engine. */
+  if (((global_control >> 12) & 3U) != 2U) return QusbWrongCoreRole;
+  if ((control & (1U << 31)) || !(status & (1U << 22)))
+    return QusbCoreRunning;
+  return QusbQualified;
+}
+
+static int valid_lease(const QUSB_DMA_LEASE *lease)
+{
+  if (!lease || lease->active != 1U || lease->new_entry > 1U ||
+      !lease->stream_count || lease->stream_count > 128U ||
+      lease->index >= lease->stream_count || lease->extended_stream_ids > 1U ||
+      lease->smr != (lease->extended_stream_ids ? QUSB_STREAM_ID :
+                                                (0x80000000U | QUSB_STREAM_ID)) ||
+      (lease->original_cr0 & 9U) != (lease->extended_stream_ids << 3)) return 0;
+  if (lease->new_entry) {
+    if (lease->bypass_s2cr != (lease->extended_stream_ids ? 0x10700U : 0x10300U) ||
+        !(lease->original_cr0 & (1U << 10))) return 0;
+    if (lease->extended_stream_ids)
+      return !(lease->original_s2cr & (1U << 10));
+    return !(lease->original_smr & 0x80000000U);
+  }
+  return lease->original_smr == lease->smr &&
+         (!lease->extended_stream_ids || (lease->original_s2cr & (1U << 10))) &&
+         ((lease->original_s2cr >> 16) & 3U) == 0U &&
+         lease->bypass_s2cr == ((lease->original_s2cr & ~(3U << 16)) | (1U << 16));
+}
+
+int QcomUsbDmaWriteAllowed(const QUSB_DMA_LEASE *lease,
+                           QUSB_U64 address, QUSB_U32 value)
+{
+  QUSB_U64 smr_address, s2cr_address;
+  if (!valid_lease(lease)) return 0;
+  smr_address = QUSB_SMMU_BASE + 0x800 + 4U * lease->index;
+  s2cr_address = QUSB_SMMU_BASE + 0xc00 + 4U * lease->index;
+  if (!lease->new_entry) {
+    if (lease->phase == QusbLeaseExistingCommit)
+      return address == s2cr_address && value == lease->bypass_s2cr;
+    if (lease->phase == QusbLeaseExistingRestore)
+      return address == s2cr_address && value == lease->original_s2cr;
+    return 0;
+  }
+  switch (lease->phase) {
+    case QusbLeasePrepareS2cr: return address == s2cr_address && value == 0x10300U;
+    case QusbLeasePrepareSmr: return address == smr_address && value == QUSB_STREAM_ID;
+    case QusbLeaseCommit:
+      return lease->extended_stream_ids ? address == s2cr_address && value == 0x10700U :
+                                         address == smr_address && value == lease->smr;
+    case QusbLeaseInvalidate:
+      return lease->extended_stream_ids ? address == s2cr_address && value == 0x10300U :
+                                         address == smr_address && value == QUSB_STREAM_ID;
+    case QusbLeaseRestoreFirst:
+      return lease->extended_stream_ids ? address == smr_address && value == lease->original_smr :
+                                         address == s2cr_address && value == lease->original_s2cr;
+    case QusbLeaseRestoreLast:
+      return lease->extended_stream_ids ? address == s2cr_address && value == lease->original_s2cr :
+                                         address == smr_address && value == lease->original_smr;
+    default: return 0;
+  }
+}
+
+static QUSB_RESULT lease_write(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                               QUSB_BARRIER barrier, void *cookie,
+                               QUSB_DMA_LEASE *lease, QUSB_U32 phase,
+                               QUSB_U64 address, QUSB_U32 value)
+{
+  QUSB_U32 check, cr0_mask = lease->new_entry ? 0x409U : 9U;
+  int written;
+  lease->phase = phase; /* A failed write may have committed: retain the phase. */
+  if (!QcomUsbDmaWriteAllowed(lease, address, value)) return QusbBadArgument;
+  if (!read32(cookie, QUSB_SMMU_BASE, &check)) return QusbReadFailed;
+  if ((check & cr0_mask) != (lease->original_cr0 & cr0_mask)) return QusbOwnershipChanged;
+  barrier(cookie);
+  written = write32(cookie, address, value);
+  /* Even a callback-reported failure may have posted the MMIO write. */
+  barrier(cookie);
+  lease->readback = 0xffffffffU;
+  if (!written) return QusbWriteFailed;
+  if (!read32(cookie, address, &check)) return QusbReadFailed;
+  lease->readback = check;
+  return check == value ? QusbQualified : QusbWriteFailed;
+}
+
+static QUSB_RESULT new_usb_entry(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                                 QUSB_BARRIER barrier, void *cookie,
+                                 QUSB_DMA_LEASE *lease, QUSB_SMMU_STATE *state)
+{
+  QUSB_SMMU_STATE checked;
+  QUSB_RESULT result;
+  QUSB_U32 i, smr, s2cr, cr0, chosen = 0xffffffffU, old_smr = 0, old_s2cr = 0;
+  QUSB_U64 smr_address, s2cr_address;
+  result = QcomUsbQualifyIdentityDma(read32, cookie, &checked);
+  if (result != QusbNoExplicitStream || checked.stream_count != state->stream_count ||
+      (checked.scr0 & 0x409U) != (state->scr0 & 0x409U)) return QusbOwnershipChanged;
+  for (i = 0; i < checked.stream_count; ++i) {
+    if (!read32(cookie, QUSB_SMMU_BASE + 0x800 + 4U * i, &smr) ||
+        !read32(cookie, QUSB_SMMU_BASE + 0xc00 + 4U * i, &s2cr)) return QusbReadFailed;
+    if (checked.extended_stream_ids ? (s2cr & (1U << 10)) : (smr & 0x80000000U)) continue;
+    chosen = i; old_smr = smr; old_s2cr = s2cr; break;
+  }
+  if (chosen == 0xffffffffU) return QusbNoFreeStream;
+  smr_address = QUSB_SMMU_BASE + 0x800 + 4U * chosen;
+  s2cr_address = QUSB_SMMU_BASE + 0xc00 + 4U * chosen;
+  if (!read32(cookie, QUSB_SMMU_BASE, &cr0) ||
+      !read32(cookie, smr_address, &smr) || !read32(cookie, s2cr_address, &s2cr))
+    return QusbReadFailed;
+  if ((cr0 & 0x409U) != (checked.scr0 & 0x409U) || smr != old_smr || s2cr != old_s2cr)
+    return QusbOwnershipChanged;
+  lease->index = chosen;
+  lease->extended_stream_ids = checked.extended_stream_ids;
+  lease->original_cr0 = checked.scr0;
+  lease->original_smr = old_smr;
+  lease->original_s2cr = old_s2cr;
+  lease->stream_count = checked.stream_count;
+  lease->smr = checked.extended_stream_ids ? QUSB_STREAM_ID : (0x80000000U | QUSB_STREAM_ID);
+  /* Linux arm_smmu_write_s2cr: BYPASS, default privilege, non-shareable.
+   * Configure validity last rather than enabling an old invalid SMR's SID.
+   */
+  lease->bypass_s2cr = checked.extended_stream_ids ? 0x10700U : 0x10300U;
+  lease->new_entry = 1U;
+  lease->active = 1U;
+  result = lease_write(read32, write32, barrier, cookie, lease, QusbLeasePrepareS2cr,
+                       s2cr_address, 0x10300U);
+  if (result != QusbQualified) return result;
+  result = lease_write(read32, write32, barrier, cookie, lease, QusbLeasePrepareSmr,
+                       smr_address, QUSB_STREAM_ID);
+  if (result != QusbQualified) return result;
+  /* Both encodings are still invalid here. Rescan for a competing mapping
+   * before the single validity commit. No unrelated entry is ever changed.
+   */
+  result = QcomUsbQualifyIdentityDma(read32, cookie, &checked);
+  if (result != QusbNoExplicitStream || (checked.scr0 & 0x409U) != (lease->original_cr0 & 0x409U))
+    return QusbOwnershipChanged;
+  if (!read32(cookie, smr_address, &smr) || !read32(cookie, s2cr_address, &s2cr))
+    return QusbReadFailed;
+  if (smr != QUSB_STREAM_ID || s2cr != 0x10300U) return QusbOwnershipChanged;
+  result = lease_write(read32, write32, barrier, cookie, lease, QusbLeaseCommit,
+                       lease->extended_stream_ids ? s2cr_address : smr_address,
+                       lease->extended_stream_ids ? lease->bypass_s2cr : lease->smr);
+  if (result != QusbQualified) return result;
+  result = QcomUsbQualifyIdentityDma(read32, cookie, state);
+  if (result != QusbQualified || state->index != lease->index ||
+      state->match_count != 1U || state->smr != lease->smr ||
+      state->s2cr != lease->bypass_s2cr ||
+      (state->scr0 & 0x409U) != (lease->original_cr0 & 0x409U)) return QusbOwnershipChanged;
+  lease->phase = QusbLeaseComplete;
+  return QusbQualified;
+}
+
+QUSB_RESULT QcomUsbEnterIdentityDma(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                                   QUSB_BARRIER barrier, void *cookie,
+                                   QUSB_DMA_LEASE *lease,
+                                   QUSB_SMMU_STATE *state)
+{
+  QUSB_RESULT result;
+  QUSB_U32 check;
+  if (!read32 || !write32 || !barrier || !lease || !state || lease->active)
+    return QusbBadArgument;
+  clear_bytes(lease, sizeof(*lease));
+  result = QcomUsbQualifyIdentityDma(read32, cookie, state);
+  if (result != QusbQualified && result != QusbStreamTranslated && result != QusbNoExplicitStream)
+    return result;
+  if (result == QusbStreamTranslated &&
+      state->smr != (state->extended_stream_ids ? QUSB_STREAM_ID :
+                                               (0x80000000U | QUSB_STREAM_ID)))
+    return QusbUnknownSmmu;
+  {
+    QUSB_RESULT dma_result = result;
+    result = core_halted(read32, cookie);
+    if (result != QusbQualified) return result;
+    if (dma_result == QusbQualified) return QusbQualified;
+    if (dma_result == QusbNoExplicitStream)
+      return new_usb_entry(read32, write32, barrier, cookie, lease, state);
+  }
+  /* Recheck this mapping immediately before changing it. Platform ownership
+   * and disabled competing callbacks must be established by the caller.
+   */
+  if (!read32(cookie, QUSB_SMMU_BASE + 0x800 + 4U * state->index, &check))
+    return QusbReadFailed;
+  if (check != state->smr) return QusbOwnershipChanged;
+  if (!read32(cookie, QUSB_SMMU_BASE + 0xc00 + 4U * state->index, &check))
+    return QusbReadFailed;
+  if (check != state->s2cr) return QusbOwnershipChanged;
+  if (!read32(cookie, QUSB_SMMU_BASE, &check)) return QusbReadFailed;
+  if ((check & 9U) != (state->scr0 & 9U)) return QusbOwnershipChanged;
+  lease->index = state->index;
+  lease->smr = state->smr;
+  lease->original_s2cr = state->s2cr;
+  lease->bypass_s2cr = (state->s2cr & ~(3U << 16)) | (1U << 16);
+  lease->extended_stream_ids = state->extended_stream_ids;
+  lease->original_cr0 = state->scr0;
+  lease->original_smr = state->smr;
+  lease->stream_count = state->stream_count;
+  lease->active = 1U; /* A failed bus write can still have had a side effect. */
+  result = lease_write(read32, write32, barrier, cookie, lease, QusbLeaseExistingCommit,
+                       QUSB_SMMU_BASE + 0xc00 + 4U * lease->index, lease->bypass_s2cr);
+  if (result != QusbQualified) return result;
+  result = QcomUsbQualifyIdentityDma(read32, cookie, state);
+  if ((state->scr0 & 9U) != (lease->original_cr0 & 9U)) return QusbOwnershipChanged;
+  if (result == QusbQualified && (state->index != lease->index || state->match_count != 1U ||
+      state->smr != lease->smr || state->s2cr != lease->bypass_s2cr)) return QusbOwnershipChanged;
+  if (result == QusbQualified) lease->phase = QusbLeaseComplete;
+  return result;
+}
+
+static int owned_new_pair(const QUSB_DMA_LEASE *lease, QUSB_U32 smr, QUSB_U32 s2cr)
+{
+  if (smr == lease->original_smr && s2cr == lease->original_s2cr) return 1;
+  switch (lease->phase) {
+    case QusbLeasePrepareS2cr:
+      return smr == lease->original_smr && s2cr == 0x10300U;
+    case QusbLeasePrepareSmr:
+      return (smr == lease->original_smr || smr == QUSB_STREAM_ID) && s2cr == 0x10300U;
+    case QusbLeaseCommit:
+    case QusbLeaseInvalidate:
+      return (smr == QUSB_STREAM_ID && s2cr == 0x10300U) ||
+             (smr == lease->smr && s2cr == lease->bypass_s2cr);
+    case QusbLeaseComplete:
+      return smr == lease->smr && s2cr == lease->bypass_s2cr;
+    case QusbLeaseRestoreFirst:
+      return lease->extended_stream_ids ?
+        (smr == QUSB_STREAM_ID || smr == lease->original_smr) && s2cr == 0x10300U :
+        (smr == QUSB_STREAM_ID || smr == lease->original_smr) &&
+          (s2cr == 0x10300U || s2cr == lease->original_s2cr);
+    case QusbLeaseRestoreLast:
+      return lease->extended_stream_ids ?
+        smr == lease->original_smr && (s2cr == 0x10300U || s2cr == lease->original_s2cr) :
+        (smr == QUSB_STREAM_ID || smr == lease->original_smr) && s2cr == lease->original_s2cr;
+    default: return 0;
+  }
+}
+
+static QUSB_RESULT restore_new_entry(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                                     QUSB_BARRIER barrier, void *cookie,
+                                     QUSB_DMA_LEASE *lease,
+                                     QUSB_U32 smr, QUSB_U32 s2cr)
+{
+  QUSB_U64 smr_address = QUSB_SMMU_BASE + 0x800 + 4U * lease->index;
+  QUSB_U64 s2cr_address = QUSB_SMMU_BASE + 0xc00 + 4U * lease->index;
+  QUSB_RESULT result;
+  if (!owned_new_pair(lease, smr, s2cr)) return QusbOwnershipChanged;
+  if (smr == lease->original_smr && s2cr == lease->original_s2cr) {
+    lease->active = 0; lease->phase = QusbLeaseRestored; return QusbQualified;
+  }
+  /* Clear the active validity bit before restoring any old invalid fields. */
+  if (lease->extended_stream_ids ? (s2cr & (1U << 10)) : (smr & 0x80000000U)) {
+    result = lease_write(read32, write32, barrier, cookie, lease, QusbLeaseInvalidate,
+                         lease->extended_stream_ids ? s2cr_address : smr_address,
+                         lease->extended_stream_ids ? 0x10300U : QUSB_STREAM_ID);
+    if (result != QusbQualified) return result;
+  }
+  result = lease_write(read32, write32, barrier, cookie, lease, QusbLeaseRestoreFirst,
+                       lease->extended_stream_ids ? smr_address : s2cr_address,
+                       lease->extended_stream_ids ? lease->original_smr : lease->original_s2cr);
+  if (result != QusbQualified) return result;
+  result = lease_write(read32, write32, barrier, cookie, lease, QusbLeaseRestoreLast,
+                       lease->extended_stream_ids ? s2cr_address : smr_address,
+                       lease->extended_stream_ids ? lease->original_s2cr : lease->original_smr);
+  if (result != QusbQualified) return result;
+  if (!read32(cookie, smr_address, &smr) || !read32(cookie, s2cr_address, &s2cr))
+    return QusbReadFailed;
+  if (smr != lease->original_smr || s2cr != lease->original_s2cr) return QusbOwnershipChanged;
+  lease->active = 0; lease->phase = QusbLeaseRestored;
+  return QusbQualified;
+}
+
+QUSB_RESULT QcomUsbRestoreDma(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                             QUSB_BARRIER barrier, void *cookie,
+                             QUSB_DMA_LEASE *lease)
+{
+  QUSB_U32 smr, s2cr, cr0;
+  QUSB_RESULT result;
+  if (!read32 || !write32 || !barrier || !lease) return QusbBadArgument;
+  if (!lease->active) return QusbQualified;
+  if (!valid_lease(lease)) return QusbBadArgument;
+  result = core_halted(read32, cookie);
+  if (result != QusbQualified) return result;
+  if (!read32(cookie, QUSB_SMMU_BASE, &cr0) ||
+      !read32(cookie, QUSB_SMMU_BASE + 0x800 + 4U * lease->index, &smr) ||
+      !read32(cookie, QUSB_SMMU_BASE + 0xc00 + 4U * lease->index, &s2cr))
+    return QusbReadFailed;
+  if ((cr0 & (lease->new_entry ? 0x409U : 9U)) !=
+      (lease->original_cr0 & (lease->new_entry ? 0x409U : 9U))) return QusbOwnershipChanged;
+  if (lease->new_entry)
+    return restore_new_entry(read32, write32, barrier, cookie, lease, smr, s2cr);
+  if (smr != lease->smr) return QusbOwnershipChanged;
+  if (s2cr == lease->original_s2cr) {
+    lease->active = 0;
+    return QusbQualified;
+  }
+  if (s2cr != lease->bypass_s2cr) return QusbOwnershipChanged;
+  result = lease_write(read32, write32, barrier, cookie, lease, QusbLeaseExistingRestore,
+                       QUSB_SMMU_BASE + 0xc00 + 4U * lease->index, lease->original_s2cr);
+  if (result != QusbQualified) return result;
+  if (!read32(cookie, QUSB_SMMU_BASE + 0xc00 + 4U * lease->index, &s2cr))
+    return QusbReadFailed;
+  if (s2cr != lease->original_s2cr) return QusbWriteFailed;
+  lease->active = 0;
+  lease->phase = QusbLeaseRestored;
+  return QusbQualified;
+}
+
+const char *QcomUsbResultName(QUSB_RESULT result)
+{
+  static const char *const names[] = {
+    "qualified", "bad argument", "MMIO read failed", "inherited clock off",
+    "USB reset asserted", "unknown DWC3 ID", "unknown SMMU layout",
+    "global SMMU disabled", "extended stream IDs unsupported",
+    "USB stream has no explicit mapping", "ambiguous USB stream mappings",
+    "USB stream mapping covers other SIDs", "USB stream is translated",
+    "USB stream faults", "unknown stream mapping type", "USB power domain off",
+    "USB core is not halted", "USB S2CR write failed", "USB ownership changed",
+    "USB core is not in device role", "USB power state requires a platform sequence",
+    "USB inherited parent clock is not ready", "USB branch is forced off",
+    "USB clock enable timed out", "no free USB stream entry"
+  };
+  if ((unsigned int)result >= sizeof(names) / sizeof(names[0])) return "unknown result";
+  return names[result];
+}
diff --git a/bsd/dev/qcomusb/soc/QcomUsbQualify.h b/bsd/dev/qcomusb/soc/QcomUsbQualify.h
new file mode 100644
index 0000000..1520a09
--- /dev/null
+++ b/bsd/dev/qcomusb/soc/QcomUsbQualify.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: MIT
+ * Read-only qualification and an optional exclusive USB stream DMA lease.
+ */
+#ifndef QCOM_USB_QUALIFY_H
+#define QCOM_USB_QUALIFY_H
+
+typedef unsigned int QUSB_U32;
+typedef unsigned long long QUSB_U64;
+typedef int (*QUSB_READ32)(void *cookie, QUSB_U64 address, QUSB_U32 *value);
+typedef int (*QUSB_WRITE32)(void *cookie, QUSB_U64 address, QUSB_U32 value);
+typedef void (*QUSB_BARRIER)(void *cookie); /* Must issue DSB SY on AArch64. */
+typedef void (*QUSB_DELAY_US)(void *cookie, QUSB_U32 microseconds);
+
+#include "../include/QcomUsbSoc.h"
+#define QUSB_GCC_BASE QUD_GCC_BASE
+#define QUSB_DWC3_BASE QUD_DWC3_BASE
+#define QUSB_SMMU_BASE QUD_SMMU_BASE
+#define QUSB_SMMU_BYTES QUD_SMMU_BYTES
+#define QUSB_STREAM_ID QUD_STREAM_ID
+
+typedef enum {
+  QusbQualified = 0,
+  QusbBadArgument,
+  QusbReadFailed,
+  QusbClockOff,
+  QusbResetAsserted,
+  QusbUnknownDwc3,
+  QusbUnknownSmmu,
+  QusbGlobalDisabled,
+  QusbExtendedStreamIds,
+  QusbNoExplicitStream,
+  QusbMultipleStreams,
+  QusbSharedStream,
+  QusbStreamTranslated,
+  QusbStreamFaulting,
+  QusbUnsupportedStreamType,
+  QusbPowerDomainOff,
+  QusbCoreRunning,
+  QusbWriteFailed,
+  QusbOwnershipChanged,
+  QusbWrongCoreRole,
+  QusbUnsafePowerState,
+  QusbParentClockNotReady,
+  QusbClockForcedOff,
+  QusbClockTimeout,
+  QusbNoFreeStream
+} QUSB_RESULT;
+
+typedef enum {
+  QusbDmaUnqualified = 0,
+  QusbDmaInheritedGlobalBypass,
+  QusbDmaExactStreamBypass,
+  QusbDmaInheritedUnmatchedBypass,
+  QusbDmaInheritedSharedStreamBypass
+} QUSB_DMA_MODE;
+
+typedef struct {
+  QUSB_U32 gcc_cbcr[5]; /* core, iface, aggregate, UTMI, sleep */
+  QUSB_U32 gcc_bcr, gcc_gdscr, gcc_cfg_gdscr;
+  QUSB_U32 gsnpsid, gctl, gusb2phycfg, dcfg, dctl, dsts;
+} QUSB_INHERITED;
+
+typedef struct {
+  QUSB_DMA_MODE mode;
+  QUSB_U32 id0, id1, id7, scr0;
+  QUSB_U32 stream_count, match_count, index, smr, s2cr;
+  QUSB_U32 extended_stream_ids, stream_id, stream_mask;
+  QUSB_U32 context_bank, context_sctlr, context_cbar, context_tcr;
+  QUSB_U64 context_ttbr0;
+} QUSB_SMMU_STATE;
+
+typedef struct {
+  QUSB_U32 active, index, smr, original_s2cr, bypass_s2cr;
+  QUSB_U32 extended_stream_ids, original_cr0;
+  QUSB_U32 new_entry, original_smr, stream_count, phase;
+  /* Last value read back from the pair slot during this lease; 0xffffffff
+   * means the write callback itself failed (no hardware access happened). */
+  QUSB_U32 readback;
+} QUSB_DMA_LEASE;
+
+enum {
+  QusbLeasePrepareS2cr = 1,
+  QusbLeasePrepareSmr = 2,
+  QusbLeaseCommit = 3,
+  QusbLeaseComplete = 4,
+  QusbLeaseInvalidate = 5,
+  QusbLeaseRestoreFirst = 6,
+  QusbLeaseRestoreLast = 7,
+  QusbLeaseRestored = 8,
+  QusbLeaseExistingCommit = 9,
+  QusbLeaseExistingRestore = 10
+};
+
+/* Pure callback policy: only the selected slot and the exact value for its
+ * current phase are writable. The helper separately verifies live ownership.
+ */
+int QcomUsbDmaWriteAllowed(const QUSB_DMA_LEASE *lease,
+                           QUSB_U64 address, QUSB_U32 value);
+
+typedef struct {
+  QUSB_U32 active_mask, original[5];
+  QUSB_U32 gdscr, cfg_gdscr, bcr, master_cmd, master_cfg, utmi_cmd, utmi_cfg, pll0_mode;
+  QUSB_U32 failed_index;
+} QUSB_CLOCK_LEASE;
+
+/* Optional branch-only resume. CFG_GDSCR.POWER_UP_COMPLETE must already be on,
+ * with SW_COLLAPSE/HW_CONTROL clear. No power-domain, parent RCG, PLL, reset,
+ * PMIC or rail writes. Only ENABLE bit0 of the five USB CBCRs can be changed.
+ * Caller must own USB, prevent competing clock/firmware callbacks, retain ABL
+ * DMA buffers until it can inspect/halt the core, and bound poll_us to 1..1000.
+ * A failure may leave active_mask set and needs RestoreClocks after all USB
+ * DMA is stopped and the SMMU lease has been restored.
+ */
+QUSB_RESULT QcomUsbResumeClocks(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                               QUSB_BARRIER barrier, QUSB_DELAY_US delay_us,
+                               void *cookie, QUSB_U32 poll_us,
+                               QUSB_CLOCK_LEASE *lease);
+QUSB_RESULT QcomUsbRestoreClocks(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                                QUSB_BARRIER barrier, void *cookie,
+                                QUSB_CLOCK_LEASE *lease);
+
+/* GCC must be mapped as device memory. No clock/reset/PHY changes are made.
+ * Checks the five live-DT named clocks before reading DWC3. A successful result
+ * shows register accessibility; it does not prove the eUSB2 PHY is trained.
+ */
+QUSB_RESULT QcomUsbInspectInherited(QUSB_READ32 read32, void *cookie,
+                                   QUSB_INHERITED *state);
+
+/* The live-validated qcom,qsmmu-v500 SMMUv2 layout, non-secure register-view
+ * and non-secure USB DMA are platform preconditions.
+ * Only QusbQualified authorizes physical-address DMA: an existing CLIENTPD=1
+ * globally bypasses translation, an unmatched stream bypasses by USFCFG=0,
+ * or one valid matching SMR selects BYPASS (shared masks are read-only).
+ * mode distinguishes these cases. Inherited global bypass requires no SMR
+ * reads or writes. Translated state is reported, never modified by this
+ * function, and must not be treated as an identity mapping.
+ */
+QUSB_RESULT QcomUsbQualifyIdentityDma(QUSB_READ32 read32, void *cookie,
+                                    QUSB_SMMU_STATE *state);
+
+/* OPTIONAL mutation, separate from read-only inspection. Requires a known
+ * DWC3 in DEVICE role, RUN_STOP clear and DEVCTRLHLT set. A unique exact
+ * translated SID0x40 can acquire a TYPE-only bypass lease. If the complete
+ * table has no SID0x40 match and USFCFG=1, one invalid slot can instead be
+ * leased for exact SID0x40: configure invalid S2CR/SMR, commit validity last.
+ * Only that chosen pair is touched; no context/page-table, global control,
+ * TLB, clock, power or other stream writes occur.
+ * Caller must stop all USB DMA, own the USB core exclusively and keep the
+ * lease until QcomUsbRestoreDma completes. A nonzero lease.active after any
+ * error requires restoration before another owner touches USB.
+ */
+QUSB_RESULT QcomUsbEnterIdentityDma(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                                   QUSB_BARRIER barrier, void *cookie,
+                                   QUSB_DMA_LEASE *lease,
+                                   QUSB_SMMU_STATE *state);
+QUSB_RESULT QcomUsbRestoreDma(QUSB_READ32 read32, QUSB_WRITE32 write32,
+                             QUSB_BARRIER barrier, void *cookie,
+                             QUSB_DMA_LEASE *lease);
+const char *QcomUsbResultName(QUSB_RESULT result);
+
+#endif
diff --git a/bsd/dev/qcomusb/soc/Sm8850.h b/bsd/dev/qcomusb/soc/Sm8850.h
new file mode 100644
index 0000000..ea75159
--- /dev/null
+++ b/bsd/dev/qcomusb/soc/Sm8850.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: MIT
+ * SM8850 (Xiaomi 17 Pro, pandora) GCC + APPS SMMU + DWC3 profile for Data A Live.
+ *
+ * Sources:
+ *   DT     device/pandora-live.dts: ssusb@a600000 (qcom,dwc-usb3-msm; dwc3@a600000 iommus
+ *          <&apps_smmu 0x40 0>; five clocks core/iface/bus_aggr/utmi/sleep, reset, power domain),
+ *          apps-smmu@15000000 (qcom,qsmmu-v500), clock-controller@100000 (qcom,canoe-gcc)
+ *   GCC    mainline drivers/clk/qcom/gcc-kaanapali.c (offsets by clock name; the DT's clock ids
+ *          are Android's own numbering)
+ *   board  device/logs/usb1.txt (k0248, pandora_usb=1, after `fastboot boot`): all five CBCRs
+ *          0x08000001 (on), BCR 0, GDSCR 0xfa22f800 (PWR_ON, SW_COLLAPSE and HW_CONTROL clear),
+ *          CFG_GDSCR 0x04070000 (POWER_UP_COMPLETE); DWC3 GSNPSID 0x33313130, GCTL 0x00102005
+ *          (device role), DCTL RUN_STOP clear, DSTS DEVCTRLHLT set
+ *   SMMU   device/logs/spk6.txt (the audio survey): stream 0x40 is group 3 -> bank 3, S2CR
+ *          type translate, bank 3 SCTLR 0x000000e0 (M clear), CBAR 0x0001f000
+ *          (S1_TRANS_S2_BYPASS), CBA2R 1; a TYPE=BYPASS S2CR reads back as FAULT here too
+ */
+#ifndef QUD_SM8850_H
+#define QUD_SM8850_H
+
+#define QUD_SOC_NAME "sm8850-pandora"
+
+/* Development IDs inherited from m1n1 through the module, not a product allocation. */
+#define QUD_USB_VID 0x1209u
+#define QUD_USB_PID 0x316du
+#define QUD_USB_SERIAL "QcomXnuUsbDebug"
+#define QUD_USB_PRODUCT "Qualcomm XNU Debug"
+
+#define QUD_GCC_BASE 0x00100000ULL
+#define QUD_GCC_BYTES 0x40000u
+#define QUD_DWC3_BASE 0x0a600000ULL           /* DT core_base <0xa600000 0x100000> */
+#define QUD_DWC3_BYTES 0x100000u
+#define QUD_SMMU_BASE 0x15000000ULL
+#define QUD_SMMU_BYTES 0x100000ULL
+#define QUD_STREAM_ID 0x40u
+
+/* gcc-kaanapali.c clk_branch halt_reg of the DT's clocks, in the module's order core, iface,
+ * aggregate, UTMI, sleep: usb30_prim_master, cfg_noc_usb3_prim_axi, aggre_usb3_prim_axi,
+ * usb30_prim_mock_utmi, usb30_prim_sleep. */
+#define QUD_GCC_CBCR_OFFSETS {0x39018u, 0x39090u, 0x39094u, 0x3902cu, 0x39028u}
+#define QUD_GCC_BCR_OFFSET 0x39000u           /* GCC_USB30_PRIM_BCR */
+#define QUD_GCC_GDSCR_OFFSET 0x39004u         /* usb30_prim_gdsc */
+#define QUD_GCC_CFG_GDSCR_OFFSET 0x39008u     /* gdscr + 4: POWER_UP_COMPLETE bit 16 */
+
+/* dwc3-msm QSCRATCH at 0xf8800: HS_PHY_CTRL's software VBUS valid (20) and session valid
+ * select (28), as on SM8550. */
+#define QUD_QSCRATCH_HS_PHY_CTRL_OFFSET 0xf8810u
+#define QUD_QSCRATCH_VBUS_MASK ((1u << 20) | (1u << 28))
+
+/* The bootloader already routes stream 0x40 to bank 3 with translation off, and this firmware
+ * turns a TYPE=BYPASS S2CR into FAULT: take the bypass-bank route (soc/QcomUsbBypass.c), DMA at
+ * physical addresses. The private-domain IOVA below is then unused but must stay valid. */
+#define QUD_DMA_PREFER_IDENTITY 1
+#define QUD_DMA_BYPASS_BANK 1
+#define QUD_DMA_IOVA 0x90000000ULL            /* also the start of the DT's dwc3_mem_region window */
+
+/* Started from a running kernel by bsd/dev/pandora_usb.c, whose thread polls the controller:
+ * no interrupts-masked wait for enumeration inside qcom_usb_debug_init. */
+#define QUD_INIT_ENUM_WAIT_MS 0u
+
+/* PE_halt_restart belongs to bsd/dev/sweet_ufs.c (log flush, then PSCI reset): no module hook. */
+#define QUD_PSCI_SMC_RESET 0
+
+/* No prepare stage: the inherited state above already qualifies; QUD_PHY_BASE stays 0. */
+
+#endif
diff --git a/bsd/dev/qcomusb/usb/Dwc3.c b/bsd/dev/qcomusb/usb/Dwc3.c
new file mode 100644
index 0000000..848dc2c
--- /dev/null
+++ b/bsd/dev/qcomusb/usb/Dwc3.c
@@ -0,0 +1,647 @@
+/* SPDX-License-Identifier: MIT
+ * Derived from Asahi Linux m1n1 v1.4.17 usb_dwc3.c. See LICENSE.m1n1 and
+ * ../docs/architecture.md. DART, allocation, Apple platform and the second CDC port removed.
+ */
+#include "Dwc3.h"
+#include "Dwc3Regs.h"
+
+#define EP_COUNT 6u
+#define EP_NOTIFY 3u
+#define EP_OUT 4u
+#define EP_IN 5u
+#define EVENT_BYTES 4096u
+#define TRB_OFFSET 4096u
+#define BUFFER_OFFSET 8192u
+#define EP_BUFFER_BYTES 4096u
+#define TX_BYTES DWC3_TX_BYTES
+#define COMMAND_POLLS 10000u
+#define CONFIG_ACTION_MODIFY (2u << 30)
+
+enum control_state {
+    CTRL_SETUP, CTRL_IN_WAIT, CTRL_IN_ACTIVE, CTRL_OUT_WAIT, CTRL_OUT_ACTIVE,
+    CTRL_STATUS_IN_WAIT, CTRL_STATUS_IN_ACTIVE, CTRL_STATUS_OUT_WAIT,
+    CTRL_STATUS_OUT_ACTIVE
+};
+
+struct dwc3 {
+    struct dwc3_platform io;
+    uint8_t *dma_cpu;
+    uint64_t dma_device;
+    uint32_t event_offset, tx_head, tx_tail, tx_used, in_length;
+    uint32_t rx_head, rx_tail, rx_used, rx_generation;
+    uint64_t rx_overflow;
+    uint32_t packet_size;
+    uint32_t resource[EP_COUNT];
+    uint8_t active[EP_COUNT];
+    uint8_t tx[TX_BYTES], rx[DWC3_RX_BYTES], line_coding[7], control_reply[256];
+    uint16_t control_length;
+    uint8_t control_state, control_three_stage, configured, dtr;
+    uint8_t zlp_pending, running, initialized, full_speed, usb31;
+    int failed;
+    uint32_t events, commands, last_event;
+    uint64_t dropped;
+    uint8_t device_descriptor[18], manufacturer[64], product[64], serial[64];
+};
+
+_Static_assert(sizeof(struct dwc3) <= DWC3_CONTEXT_BYTES,
+               "DWC3 context exceeds the public storage budget");
+
+static const uint8_t device_descriptor[] = {
+    18, 1, 0, 2, 2, 0, 0, 64, 0, 0, 0, 0,
+    0, 1, 1, 2, 3, 1
+};
+static const uint8_t qualifier[] = {10, 6, 0, 2, 2, 0, 0, 64, 1, 0};
+#define CONFIG_BYTES(mpslo, mpshi, dtype) \
+    9, dtype, 67, 0, 2, 1, 0, 0x80, 50, \
+    9, 4, 0, 0, 1, 2, 2, 1, 0, \
+    5, 0x24, 0, 0x10, 1, \
+    5, 0x24, 1, 0, 1, \
+    4, 0x24, 2, 2, \
+    5, 0x24, 6, 0, 1, \
+    7, 5, 0x81, 3, 16, 0, 10, \
+    9, 4, 1, 0, 2, 0x0a, 0, 0, 0, \
+    7, 5, 0x02, 2, mpslo, mpshi, 0, \
+    7, 5, 0x82, 2, mpslo, mpshi, 0
+static const uint8_t config_hs[] = {CONFIG_BYTES(0, 2, 2)};
+static const uint8_t config_fs[] = {CONFIG_BYTES(64, 0, 2)};
+static const uint8_t other_hs[] = {CONFIG_BYTES(0, 2, 7)};
+static const uint8_t other_fs[] = {CONFIG_BYTES(64, 0, 7)};
+static const uint8_t language[] = {4, 3, 9, 4};
+/* Per-instance fixed storage; identity does not retain caller pointers. */
+static size_t identity_chars(const char *text)
+{
+    size_t n;
+    if (!text) return 0;
+    for (n = 0; n < 32u; ++n) {
+        unsigned char c = (unsigned char)text[n];
+        if (!c) return n;
+        if (c < 32u || c > 126u) return 0;
+    }
+    return 0;
+}
+static void string_descriptor(uint8_t *out, const char *text, size_t chars)
+{
+    size_t i;
+    out[0] = (uint8_t)(2 + 2 * chars); out[1] = 3;
+    for (i = 0; i < chars; ++i) {
+        out[2 + 2 * i] = (uint8_t)text[i]; out[3 + 2 * i] = 0;
+    }
+}
+
+static void zero(void *p, size_t n)
+{
+    uint8_t *d = p;
+    while (n--) *d++ = 0;
+}
+static void copy(void *to, const void *from, size_t n)
+{
+    uint8_t *d = to;
+    const uint8_t *s = from;
+    while (n--) *d++ = *s++;
+}
+static uint16_t le16(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+static uint32_t rd(struct dwc3 *d, uint32_t r) { return d->io.read32(d->io.cookie, r); }
+static void wr(struct dwc3 *d, uint32_t r, uint32_t v) { d->io.write32(d->io.cookie, r, v); }
+static void trace(struct dwc3 *d, enum dwc3_trace e, uint32_t a, uint32_t b)
+{
+    if (d->io.trace) d->io.trace(d->io.cookie, e, a, b);
+}
+static void sync(struct dwc3 *d, void *p, size_t n, enum dwc3_sync_direction dir)
+{
+    d->io.dma_sync(d->io.cookie, p, n, dir);
+    d->io.barrier(d->io.cookie);
+}
+static uint8_t *buffer(struct dwc3 *d, unsigned ep)
+{
+    return d->dma_cpu + BUFFER_OFFSET + ep * EP_BUFFER_BYTES;
+}
+static struct dwc3_trb *trb(struct dwc3 *d, unsigned ep)
+{
+    return (struct dwc3_trb *)(void *)(d->dma_cpu + TRB_OFFSET + ep * 64u);
+}
+static void rx_reset(struct dwc3 *d)
+{
+    zero(d->rx, sizeof(d->rx));
+    d->rx_head = d->rx_tail = d->rx_used = 0;
+    d->rx_generation++;
+}
+static void rx_push(struct dwc3 *d, const uint8_t *bytes, size_t count)
+{
+    size_t i, accepted = count;
+    if (accepted > DWC3_RX_BYTES - d->rx_used)
+        accepted = DWC3_RX_BYTES - d->rx_used;
+    for (i = 0; i < accepted; i++) {
+        d->rx[d->rx_head] = bytes[i];
+        d->rx_head = (d->rx_head + 1u) % DWC3_RX_BYTES;
+    }
+    d->rx_used += (uint32_t)accepted;
+    d->rx_overflow += count - accepted;
+}
+static int wait_mask(struct dwc3 *d, uint32_t reg, uint32_t mask, uint32_t want)
+{
+    unsigned i;
+    for (i = 0; i < COMMAND_POLLS; i++) {
+        if ((rd(d, reg) & mask) == want) return 0;
+        d->io.delay_us(d->io.cookie, 1);
+    }
+    trace(d, DWC3_TRACE_TIMEOUT, reg, rd(d, reg));
+    return -3;
+}
+static int ep_command(struct dwc3 *d, unsigned ep, uint32_t cmd,
+                      uint32_t p0, uint32_t p1, uint32_t p2)
+{
+    uint32_t result;
+    uint32_t phy = rd(d, DWC3_GUSB2PHYCFG(0));
+    uint32_t suspend = DWC3_GUSB2PHYCFG_SUSPHY | (1u << 8); /* ENBLSLPM */
+    int ret = 0;
+    d->commands++;
+    /* DWC_usb31 1.90a guide 3.2.2, also Linux dwc3_send_gadget_ep_cmd:
+     * HS/FS endpoint commands require both PHY suspend controls disabled. */
+    if (phy & suspend) wr(d, DWC3_GUSB2PHYCFG(0), phy & ~suspend);
+    wr(d, DWC3_DEPCMDPAR0(ep), p0);
+    wr(d, DWC3_DEPCMDPAR1(ep), p1);
+    wr(d, DWC3_DEPCMDPAR2(ep), p2);
+    wr(d, DWC3_DEPCMD(ep), cmd | DWC3_DEPCMD_CMDACT);
+    /* USB31 cannot use CMDACT polling to guarantee ENDTRANSFER completion.
+     * The documented no-IOC sequence waits 1ms before buffer reuse. */
+    if (d->usb31 && (cmd & 15u) == DWC3_DEPCMD_ENDTRANSFER) {
+        d->io.delay_us(d->io.cookie, 1000);
+        goto out;
+    }
+    if (wait_mask(d, DWC3_DEPCMD(ep), DWC3_DEPCMD_CMDACT, 0)) { ret = -3; goto out; }
+    result = rd(d, DWC3_DEPCMD(ep));
+    /* Command status is a four-bit field, unlike the old m1n1 header. */
+    if ((result >> 12) & 15u) {
+        trace(d, DWC3_TRACE_COMMAND, (ep << 16) | cmd, result);
+        ret = -4; goto out;
+    }
+    if ((cmd & 15u) == DWC3_DEPCMD_STARTTRANSFER)
+        d->resource[ep] = DWC3_DEPCMD_GET_RSC_IDX(result);
+out:
+    if (phy & suspend) wr(d, DWC3_GUSB2PHYCFG(0), phy);
+    return ret;
+}
+static int end_transfer(struct dwc3 *d, unsigned ep)
+{
+    if (!d->active[ep]) return 0;
+    if (ep_command(d, ep, DWC3_DEPCMD_ENDTRANSFER | DWC3_DEPCMD_HIPRI_FORCERM |
+                   DWC3_DEPCMD_PARAM(d->resource[ep]), 0, 0, 0)) return -4;
+    d->active[ep] = 0;
+    return 0;
+}
+static int end_noncontrol(struct dwc3 *d)
+{
+    unsigned ep;
+    for (ep = EP_NOTIFY; ep < EP_COUNT; ep++) if (end_transfer(d, ep)) return -4;
+    d->zlp_pending = 0;
+    return 0;
+}
+static int configure_ep(struct dwc3 *d, unsigned ep, unsigned type,
+                        unsigned packet, int modify)
+{
+    uint32_t p0 = DWC3_DEPCFG_EP_TYPE(type) | DWC3_DEPCFG_MAX_PACKET_SIZE(packet);
+    uint32_t p1 = DWC3_DEPCFG_XFER_COMPLETE_EN | DWC3_DEPCFG_XFER_NOT_READY_EN |
+                  DWC3_DEPCFG_EP_NUMBER(ep);
+    /* FIFO number is the USB IN endpoint number, not physical endpoint index. */
+    if (ep & 1u) p0 |= DWC3_DEPCFG_FIFO_NUMBER(ep >> 1);
+    if (type == DWC3_DEPCMD_TYPE_INTR) p1 |= DWC3_DEPCFG_BINTERVAL_M1(9);
+    if (modify) p0 |= CONFIG_ACTION_MODIFY;
+    if (ep_command(d, ep, DWC3_DEPCMD_SETEPCONFIG, p0, p1, 0)) return -4;
+    if (!modify && ep_command(d, ep, DWC3_DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) return -4;
+    return 0;
+}
+static int transfer(struct dwc3 *d, unsigned ep, uint32_t type, unsigned bytes)
+{
+    struct dwc3_trb *t = trb(d, ep);
+    uint64_t data_dma = d->dma_device + BUFFER_OFFSET + ep * EP_BUFFER_BYTES;
+    uint64_t trb_dma = d->dma_device + TRB_OFFSET + ep * 64u;
+    if (d->active[ep] || bytes > EP_BUFFER_BYTES) return -5;
+    t->bpl = (uint32_t)data_dma;
+    t->bph = (uint32_t)(data_dma >> 32);
+    t->size = bytes;
+    t->ctrl = type | DWC3_TRB_CTRL_HWO | DWC3_TRB_CTRL_LST |
+              DWC3_TRB_CTRL_ISP_IMI | DWC3_TRB_CTRL_IOC;
+    sync(d, buffer(d, ep), EP_BUFFER_BYTES, DWC3_TO_DEVICE);
+    sync(d, t, 64, DWC3_TO_DEVICE);
+    if (ep_command(d, ep, DWC3_DEPCMD_STARTTRANSFER,
+                   (uint32_t)(trb_dma >> 32), (uint32_t)trb_dma, 0)) return -4;
+    d->active[ep] = 1;
+    return 0;
+}
+static int setup_phase(struct dwc3 *d)
+{
+    d->control_state = CTRL_SETUP;
+    return transfer(d, 0, DWC3_TRBCTL_CONTROL_SETUP, 8);
+}
+static int stall(struct dwc3 *d)
+{
+    trace(d, DWC3_TRACE_UNSUPPORTED, buffer(d, 0)[0], buffer(d, 0)[1]);
+    if (ep_command(d, 0, DWC3_DEPCMD_SETSTALL, 0, 0, 0)) return -4;
+    return setup_phase(d);
+}
+
+const void *dwc3_descriptor(const struct dwc3 *d, unsigned type, unsigned index, int fs, size_t *length)
+{
+    const uint8_t *p = 0;
+    size_t n = 0;
+    if (!d || !d->initialized) { if (length) *length = 0; return 0; }
+    if (index == 0) {
+        switch (type) {
+        case 1: p = d->device_descriptor; n = sizeof(d->device_descriptor); break;
+        case 2: p = fs ? config_fs : config_hs; n = sizeof(config_hs); break;
+        case 6: p = qualifier; n = sizeof(qualifier); break;
+        case 7: p = fs ? other_hs : other_fs; n = sizeof(other_hs); break;
+        }
+    }
+    if (type == 3) {
+        switch (index) {
+        case 0: p = language; n = sizeof(language); break;
+        case 1: p = d->manufacturer; n = p[0]; break;
+        case 2: p = d->product; n = p[0]; break;
+        case 3: p = d->serial; n = p[0]; break;
+        }
+    }
+    if (length) *length = n;
+    return p;
+}
+
+static int set_configuration(struct dwc3 *d, unsigned value)
+{
+    if (value > 1) return -1;
+    if (d->configured && end_noncontrol(d)) return -4;
+    d->configured = (uint8_t)value;
+    d->dtr = 0;
+    wr(d, DWC3_DALEPENA, 3u | (value ? ((1u << EP_NOTIFY) | (1u << EP_OUT) |
+                                       (1u << EP_IN)) : 0u));
+    return 0;
+}
+static int setup_request(struct dwc3 *d)
+{
+    const uint8_t *s = buffer(d, 0), *reply = 0;
+    uint16_t value = le16(s + 2), index = le16(s + 4), length = le16(s + 6);
+    size_t n = 0;
+    int ok = 0;
+    trace(d, DWC3_TRACE_SETUP, ((uint32_t)s[0] << 24) | ((uint32_t)s[1] << 16) | value,
+          ((uint32_t)index << 16) | length);
+    d->control_three_stage = length != 0;
+    d->control_length = 0;
+    if (s[0] == 0x80 && s[1] == 6) {
+        reply = dwc3_descriptor(d, value >> 8, value & 255, d->full_speed, &n);
+        ok = reply != 0;
+    } else if ((s[0] == 0x80 || s[0] == 0x81 || s[0] == 0x82) && s[1] == 0 &&
+               value == 0 && length == 2 && ((s[0] == 0x80 && index == 0) ||
+               (s[0] == 0x81 && index < 2) ||
+               (s[0] == 0x82 && (index == 0 || index == 0x80 || index == 0x81 ||
+                                  index == 2 || index == 0x82)))) {
+        d->control_reply[0] = 0; d->control_reply[1] = 0;
+        reply = d->control_reply; n = 2; ok = 1;
+    } else if (s[0] == 0 && s[1] == 5 && value <= 127 && index == 0 && length == 0) {
+        wr(d, DWC3_DCFG, (rd(d, DWC3_DCFG) & ~DWC3_DCFG_DEVADDR_MASK) |
+                         DWC3_DCFG_DEVADDR(value));
+        ok = 1;
+    } else if (s[0] == 0 && s[1] == 9 && index == 0 && length == 0 && value <= 1) {
+        int ret = set_configuration(d, value);
+        if (ret) return ret;
+        ok = 1;
+    } else if (s[0] == 0x80 && s[1] == 8 && value == 0 && index == 0 && length == 1) {
+        d->control_reply[0] = d->configured; reply = d->control_reply; n = 1; ok = 1;
+    } else if (s[0] == 0x81 && s[1] == 10 && value == 0 && index < 2 && length == 1) {
+        d->control_reply[0] = 0; reply = d->control_reply; n = 1; ok = 1;
+    } else if (s[0] == 1 && s[1] == 11 && value == 0 && index < 2 && length == 0) {
+        ok = 1;
+    } else if (s[0] == 0x21 && s[1] == 0x22 && index == 0 && length == 0 && value <= 3) {
+        d->dtr = (uint8_t)(value & 1);
+        trace(d, DWC3_TRACE_READY, d->configured, d->dtr); ok = 1;
+    } else if (s[0] == 0xa1 && s[1] == 0x21 && index == 0 && value == 0 && length == 7) {
+        reply = d->line_coding; n = 7; ok = 1;
+    } else if (s[0] == 0x21 && s[1] == 0x20 && index == 0 && value == 0 && length == 7) {
+        d->control_length = 7; d->control_state = CTRL_OUT_WAIT; return 0;
+    } else if (s[0] == 2 && s[1] == 1 && value == 0 && length == 0 &&
+               (index == 0x81 || index == 2 || index == 0x82)) {
+        unsigned ep = ((index & 15u) << 1) | ((index >> 7) & 1u);
+        ok = ep_command(d, ep, DWC3_DEPCMD_CLEARSTALL, 0, 0, 0) == 0;
+    }
+    if (!ok) return stall(d);
+    if (length) {
+        if (!(s[0] & 0x80) || !reply) return stall(d);
+        if (n > length) n = length;
+        if (n > sizeof(d->control_reply)) return stall(d);
+        copy(buffer(d, 1), reply, n);
+        d->control_length = (uint16_t)n;
+        d->control_state = CTRL_IN_WAIT;
+    } else d->control_state = CTRL_STATUS_IN_WAIT;
+    return 0;
+}
+
+static int control_not_ready(struct dwc3 *d, unsigned ep, unsigned status)
+{
+    uint32_t status_type = d->control_three_stage ? DWC3_TRBCTL_CONTROL_STATUS3 :
+                                                  DWC3_TRBCTL_CONTROL_STATUS2;
+    switch (d->control_state) {
+    case CTRL_IN_WAIT:
+        if (ep != 1 || status != DEPEVT_STATUS_CONTROL_DATA) return 0;
+        d->control_state = CTRL_IN_ACTIVE;
+        return transfer(d, 1, DWC3_TRBCTL_CONTROL_DATA, d->control_length);
+    case CTRL_OUT_WAIT:
+        if (ep != 0 || status != DEPEVT_STATUS_CONTROL_DATA) return 0;
+        d->control_state = CTRL_OUT_ACTIVE;
+        return transfer(d, 0, DWC3_TRBCTL_CONTROL_DATA, 64);
+    case CTRL_STATUS_IN_WAIT:
+        if (ep != 1 || status != DEPEVT_STATUS_CONTROL_STATUS) return 0;
+        d->control_state = CTRL_STATUS_IN_ACTIVE;
+        return transfer(d, 1, status_type, 0);
+    case CTRL_STATUS_OUT_WAIT:
+        if (ep != 0 || status != DEPEVT_STATUS_CONTROL_STATUS) return 0;
+        d->control_state = CTRL_STATUS_OUT_ACTIVE;
+        return transfer(d, 0, status_type, 0);
+    default: return 0;
+    }
+}
+static int control_complete(struct dwc3 *d, unsigned ep, uint32_t residual)
+{
+    switch (d->control_state) {
+    case CTRL_SETUP:
+        if (ep != 0 || residual) return stall(d);
+        sync(d, buffer(d, 0), EP_BUFFER_BYTES, DWC3_FROM_DEVICE);
+        return setup_request(d);
+    case CTRL_IN_ACTIVE:
+        if (ep != 1 || residual) return stall(d);
+        d->control_state = CTRL_STATUS_OUT_WAIT; return 0;
+    case CTRL_OUT_ACTIVE:
+        if (ep != 0 || residual != 64u - d->control_length) return stall(d);
+        sync(d, buffer(d, 0), EP_BUFFER_BYTES, DWC3_FROM_DEVICE);
+        copy(d->line_coding, buffer(d, 0), 7);
+        d->control_state = CTRL_STATUS_IN_WAIT; return 0;
+    case CTRL_STATUS_IN_ACTIVE:
+    case CTRL_STATUS_OUT_ACTIVE: return setup_phase(d);
+    default: return stall(d);
+    }
+}
+static int pump(struct dwc3 *d)
+{
+    uint32_t n, i;
+    if (!d->configured) return 0;
+    /* Keep one bulk-OUT transfer armed. Completed bytes are copied into the
+     * finite RX ring by handle_event before this function rearms it. */
+    if (!d->active[EP_OUT] && transfer(d, EP_OUT, DWC3_TRBCTL_NORMAL, EP_BUFFER_BYTES)) return -4;
+    if (!d->dtr || d->active[EP_IN]) return 0;
+    n = d->tx_used < EP_BUFFER_BYTES ? d->tx_used : EP_BUFFER_BYTES;
+    if (!n && !d->zlp_pending) return 0;
+    for (i = 0; i < n; i++) buffer(d, EP_IN)[i] = d->tx[(d->tx_tail + i) % TX_BYTES];
+    if (transfer(d, EP_IN, DWC3_TRBCTL_NORMAL, n)) return -4;
+    d->in_length = n;
+    return 0;
+}
+static int device_event(struct dwc3 *d, unsigned event)
+{
+    unsigned i, speed;
+    trace(d, DWC3_TRACE_DEVICE_EVENT, event, rd(d, DWC3_DSTS));
+    if (event == DWC3_DEVT_USBRST || event == DWC3_DEVT_DISCONN) {
+        d->configured = d->dtr = d->zlp_pending = 0;
+        rx_reset(d);
+        if (end_noncontrol(d)) return -4;
+        /* EP0 SETUP/STATUS have special hardware rules; only an active DATA
+         * transfer needs ENDTRANSFER before resetting the control state. */
+        if (d->control_state == CTRL_IN_ACTIVE && end_transfer(d, 1)) return -4;
+        if (d->control_state == CTRL_OUT_ACTIVE && end_transfer(d, 0)) return -4;
+        for (i = 0; i < EP_COUNT; i++) d->active[i] = 0;
+        wr(d, DWC3_DALEPENA, 3);
+        wr(d, DWC3_DCFG, rd(d, DWC3_DCFG) & ~DWC3_DCFG_DEVADDR_MASK);
+        d->control_state = CTRL_SETUP;
+        /* The next CONNECTDONE arms a new SETUP transfer. */
+        return 0;
+    }
+    if (event == DWC3_DEVT_CONNECTDONE) {
+        speed = rd(d, DWC3_DSTS) & DWC3_DSTS_CONNECTSPD;
+        if (speed != DWC3_DSTS_HIGHSPEED && speed != DWC3_DSTS_FULLSPEED1 &&
+            speed != DWC3_DSTS_FULLSPEED2) return -6;
+        d->full_speed = speed != DWC3_DSTS_HIGHSPEED;
+        d->packet_size = d->full_speed ? 64 : 512;
+        if (configure_ep(d, 0, DWC3_DEPCMD_TYPE_CONTROL, 64, 1) ||
+            configure_ep(d, 1, DWC3_DEPCMD_TYPE_CONTROL, 64, 1) ||
+            configure_ep(d, EP_IN, DWC3_DEPCMD_TYPE_BULK, d->packet_size, 1) ||
+            configure_ep(d, EP_OUT, DWC3_DEPCMD_TYPE_BULK, d->packet_size, 1)) return -4;
+        return setup_phase(d);
+    }
+    if (event == DWC3_DEVT_EVNTOVERFLOW || event == DWC3_DEVT_ERRTICERR) return -7;
+    return 0;
+}
+static int handle_event(struct dwc3 *d, uint32_t event)
+{
+    unsigned ep, type, status;
+    uint32_t residual;
+    if (event & 1u) {
+        if (((event >> 1) & 127u) == 0) return device_event(d, (event >> 8) & 15u);
+        trace(d, DWC3_TRACE_BAD_EVENT, event, 0); return 0;
+    }
+    ep = (event >> 1) & 31u;
+    type = (event >> 6) & 15u;
+    status = (event >> 12) & 15u;
+    if (ep >= EP_COUNT || ep == 2) {
+        trace(d, DWC3_TRACE_BAD_EVENT, event, 1); return 0;
+    }
+    if (type == DWC3_DEPEVT_XFERCOMPLETE) {
+        if (!d->active[ep]) return 0;
+        sync(d, trb(d, ep), 64, DWC3_FROM_DEVICE);
+        residual = trb(d, ep)->size & DWC3_TRB_SIZE_MASK;
+        d->active[ep] = 0;
+        if (status & DEPEVT_STATUS_BUSERR) return -8;
+        if (ep < 2 && DWC3_TRB_SIZE_TRBSTS(trb(d, ep)->size) == DWC3_TRBSTS_SETUP_PENDING)
+            return setup_phase(d);
+        if (ep < 2) return control_complete(d, ep, residual);
+        if (DWC3_TRB_SIZE_TRBSTS(trb(d, ep)->size) != DWC3_TRBSTS_OK) return -8;
+        if (ep == EP_OUT) {
+            if (residual > EP_BUFFER_BYTES) return -8;
+            sync(d, buffer(d, EP_OUT), EP_BUFFER_BYTES, DWC3_FROM_DEVICE);
+            rx_push(d, buffer(d, EP_OUT), EP_BUFFER_BYTES - residual);
+        }
+        if (ep == EP_IN) {
+            if (residual > d->in_length) return -8;
+            d->tx_tail = (d->tx_tail + d->in_length - residual) % TX_BYTES;
+            d->tx_used -= d->in_length - residual;
+            d->zlp_pending = d->in_length != 0 && residual == 0 &&
+                             (d->in_length % d->packet_size) == 0;
+        }
+    } else if (type == DWC3_DEPEVT_XFERNOTREADY && !d->active[ep] && ep < 2) {
+        return control_not_ready(d, ep, status);
+    }
+    return 0;
+}
+
+size_t dwc3_context_bytes(void) { return sizeof(struct dwc3); }
+int dwc3_init(void *context, size_t context_bytes,
+                  const struct dwc3_platform *platform,
+                  const struct dwc3_identity *identity,
+                  void *dma_cpu, uint64_t dma_device, size_t dma_bytes)
+{
+    struct dwc3 *d = context;
+    unsigned ep, interrupts, total_eps, in_eps;
+    uint32_t id, params;
+    size_t manufacturer_chars, product_chars, serial_chars;
+    if (!context || ((uintptr_t)context & 7u) || context_bytes < sizeof(*d) ||
+        !platform || !platform->read32 || !platform->write32 || !platform->delay_us ||
+        !platform->dma_sync || !platform->barrier || !dma_cpu ||
+        ((uintptr_t)dma_cpu & (DWC3_DMA_ALIGNMENT - 1)) ||
+        (dma_device & (DWC3_DMA_ALIGNMENT - 1)) ||
+        dma_device > UINT64_MAX - DWC3_DMA_BYTES || dma_bytes < DWC3_DMA_BYTES)
+        return -1;
+    if (!identity || !identity->vid || !identity->pid ||
+        !(manufacturer_chars = identity_chars(identity->manufacturer)) ||
+        !(product_chars = identity_chars(identity->product)) ||
+        !(serial_chars = identity_chars(identity->serial))) return -1;
+    zero(d, sizeof(*d)); copy(&d->io, platform, sizeof(*platform));
+    copy(d->device_descriptor, device_descriptor, sizeof(device_descriptor));
+    d->device_descriptor[8] = (uint8_t)identity->vid;
+    d->device_descriptor[9] = (uint8_t)(identity->vid >> 8);
+    d->device_descriptor[10] = (uint8_t)identity->pid;
+    d->device_descriptor[11] = (uint8_t)(identity->pid >> 8);
+    string_descriptor(d->manufacturer, identity->manufacturer, manufacturer_chars);
+    string_descriptor(d->product, identity->product, product_chars);
+    string_descriptor(d->serial, identity->serial, serial_chars);
+    d->dma_cpu = dma_cpu; d->dma_device = dma_device;
+    d->packet_size = 512;
+    d->line_coding[0] = 0; d->line_coding[1] = 0xc2;
+    d->line_coding[2] = 1; d->line_coding[6] = 8;
+    id = rd(d, DWC3_GSNPSID); trace(d, DWC3_TRACE_ID, id, 0);
+    if ((id & 0xffff0000u) != 0x55330000u && (id & 0xffff0000u) != 0x33310000u)
+        return -2;
+    d->usb31 = (id & 0xffff0000u) == 0x33310000u;
+    params = rd(d, DWC3_GHWPARAMS3);
+    total_eps = (params >> 12) & 63u;
+    in_eps = (params >> 18) & 31u;
+    if (total_eps < EP_COUNT || in_eps < 3 || in_eps > total_eps || total_eps - in_eps < 3)
+        return -2;
+    interrupts = (rd(d, DWC3_GHWPARAMS1) >> 15) & 63u;
+    if (!interrupts || interrupts > 32) return -2;
+    wr(d, DWC3_DCTL, rd(d, DWC3_DCTL) & ~DWC3_DCTL_RUN_STOP);
+    if (wait_mask(d, DWC3_DSTS, DWC3_DSTS_DEVCTRLHLT, DWC3_DSTS_DEVCTRLHLT)) return -3;
+    wr(d, DWC3_DCTL, rd(d, DWC3_DCTL) | DWC3_DCTL_CSFTRST);
+    if (wait_mask(d, DWC3_DCTL, DWC3_DCTL_CSFTRST, 0)) return -3;
+    wr(d, DWC3_DEVTEN, 0); wr(d, DWC3_DALEPENA, 0);
+    /* A previous USB owner may have left other interrupters and unacknowledged
+     * event counts. Halt precedes replacing any event-DMA mapping. */
+    for (ep = 0; ep < interrupts; ep++) {
+        wr(d, DWC3_GEVNTSIZ(ep), 1u << 31);
+        params = rd(d, DWC3_GEVNTCOUNT(ep)) & DWC3_GEVNTCOUNT_MASK;
+        wr(d, DWC3_GEVNTCOUNT(ep), params);
+        wr(d, DWC3_GEVNTADRLO(ep), 0); wr(d, DWC3_GEVNTADRHI(ep), 0);
+    }
+    zero(dma_cpu, DWC3_DMA_BYTES);
+    sync(d, dma_cpu, DWC3_DMA_BYTES, DWC3_TO_DEVICE);
+    wr(d, DWC3_GCTL, (rd(d, DWC3_GCTL) & ~(DWC3_GCTL_PRTCAPDIR(3) |
+         DWC3_GCTL_GBLHIBERNATIONEN)) | DWC3_GCTL_PRTCAPDIR(DWC3_GCTL_PRTCAP_DEVICE));
+    wr(d, DWC3_DCFG, (rd(d, DWC3_DCFG) & ~(DWC3_DCFG_SPEED_MASK | DWC3_DCFG_DEVADDR_MASK |
+         DWC3_DCFG_LPM_CAP)) | DWC3_DCFG_HIGHSPEED);
+    wr(d, DWC3_GEVNTADRLO(0), (uint32_t)dma_device);
+    wr(d, DWC3_GEVNTADRHI(0), (uint32_t)(dma_device >> 32));
+    /* Mask the event IRQ; status still accumulates for polling. */
+    wr(d, DWC3_GEVNTSIZ(0), EVENT_BYTES | (1u << 31));
+    wr(d, DWC3_GEVNTCOUNT(0), 0);
+    wr(d, DWC3_DEVTEN, DWC3_DEVTEN_DISCONNEVTEN | DWC3_DEVTEN_USBRSTEN |
+         DWC3_DEVTEN_CONNECTDONEEN | DWC3_DEVTEN_EVNTOVERFLOWEN | DWC3_DEVTEN_ERRTICERREN);
+    if (ep_command(d, 0, DWC3_DEPCMD_DEPSTARTCFG, 0, 0, 0)) goto fail;
+    for (ep = 0; ep < EP_COUNT; ep++) {
+        if (ep == 2) continue;
+        unsigned type = ep < 2 ? DWC3_DEPCMD_TYPE_CONTROL :
+                        ep == EP_NOTIFY ? DWC3_DEPCMD_TYPE_INTR : DWC3_DEPCMD_TYPE_BULK;
+        unsigned mps = ep < 2 ? 64 : ep == EP_NOTIFY ? 16 : 512;
+        if (configure_ep(d, ep, type, mps, 0)) goto fail;
+    }
+    wr(d, DWC3_DALEPENA, 3);
+    d->initialized = 1;
+    return 0;
+fail:
+    wr(d, DWC3_DEVTEN, 0); wr(d, DWC3_DALEPENA, 0); return -4;
+}
+int dwc3_start(struct dwc3 *d)
+{
+    if (!d || !d->initialized || d->failed) return -1;
+    wr(d, DWC3_DCTL, rd(d, DWC3_DCTL) | DWC3_DCTL_RUN_STOP);
+    d->running = 1; return 0;
+}
+int dwc3_poll(struct dwc3 *d, unsigned budget)
+{
+    uint32_t bytes, event;
+    unsigned done = 0;
+    int ret = 0;
+    if (!d || !d->running || d->failed) return -1;
+    if (budget > 256) budget = 256;
+    bytes = rd(d, DWC3_GEVNTCOUNT(0)) & DWC3_GEVNTCOUNT_MASK;
+    if (bytes > EVENT_BYTES) { d->failed = -7; return -7; }
+    while (bytes >= 4 && done < budget) {
+        uint8_t *p = d->dma_cpu + d->event_offset;
+        sync(d, p, 4, DWC3_FROM_DEVICE);
+        event = (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+                ((uint32_t)p[3] << 24);
+        d->event_offset = (d->event_offset + 4) % EVENT_BYTES;
+        ret = handle_event(d, event);
+        d->events++; d->last_event = event;
+        wr(d, DWC3_GEVNTCOUNT(0), 4);
+        done++; bytes -= 4;
+        if (ret) { d->failed = ret; return ret; }
+    }
+    ret = pump(d);
+    if (ret) { d->failed = ret; return ret; }
+    return (int)done;
+}
+size_t dwc3_queue(struct dwc3 *d, const void *bytes, size_t count)
+{
+    const uint8_t *p = bytes;
+    size_t n = count, i;
+    if (!d || !d->initialized || !bytes) return 0;
+    if (n > TX_BYTES - d->tx_used) n = TX_BYTES - d->tx_used;
+    for (i = 0; i < n; i++) { d->tx[d->tx_head] = p[i]; d->tx_head = (d->tx_head + 1) % TX_BYTES; }
+    d->tx_used += (uint32_t)n;
+    d->dropped += count - n;
+    return n;
+}
+size_t dwc3_read(struct dwc3 *d, void *bytes, size_t count)
+{
+    uint8_t *to = bytes;
+    size_t n, i;
+    if (!d || !bytes || !count) return 0;
+    n = count < d->rx_used ? count : d->rx_used;
+    for (i = 0; i < n; i++) {
+        to[i] = d->rx[d->rx_tail];
+        d->rx_tail = (d->rx_tail + 1u) % DWC3_RX_BYTES;
+    }
+    d->rx_used -= (uint32_t)n;
+    return n;
+}
+int dwc3_ready(const struct dwc3 *d) { return d && d->running && !d->failed && d->configured && d->dtr; }
+size_t dwc3_queued(const struct dwc3 *d) { return d ? d->tx_used : 0; }
+uint64_t dwc3_dropped(const struct dwc3 *d) { return d ? d->dropped : 0; }
+size_t dwc3_rx_pending(const struct dwc3 *d) { return d ? d->rx_used : 0; }
+uint64_t dwc3_rx_overflow(const struct dwc3 *d) { return d ? d->rx_overflow : 0; }
+uint32_t dwc3_rx_generation(const struct dwc3 *d) { return d ? d->rx_generation : 0; }
+void dwc3_snapshot(struct dwc3 *d, struct dwc3_snapshot *s)
+{
+    unsigned ep;
+    if (!d || !s) return;
+    zero(s, sizeof(*s));
+    s->events = d->events; s->commands = d->commands; s->last_event = d->last_event;
+    s->event_offset = d->event_offset; s->failed = d->failed;
+    s->snpsid = rd(d, DWC3_GSNPSID); s->gctl = rd(d, DWC3_GCTL);
+    s->dcfg = rd(d, DWC3_DCFG); s->dctl = rd(d, DWC3_DCTL); s->dsts = rd(d, DWC3_DSTS);
+    s->event_count = rd(d, DWC3_GEVNTCOUNT(0)); s->enabled_endpoints = rd(d, DWC3_DALEPENA);
+    s->configured = d->configured; s->dtr = d->dtr; s->queued = d->tx_used;
+    s->rx_pending = d->rx_used; s->rx_generation = d->rx_generation;
+    s->rx_overflow = d->rx_overflow;
+    for (ep = 0; ep < EP_COUNT; ep++) if (d->active[ep]) s->active_endpoints |= 1u << ep;
+}
+int dwc3_stop(struct dwc3 *d)
+{
+    unsigned ep;
+    if (!d || !d->initialized) return -1;
+    d->dtr = d->configured = 0;
+    rx_reset(d);
+    for (ep = 0; ep < EP_COUNT; ep++) {
+        if (ep < 2 && d->control_state != CTRL_IN_ACTIVE && d->control_state != CTRL_OUT_ACTIVE)
+            continue;
+        if (end_transfer(d, ep)) return -4;
+    }
+    wr(d, DWC3_DEVTEN, 0); wr(d, DWC3_DALEPENA, 0);
+    wr(d, DWC3_DCTL, rd(d, DWC3_DCTL) & ~DWC3_DCTL_RUN_STOP);
+    if (wait_mask(d, DWC3_DSTS, DWC3_DSTS_DEVCTRLHLT, DWC3_DSTS_DEVCTRLHLT)) return -3;
+    d->running = 0; return 0;
+}
diff --git a/bsd/dev/qcomusb/usb/Dwc3.h b/bsd/dev/qcomusb/usb/Dwc3.h
new file mode 100644
index 0000000..8e0662a
--- /dev/null
+++ b/bsd/dev/qcomusb/usb/Dwc3.h
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef DWC3_H
+#define DWC3_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* One caller-owned, contiguous device-DMA mapping. Never assume DMA == PA. */
+#define DWC3_DMA_BYTES 32768u
+#define DWC3_DMA_ALIGNMENT 4096u
+#define DWC3_CONTEXT_ALIGNMENT 8u
+#define DWC3_CONTEXT_BYTES 20480u
+#define DWC3_TX_BYTES 16384u
+#define DWC3_RX_BYTES 512u
+
+/* Copied at init; no SoC configuration, OS headers or platform IDs here.
+ * Each string must contain 1..31 printable ASCII characters. */
+struct dwc3_identity {
+    uint16_t vid, pid;
+    const char *manufacturer, *product, *serial;
+};
+
+enum dwc3_sync_direction {
+    DWC3_TO_DEVICE,
+    DWC3_FROM_DEVICE
+};
+
+enum dwc3_trace {
+    DWC3_TRACE_ID = 1,
+    DWC3_TRACE_TIMEOUT,
+    DWC3_TRACE_COMMAND,
+    DWC3_TRACE_DEVICE_EVENT,
+    DWC3_TRACE_SETUP,
+    DWC3_TRACE_UNSUPPORTED,
+    DWC3_TRACE_BAD_EVENT,
+    DWC3_TRACE_READY
+};
+
+struct dwc3_platform {
+    void *cookie;
+    uint32_t (*read32)(void *cookie, uint32_t offset);
+    void (*write32)(void *cookie, uint32_t offset, uint32_t value);
+    void (*delay_us)(void *cookie, uint32_t usec);
+    /* Must also handle noncoherent DMA. Event/TRB cache lines are separate. */
+    void (*dma_sync)(void *cookie, void *cpu, size_t bytes,
+                     enum dwc3_sync_direction direction);
+    void (*barrier)(void *cookie);
+    void (*trace)(void *cookie, enum dwc3_trace event, uint32_t a, uint32_t b);
+};
+
+struct dwc3;
+size_t dwc3_context_bytes(void);
+/* Platform must have already established device role, PHY/clocks, power and
+ * SMMU mapping. This resets only the DWC device side; it never initializes PHY.
+ * Buffers must remain mapped at the same CPU/DMA addresses for this instance.
+ * Returns 0 or a negative code. On failure controller is left stopped. */
+int dwc3_init(void *context, size_t context_bytes,
+                  const struct dwc3_platform *platform,
+                  const struct dwc3_identity *identity,
+                  void *dma_cpu, uint64_t dma_device, size_t dma_bytes);
+int dwc3_start(struct dwc3 *dev);
+/* Each poll is bounded to min(budget, 256) events. Call from one CPU only;
+ * no interrupts, allocation, scheduler, EFI or platform-library calls occur. */
+int dwc3_poll(struct dwc3 *dev, unsigned int budget);
+/* Nonblocking ring; accepts early messages before the host opens the port. */
+size_t dwc3_queue(struct dwc3 *dev, const void *bytes, size_t count);
+/* Nonblocking bulk-OUT receive ring. The caller must serialize this with poll
+ * on the same CPU. A device reset/disconnect clears pending RX bytes and
+ * advances rx_generation so a protocol parser can invalidate its state. */
+size_t dwc3_read(struct dwc3 *dev, void *bytes, size_t count);
+int dwc3_ready(const struct dwc3 *dev);
+size_t dwc3_queued(const struct dwc3 *dev);
+uint64_t dwc3_dropped(const struct dwc3 *dev);
+size_t dwc3_rx_pending(const struct dwc3 *dev);
+uint64_t dwc3_rx_overflow(const struct dwc3 *dev);
+uint32_t dwc3_rx_generation(const struct dwc3 *dev);
+struct dwc3_snapshot {
+    uint32_t events, commands, last_event, event_offset;
+    uint32_t snpsid, gctl, dcfg, dctl, dsts, event_count, enabled_endpoints;
+    uint32_t configured, dtr, queued, active_endpoints;
+    uint32_t rx_pending, rx_generation;
+    uint64_t rx_overflow;
+    int32_t failed;
+};
+/* Read-only diagnostics, for callers that already own powered MMIO access. */
+void dwc3_snapshot(struct dwc3 *dev, struct dwc3_snapshot *snapshot);
+/* Stops DMA. Do not release mapping until this succeeds. */
+int dwc3_stop(struct dwc3 *dev);
+
+/* Descriptor view for host conformance tests and the firmware USB backend.
+ * type uses USB descriptor IDs; full_speed selects bulk wMaxPacketSize=64. */
+const void *dwc3_descriptor(const struct dwc3 *dev, unsigned int type, unsigned int index,
+                               int full_speed, size_t *length);
+#endif
