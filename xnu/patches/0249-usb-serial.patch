diff --git a/bsd/dev/qcomusb/include/QcomUsbPrepare.h b/bsd/dev/qcomusb/include/QcomUsbPrepare.h
new file mode 100644
index 0000000..c35c0f2
--- /dev/null
+++ b/bsd/dev/qcomusb/include/QcomUsbPrepare.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: MIT
+ * SM8150/nabu device-mode bring-up that runs before the log module's
+ * inherited-state qualification. Pure MMIO through callbacks, bounded work.
+ */
+#ifndef QCOM_USB_PREPARE_H
+#define QCOM_USB_PREPARE_H
+#include <stdint.h>
+#include "QcomUsbSoc.h"
+
+typedef struct {
+    int  (*read32)(void *cookie, uint64_t address, uint32_t *value);
+    int  (*write32)(void *cookie, uint64_t address, uint32_t value);
+    void  *cookie;
+    void (*delay_us)(void *cookie, uint32_t usec);
+    uint64_t deadline;          /* absolute CNTPCT, 0 = no deadline */
+} QCOM_PREPARE_PLATFORM;
+
+typedef enum {
+    QPREP_OK = 0,
+    QPREP_ARG,          /* bad platform or profile lacks the PHY window */
+    QPREP_DEADLINE,     /* clock/counter budget exhausted before finishing */
+    QPREP_ID,           /* GSNPSID is not a supported DWC3 family */
+    QPREP_CLOCKS,       /* a USB branch stayed gated (CBCR.CLK_OFF) */
+    QPREP_GDSC,         /* GDSC never reported PWR_ON */
+    QPREP_RESET,        /* a GCC reset did not release */
+    QPREP_PHY,          /* femto HS PHY readback mismatch */
+    QPREP_CORE          /* GCTL/DCTL did not reach device mode */
+} QCOM_PREPARE_RESULT;
+
+/* Stage numbers reported through failed_stage. */
+enum {
+    QPREP_STAGE_START = 0,
+    QPREP_STAGE_CLOCKS = 1,
+    QPREP_STAGE_ID = 2,
+    QPREP_STAGE_PHY = 3,
+    QPREP_STAGE_CORE = 4,
+};
+
+QCOM_PREPARE_RESULT QcomUsbPrepare(const QCOM_PREPARE_PLATFORM *platform,
+                                   uint32_t *failed_stage, uint32_t *last_readback);
+#endif
diff --git a/bsd/dev/qcomusb/include/QcomUsbScreenshot.h b/bsd/dev/qcomusb/include/QcomUsbScreenshot.h
new file mode 100644
index 0000000..bd591d9
--- /dev/null
+++ b/bsd/dev/qcomusb/include/QcomUsbScreenshot.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef QCOM_USB_SCREENSHOT_H
+#define QCOM_USB_SCREENSHOT_H
+#include <stddef.h>
+#include <stdint.h>
+#ifndef QUD_SCREENSHOT_MAX_BYTES
+#define QUD_SCREENSHOT_MAX_BYTES (16u * 1024u * 1024u)
+#endif
+#define QUD_SCREENSHOT_CHUNK 192u
+#define QUD_SCREENSHOT_MAX_DIMENSION 4096u
+struct qcom_usb_screenshot_info {
+    uint32_t width, height, bytes, encoded_bytes, crc32, frame;
+    uint32_t rle; /* 0: packed RGB888; 1: repeated [count, R, G, B]. */
+};
+/* Normal USB worker context, outside USB guards, never panic context.
+ * Return 1 after copying a complete RGB888 snapshot into caller storage.
+ * Must be bounded, CPU coherent, allocation-free, and release all display
+ * references/locks before returning. No USB/log calls from this callback.
+ */
+typedef int (*qcom_usb_screenshot_capture)(void *cookie, uint8_t *rgb,
+    size_t capacity, uint32_t *width, uint32_t *height);
+enum qcom_usb_framebuffer_format { QCOM_USB_BGRA8888 = 1, QCOM_USB_RGBA8888 = 2 };
+struct qcom_usb_framebuffer {
+    const volatile uint8_t *pixels; /* Existing CPU mapping, never a PA/IOVA. */
+    size_t bytes;
+    uint32_t width, height, stride;
+    enum qcom_usb_framebuffer_format format;
+};
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* One provider, registered once. Cookie/mapping stays valid until reset.
+ * Use a custom provider for changing scanout buffers, cache sync or locking.
+ */
+int qcom_usb_debug_register_screenshot(qcom_usb_screenshot_capture capture, void *cookie);
+/* Convenience adapter for a permanently mapped, coherent fixed scanout.
+ * It does no mapping, cache maintenance or display-service lookup.
+ * Concurrent display writes can produce tearing; custom provider may freeze.
+ */
+int qcom_usb_debug_register_framebuffer(const struct qcom_usb_framebuffer *framebuffer);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/qcomusb/include/QcomUsbSoc.h b/bsd/dev/qcomusb/include/QcomUsbSoc.h
new file mode 100644
index 0000000..c588c1e
--- /dev/null
+++ b/bsd/dev/qcomusb/include/QcomUsbSoc.h
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef QCOM_USB_SOC_H
+#define QCOM_USB_SOC_H
+/* Pass -DQUD_SOC_HEADER='"soc/MySoc.h"', with the module root on -I.
+ * No fallback guesses: a build must explicitly select its hardware profile.
+ * The supplied backend requires clk_branch2/CFG_GDSCR, Qualcomm QSCRATCH,
+ * non-secure QSMMUv500 SMMUv2 and inherited DEVICE-mode PHY/power.
+ */
+#ifndef QUD_SOC_HEADER
+#define QUD_SOC_HEADER "../soc/Sm8850.h"
+#endif
+#ifndef QUD_SOC_HEADER
+#error "Select hardware with -DQUD_SOC_HEADER=\"soc/Sm8550.h\""
+#endif
+#include QUD_SOC_HEADER
+/* SM8550 (and other live GDSCs with qcom,support-cfg-gdscr) use
+ * CFG_GDSCR.POWER_UP_COMPLETE bit16; older blocks without that property
+ * expose the state in GDSCR.PWR_ON bit31 instead. */
+/* Optional HS-PHY window for the device-mode prepare step; a profile that
+ * does not define it cannot run QcomUsbPrepare (it returns QPREP_ARG). */
+#ifndef QUD_GCC_CLOCK_OFFSETS
+#define QUD_GCC_CLOCK_OFFSETS QUD_GCC_CBCR_OFFSETS
+#define QUD_GCC_CLOCK_NO_POLL_OFFSETS {0u}
+#define QUD_GCC_QUSB2PHY_BCR_OFFSET 0u
+#define QUD_GCC_AHB2PHY_BCR_OFFSET 0u
+#endif
+
+#ifndef QUD_PHY_BASE
+#define QUD_PHY_BASE 0ULL
+#endif
+#ifndef QUD_PHY_BYTES
+#define QUD_PHY_BYTES 0u
+#endif
+
+#ifndef QUD_GDSC_LEGACY_PWR_ON
+#define QUD_GDSC_LEGACY_PWR_ON 0
+#endif
+_Static_assert(QUD_GDSC_LEGACY_PWR_ON == 0 || QUD_GDSC_LEGACY_PWR_ON == 1,
+               "GDSC power-state source must be 0 (CFG_GDSCR) or 1 (GDSCR)");
+/* Boards whose bootloader already routes the USB SID through the SMMU cannot
+ * install a private translated domain: the stream slot is taken. Selecting
+ * this uses the module's audited identity lease instead (inherited bypass is
+ * reused, a translated entry becomes TYPE-only bypass with the original pair
+ * saved, and DMA uses physical addresses). */
+#ifndef QUD_DMA_PREFER_IDENTITY
+#define QUD_DMA_PREFER_IDENTITY 0
+#endif
+_Static_assert(QUD_DMA_PREFER_IDENTITY == 0 || QUD_DMA_PREFER_IDENTITY == 1,
+               "identity DMA preference must be 0 or 1");
+/* Firmware whose SMMU rejects a TYPE=BYPASS S2CR (it reads back as FAULT, as on
+ * SM8150) needs the bypass context-bank route instead: SCTLR=0, CBAR
+ * S1_TRANS_S2_BYPASS, CBA2R.VA64=1, and an ordinary TYPE=TRANSLATE S2CR that
+ * holds the bank number. Selecting this uses soc/QcomUsbBypass.c. */
+/* Data A Live: how long qcom_usb_debug_init waits, interrupts masked, for the
+ * host to enumerate (the original 5 s); 0 leaves it to the caller's polling. */
+#ifndef QUD_INIT_ENUM_WAIT_MS
+#define QUD_INIT_ENUM_WAIT_MS 5000u
+#endif
+#ifndef QUD_DMA_BYPASS_BANK
+#define QUD_DMA_BYPASS_BANK 0
+#endif
+_Static_assert(QUD_DMA_BYPASS_BANK == 0 || QUD_DMA_BYPASS_BANK == 1,
+               "bypass-bank selection must be 0 or 1");
+_Static_assert(QUD_PSCI_SMC_RESET == 0 || QUD_PSCI_SMC_RESET == 1,
+               "declare whether the board qualifies PSCI reset via SMC");
+_Static_assert(QUD_USB_VID > 0 && QUD_USB_VID <= 65535 &&
+               QUD_USB_PID > 0 && QUD_USB_PID <= 65535, "USB IDs must fit 16 bits");
+_Static_assert(QUD_STREAM_ID <= 0x7fffu, "legacy/extended SID must fit 15 bits");
+_Static_assert(QUD_DMA_IOVA > 0 && QUD_DMA_IOVA <= 0xffe00000ULL &&
+               (QUD_DMA_IOVA & 0x1fffffULL) == 0,
+               "private three-page table builder needs a 2MiB-aligned 32-bit IOVA");
+_Static_assert(QUD_GCC_BASE != 0 && QUD_DWC3_BASE != 0 && QUD_SMMU_BASE != 0 &&
+               ((QUD_GCC_BASE | QUD_DWC3_BASE | QUD_SMMU_BASE) & 4095u) == 0,
+               "MMIO bases must be nonzero and page aligned");
+_Static_assert(QUD_GCC_BYTES >= 4 && QUD_DWC3_BYTES >= 0xc800u &&
+               QUD_SMMU_BYTES >= 0x10000u, "MMIO windows too small");
+_Static_assert(QUD_GCC_BASE + QUD_GCC_BYTES > QUD_GCC_BASE &&
+               QUD_DWC3_BASE + QUD_DWC3_BYTES > QUD_DWC3_BASE &&
+               QUD_SMMU_BASE + QUD_SMMU_BYTES > QUD_SMMU_BASE,
+               "MMIO window overflow");
+#define QUD_DISJOINT(a, n, b, m) ((a) + (n) <= (b) || (b) + (m) <= (a))
+_Static_assert(QUD_DISJOINT(QUD_GCC_BASE, QUD_GCC_BYTES, QUD_DWC3_BASE, QUD_DWC3_BYTES) &&
+               QUD_DISJOINT(QUD_GCC_BASE, QUD_GCC_BYTES, QUD_SMMU_BASE, QUD_SMMU_BYTES) &&
+               QUD_DISJOINT(QUD_DWC3_BASE, QUD_DWC3_BYTES, QUD_SMMU_BASE, QUD_SMMU_BYTES),
+               "MMIO windows overlap");
+#define QUD_OFFSET_OK(o, n) (((o) & 3u) == 0 && (o) <= (n) - 4)
+_Static_assert(QUD_OFFSET_OK(QUD_GCC_BCR_OFFSET, QUD_GCC_BYTES) &&
+               QUD_OFFSET_OK(QUD_GCC_GDSCR_OFFSET, QUD_GCC_BYTES) &&
+               QUD_OFFSET_OK(QUD_GCC_CFG_GDSCR_OFFSET, QUD_GCC_BYTES) &&
+               QUD_OFFSET_OK(QUD_QSCRATCH_HS_PHY_CTRL_OFFSET, QUD_DWC3_BYTES),
+               "platform register outside MMIO window");
+#endif
diff --git a/bsd/dev/qcomusb/include/QcomXnuUsbDebug.h b/bsd/dev/qcomusb/include/QcomXnuUsbDebug.h
new file mode 100644
index 0000000..f3cdc4a
--- /dev/null
+++ b/bsd/dev/qcomusb/include/QcomXnuUsbDebug.h
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef QCOM_XNU_USB_DEBUG_H
+#define QCOM_XNU_USB_DEBUG_H
+#include <stddef.h>
+#include <stdint.h>
+#include "QcomUsbScreenshot.h"
+
+enum qcom_usb_debug_phase {
+    QCOM_USB_DEBUG_NOT_INITIALIZED,
+    QCOM_USB_DEBUG_DISABLED,
+    QCOM_USB_DEBUG_PREPARING,
+    QCOM_USB_DEBUG_ACTIVE,
+    QCOM_USB_DEBUG_STOPPED,
+    QCOM_USB_DEBUG_REFUSED,
+    QCOM_USB_DEBUG_IO_FAILED
+};
+
+enum qcom_usb_debug_error {
+    QCOM_USB_DEBUG_OK,
+    QCOM_USB_DEBUG_CONTEXT_TOO_SMALL,
+    QCOM_USB_DEBUG_BAD_COUNTER,
+    QCOM_USB_DEBUG_CACHE_GRANULE_UNSUPPORTED,
+    QCOM_USB_DEBUG_DMA_NOT_CONTIGUOUS,
+    QCOM_USB_DEBUG_MAP_FAILED,
+    QCOM_USB_DEBUG_INHERITED_STATE_REFUSED,
+    QCOM_USB_DEBUG_UNSTABLE_POWER_STATE,
+    QCOM_USB_DEBUG_CORE_NOT_DEVICE,
+    QCOM_USB_DEBUG_HALT_TIMEOUT,
+    QCOM_USB_DEBUG_DMA_REFUSED,
+    QCOM_USB_DEBUG_CORE_INIT_FAILED,
+    QCOM_USB_DEBUG_CORE_START_FAILED,
+    QCOM_USB_DEBUG_CORE_POLL_FAILED,
+    QCOM_USB_DEBUG_DEADLINE_EXPIRED,
+    QCOM_USB_DEBUG_CALLBACK_RANGE_FAILED,
+    QCOM_USB_DEBUG_RESTORE_FAILED,
+    QCOM_USB_DEBUG_VBUS_FAILED,
+    QCOM_USB_DEBUG_DMA_WIDTH_UNSUPPORTED,
+    QCOM_USB_DEBUG_TABLES_NOT_CONTIGUOUS,
+    QCOM_USB_DEBUG_DOMAIN_STATE_INVALID,
+    QCOM_USB_DEBUG_ACQUIRE_REFUSED,
+    QCOM_USB_DEBUG_PHY_LEASE_FAILED,
+    QCOM_USB_DEBUG_PREPARE_FAILED
+};
+
+/* Opt-in preparing-panic delay is 100 + 2*checkpoint seconds. */
+enum qcom_usb_debug_diag_checkpoint {
+    QCOM_USB_DEBUG_DIAG_NONE,
+    QCOM_USB_DEBUG_DIAG_BEFORE_ACQUIRE,
+    QCOM_USB_DEBUG_DIAG_AFTER_ACQUIRE,
+    QCOM_USB_DEBUG_DIAG_COUNTER_CACHE,
+    QCOM_USB_DEBUG_DIAG_DATA_VTOP,
+    QCOM_USB_DEBUG_DIAG_TABLE_VTOP,
+    QCOM_USB_DEBUG_DIAG_MAP_GCC,
+    QCOM_USB_DEBUG_DIAG_MAP_USB,
+    QCOM_USB_DEBUG_DIAG_MAP_SMMU,
+    QCOM_USB_DEBUG_DIAG_INSPECT,
+    QCOM_USB_DEBUG_DIAG_GATES_WIDTH,
+    QCOM_USB_DEBUG_DIAG_HALT,
+    QCOM_USB_DEBUG_DIAG_DOMAIN,
+    QCOM_USB_DEBUG_DIAG_VERIFY_DOMAIN,
+    QCOM_USB_DEBUG_DIAG_VBUS,
+    QCOM_USB_DEBUG_DIAG_CORE_INIT,
+    QCOM_USB_DEBUG_DIAG_CORE_START,
+    QCOM_USB_DEBUG_DIAG_CORE_STARTED,
+    QCOM_USB_DEBUG_DIAG_FIRST_POLL,
+    QCOM_USB_DEBUG_DIAG_ENUM_DONE
+};
+
+enum qcom_usb_debug_dma_mode {
+    QCOM_USB_DEBUG_DMA_NONE = 0,
+    QCOM_USB_DEBUG_DMA_PRIVATE_TRANSLATED = 16,
+    QCOM_USB_DEBUG_DMA_INHERITED_IDENTITY = 17,
+    QCOM_USB_DEBUG_DMA_BYPASS_BANK = 18
+};
+
+typedef struct qcom_usb_debug_status {
+    uint32_t phase, error;
+    int32_t core_result;
+    uint32_t qcom_result, restore_result, dma_mode, dma_lease_active;
+    uint32_t vbus_owned, vbus_saved;
+    uint32_t phy_owned, phy_saved, phy_applied, phy_restoring, stop_failed;
+    uint32_t dma_address_width, hwparams0;
+    uint32_t last_trace, trace_a, trace_b, traces;
+    uint32_t poll_calls, last_poll_events, io_failed;
+    uint64_t dma_pa, counter_frequency, cache_line, dropped;
+    uint32_t domain_result, domain_stage, domain_bank, domain_slot, domain_asid;
+    uint64_t tables_pa, dma_iova, domain_last_address, domain_last_expected, domain_last_readback;
+    uint32_t diag_enabled, diag_checkpoint;
+    uint64_t buffer_capacity, buffer_pending, buffer_high_water, buffer_accepted;
+    uint64_t buffer_overflow, buffer_contended, buffer_replayed, transport_pending;
+    uint64_t rx_overflow, control_replies;
+    uint32_t rx_pending, rx_generation;
+    uint32_t control_enabled, control_hook_owned, control_reboot_state, control_rejected;
+    /* qcom-usb-prepare=1 only: how far the device-mode bring-up got. */
+    uint32_t prepare_result, prepare_stage, prepare_readback;
+} qcom_usb_debug_status;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Call once on the boot CPU, after arm_vm_init and ExitBootServices, at or
+ * before PE_init_kprintf. Requires exclusive USB ownership and no competing
+ * firmware callbacks. Returns 1 only when the fresh native core is running.
+ * Explicit qcom-usb-debug=1 is mandatory. No hook is installed here. */
+int qcom_usb_debug_init(void);
+/* Candidate PE_kputc sink. All CPUs can enqueue before/during initialization.
+ * IRQ-safe nonspinning CPU-only backlog preserves the oldest bytes; overflow
+ * and producer contention are counted. Hardware service stays on the boot CPU.
+ * A write accepts at most 16KiB; excess is counted and the prefix is returned.
+ * No console, printf, allocation, scheduler or EFI functions are called. */
+void qcom_usb_debug_putc(char c);
+size_t qcom_usb_debug_write(const void *bytes, size_t count);
+/* At most one USB event and a bounded pump; schedule externally if needed. */
+void qcom_usb_debug_poll(void);
+/* Worker-only opt-in. A qualified SoC profile may install the final PSCI
+ * restart callback once, only when PE_halt_restart is NULL. No command runs. */
+int qcom_usb_debug_control_start(void);
+/* One-shot handoff from the USB worker to a dedicated normal reboot thread. */
+int qcom_usb_debug_control_take_reboot(void);
+/* Consume the final restart request only after the ACK and TX backlog drained. */
+int qcom_usb_debug_control_arm_reboot(void);
+void qcom_usb_debug_control_reboot_failed(int result);
+/* Bounded normal-thread drain wait used before reboot_kernel(0, NULL). */
+int qcom_usb_debug_wait_drained(unsigned int timeout_ms);
+/* Early PREPARING diagnosis only; inactive/ACTIVE calls return promptly. */
+void qcom_usb_debug_panic_prepare(void);
+/* Tries to drain messages and an end marker for at most two seconds using
+ * CNTVCT. Explicit reset diagnostics can reboot afterwards; normal mode
+ * neither reboots nor stops XNU. Recursive calls return immediately. */
+void qcom_usb_debug_panic_drain(void);
+/* On success the core is halted and any exact-stream lease restored. Static
+ * DMA arena remains resident even after failure; no allocation is freed. */
+int qcom_usb_debug_stop(void);
+void qcom_usb_debug_get_status(struct qcom_usb_debug_status *status);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/qcomusb/kernel/QcomUsbBuffer.h b/bsd/dev/qcomusb/kernel/QcomUsbBuffer.h
new file mode 100644
index 0000000..b9f0353
--- /dev/null
+++ b/bsd/dev/qcomusb/kernel/QcomUsbBuffer.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SOCRATES_USB_BUFFER_H
+#define SOCRATES_USB_BUFFER_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* CPU-only backlog: never DMA mapped. Callers mask local IRQ/FIQ before
+ * taking this nonspinning guard, including for drain/snapshot operations.
+ * A recursive/competing producer returns immediately and counts lost bytes.
+ * Preserve oldest bytes: an unavailable host must not overwrite early panic
+ * or startup evidence. Finite capacity is reported, never called lossless. */
+#define SOC_USB_LOG_BUFFER_BYTES (4u * 1024u * 1024u)
+#define SOC_USB_LOG_WRITE_BUDGET 16384u
+#define SOC_USB_LOG_DRAIN_BUDGET 4096u
+struct soc_usb_buffer {
+    uint8_t *data;
+    size_t capacity, head, tail, used, high_water;
+    unsigned int busy;
+    uint64_t accepted, overflow, contended;
+};
+typedef size_t (*soc_usb_buffer_sink)(void *, const void *, size_t);
+
+static inline size_t soc_usb_buffer_write(struct soc_usb_buffer *b,
+                                          const void *bytes, size_t count)
+{
+    const uint8_t *p = bytes;
+    size_t n, i;
+    if (!bytes || !count) return 0;
+    if (__atomic_exchange_n(&b->busy, 1u, __ATOMIC_ACQUIRE)) {
+        __atomic_fetch_add(&b->contended, count, __ATOMIC_RELAXED);
+        return 0;
+    }
+    n = count;
+    if (n > SOC_USB_LOG_WRITE_BUDGET) n = SOC_USB_LOG_WRITE_BUDGET;
+    if (n > b->capacity - b->used) n = b->capacity - b->used;
+    for (i = 0; i < n; i++) {
+        b->data[b->head] = p[i];
+        if (++b->head == b->capacity) b->head = 0;
+    }
+    __atomic_store_n(&b->used, b->used + n, __ATOMIC_RELAXED);
+    if (b->used > b->high_water) __atomic_store_n(&b->high_water, b->used, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&b->accepted, n, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&b->overflow, count - n, __ATOMIC_RELAXED);
+    __atomic_store_n(&b->busy, 0u, __ATOMIC_RELEASE);
+    return n;
+}
+
+/* The sink only copies CPU memory; it must never poll hardware, print, wait,
+ * allocate or invoke a scheduler. Consume only the accepted prefix so USB
+ * backpressure and partial copies preserve the exact FIFO order. */
+static inline size_t soc_usb_buffer_drain(struct soc_usb_buffer *b,
+                                          soc_usb_buffer_sink sink, void *cookie,
+                                          size_t budget)
+{
+    size_t n, accepted;
+    if (__atomic_exchange_n(&b->busy, 1u, __ATOMIC_ACQUIRE)) return 0;
+    n = b->used;
+    if (n > budget) n = budget;
+    if (n > SOC_USB_LOG_DRAIN_BUDGET) n = SOC_USB_LOG_DRAIN_BUDGET;
+    if (n > b->capacity - b->tail) n = b->capacity - b->tail;
+    accepted = n ? sink(cookie, b->data + b->tail, n) : 0;
+    /* Defensive sink contract: never advance outside initialized bytes. */
+    if (accepted > n) accepted = 0;
+    b->tail = (b->tail + accepted) % b->capacity;
+    __atomic_store_n(&b->used, b->used - accepted, __ATOMIC_RELAXED);
+    __atomic_store_n(&b->busy, 0u, __ATOMIC_RELEASE);
+    return accepted;
+}
+static inline size_t soc_usb_buffer_pending(const struct soc_usb_buffer *b)
+{
+    return __atomic_load_n(&b->used, __ATOMIC_RELAXED);
+}
+static inline uint64_t soc_usb_buffer_dropped(const struct soc_usb_buffer *b)
+{
+    return __atomic_load_n(&b->overflow, __ATOMIC_RELAXED) +
+           __atomic_load_n(&b->contended, __ATOMIC_RELAXED);
+}
+#endif
diff --git a/bsd/dev/qcomusb/kernel/QcomUsbControl.h b/bsd/dev/qcomusb/kernel/QcomUsbControl.h
new file mode 100644
index 0000000..2571925
--- /dev/null
+++ b/bsd/dev/qcomusb/kernel/QcomUsbControl.h
@@ -0,0 +1,385 @@
+/* SPDX-License-Identifier: MIT
+ * Bounded, allocation-free control framing shared by the kernel control
+ * worker and its host-side conformance tests. This module never performs I/O
+ * and contains no memory, function, or arbitrary register operations.
+ */
+#ifndef QCOM_USB_CONTROL_H
+#define QCOM_USB_CONTROL_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* The newline is part of the 128-byte request-frame ceiling. */
+#define SXNU_CONTROL_FRAME_BYTES 128u
+#define SXNU_CONTROL_LINE_BYTES 127u
+#define SXNU_CONTROL_REPLY_BYTES 512u
+#define SXNU_CONTROL_WORK_BYTES 256u
+#define SXNU_CONTROL_SESSION_HEX 16u
+#define SXNU_CONTROL_SEQ_HEX 8u
+#define SXNU_CONTROL_CRC_HEX 8u
+
+enum sxnu_control_verb {
+    SXNU_CONTROL_VERB_INVALID = 0,
+    SXNU_CONTROL_VERB_HELLO,
+    SXNU_CONTROL_VERB_PING,
+    SXNU_CONTROL_VERB_STATUS,
+    SXNU_CONTROL_VERB_REBOOT,
+    SXNU_CONTROL_VERB_SCREENSHOT,
+    SXNU_CONTROL_VERB_SHOTNEXT
+};
+
+struct sxnu_control_frame {
+    uint64_t session;
+    uint32_t seq;
+    uint32_t crc;
+    enum sxnu_control_verb verb;
+};
+
+struct sxnu_control_parser {
+    uint8_t line[SXNU_CONTROL_FRAME_BYTES];
+    uint16_t used;
+    uint8_t discarding;
+    uint32_t overlong;
+};
+
+struct sxnu_control_state {
+    uint64_t session;
+    uint32_t last_seq;
+    uint32_t generation;
+};
+
+struct sxnu_control_writer {
+    char *out;
+    size_t capacity;
+    size_t used;
+    uint8_t failed;
+};
+
+static inline uint32_t
+sxnu_control_crc32(const void *bytes, size_t count)
+{
+    const uint8_t *p = bytes;
+    uint32_t crc = 0xffffffffu;
+    size_t i;
+
+    for (i = 0; i < count; i++) {
+        unsigned int bit;
+        crc ^= p[i];
+        for (bit = 0; bit < 8; bit++)
+            crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+    }
+    return ~crc;
+}
+
+static inline int
+sxnu_control_hex_value(uint8_t c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static inline int
+sxnu_control_parse_hex(const uint8_t *text, size_t digits, uint64_t *value)
+{
+    uint64_t result = 0;
+    size_t i;
+
+    if (!value || !digits || digits > 16u) return 0;
+    for (i = 0; i < digits; i++) {
+        int digit = sxnu_control_hex_value(text[i]);
+        if (digit < 0) return 0;
+        result = (result << 4) | (uint64_t)digit;
+    }
+    *value = result;
+    return 1;
+}
+
+static inline enum sxnu_control_verb
+sxnu_control_parse_verb(const uint8_t *text, size_t bytes)
+{
+    if (bytes == 5u && text[0] == 'H' && text[1] == 'E' && text[2] == 'L' &&
+        text[3] == 'L' && text[4] == 'O') return SXNU_CONTROL_VERB_HELLO;
+    if (bytes == 4u && text[0] == 'P' && text[1] == 'I' && text[2] == 'N' &&
+        text[3] == 'G') return SXNU_CONTROL_VERB_PING;
+    if (bytes == 6u && text[0] == 'S' && text[1] == 'T' && text[2] == 'A' &&
+        text[3] == 'T' && text[4] == 'U' && text[5] == 'S')
+        return SXNU_CONTROL_VERB_STATUS;
+    if (bytes == 6u && text[0] == 'R' && text[1] == 'E' && text[2] == 'B' &&
+        text[3] == 'O' && text[4] == 'O' && text[5] == 'T')
+        return SXNU_CONTROL_VERB_REBOOT;
+    if (bytes == 10u && text[0] == 'S' && text[1] == 'C' && text[2] == 'R' &&
+        text[3] == 'E' && text[4] == 'E' && text[5] == 'N' && text[6] == 'S' &&
+        text[7] == 'H' && text[8] == 'O' && text[9] == 'T') return SXNU_CONTROL_VERB_SCREENSHOT;
+    if (bytes == 8u && text[0] == 'S' && text[1] == 'H' && text[2] == 'O' &&
+        text[3] == 'T' && text[4] == 'N' && text[5] == 'E' && text[6] == 'X' &&
+        text[7] == 'T') return SXNU_CONTROL_VERB_SHOTNEXT;
+    return SXNU_CONTROL_VERB_INVALID;
+}
+
+static inline const char *
+sxnu_control_verb_name(enum sxnu_control_verb verb)
+{
+    switch (verb) {
+    case SXNU_CONTROL_VERB_HELLO: return "HELLO";
+    case SXNU_CONTROL_VERB_PING: return "PING";
+    case SXNU_CONTROL_VERB_STATUS: return "STATUS";
+    case SXNU_CONTROL_VERB_REBOOT: return "REBOOT";
+    case SXNU_CONTROL_VERB_SCREENSHOT: return "SCREENSHOT";
+    case SXNU_CONTROL_VERB_SHOTNEXT: return "SHOTNEXT";
+    default: return "";
+    }
+}
+
+static inline void
+sxnu_control_parser_reset(struct sxnu_control_parser *parser)
+{
+    if (!parser) return;
+    parser->used = 0;
+    parser->discarding = 0;
+}
+
+/* Feed one byte. Returns 1 for a complete line, 0 while waiting, and -1 when
+ * an overlong line was discarded through its newline. The parser has no
+ * allocation and never interprets a partial frame. */
+static inline int
+sxnu_control_parser_feed(struct sxnu_control_parser *parser, uint8_t byte,
+                         char *line, size_t line_capacity, size_t *line_bytes)
+{
+    if (!parser || !line || !line_bytes || line_capacity == 0u) return -1;
+    if (byte == (uint8_t)'\n') {
+        size_t bytes;
+        if (parser->discarding) {
+            parser->discarding = 0;
+            parser->used = 0;
+            parser->overlong++;
+            return -1;
+        }
+        bytes = parser->used;
+        parser->used = 0;
+        if (!bytes) return 0;
+        if (bytes >= line_capacity) {
+            parser->overlong++;
+            return -1;
+        }
+        for (size_t i = 0; i < bytes; i++) line[i] = (char)parser->line[i];
+        line[bytes] = 0;
+        *line_bytes = bytes;
+        return 1;
+    }
+    if (parser->discarding) return 0;
+    if (parser->used >= SXNU_CONTROL_LINE_BYTES) {
+        parser->discarding = 1;
+        parser->used = 0;
+        return 0;
+    }
+    parser->line[parser->used++] = byte;
+    return 0;
+}
+
+/* Strict grammar:
+ * SXNU1 <16hex session> <8hex seq> <HELLO|PING|STATUS|REBOOT|SCREENSHOT|SHOTNEXT> <8hex crc>
+ * CRC-32/IEEE covers every byte before the space immediately before the CRC. */
+static inline int
+sxnu_control_parse(const char *line, size_t bytes, struct sxnu_control_frame *frame)
+{
+    const uint8_t *p = (const uint8_t *)line;
+    size_t cursor = 5u, verb_start, verb_bytes, crc_start;
+    uint64_t session, seq, crc;
+    enum sxnu_control_verb verb;
+
+    if (!line || !frame || bytes < 6u || bytes > SXNU_CONTROL_LINE_BYTES) return 0;
+    if (p[0] != 'S' || p[1] != 'X' || p[2] != 'N' || p[3] != 'U' || p[4] != '1' ||
+        p[cursor++] != (uint8_t)' ') return 0;
+    if (cursor > bytes || bytes - cursor < SXNU_CONTROL_SESSION_HEX) return 0;
+    if (!sxnu_control_parse_hex(p + cursor, SXNU_CONTROL_SESSION_HEX, &session)) return 0;
+    cursor += SXNU_CONTROL_SESSION_HEX;
+    if (cursor >= bytes || p[cursor++] != (uint8_t)' ') return 0;
+    if (cursor > bytes || bytes - cursor < SXNU_CONTROL_SEQ_HEX) return 0;
+    if (!sxnu_control_parse_hex(p + cursor, SXNU_CONTROL_SEQ_HEX, &seq)) return 0;
+    cursor += SXNU_CONTROL_SEQ_HEX;
+    if (cursor >= bytes || p[cursor++] != (uint8_t)' ') return 0;
+
+    verb_start = cursor;
+    while (cursor < bytes && p[cursor] != (uint8_t)' ') cursor++;
+    if (cursor == verb_start || cursor >= bytes) return 0;
+    verb_bytes = cursor - verb_start;
+    verb = sxnu_control_parse_verb(p + verb_start, verb_bytes);
+    if (verb == SXNU_CONTROL_VERB_INVALID) return 0;
+    cursor++;
+    crc_start = cursor;
+    if (crc_start > bytes || bytes - crc_start != SXNU_CONTROL_CRC_HEX) return 0;
+    if (!sxnu_control_parse_hex(p + crc_start, SXNU_CONTROL_CRC_HEX, &crc)) return 0;
+    if ((uint32_t)crc != sxnu_control_crc32(line, crc_start - 1u)) return 0;
+
+    frame->session = session;
+    frame->seq = (uint32_t)seq;
+    frame->crc = (uint32_t)crc;
+    frame->verb = verb;
+    return 1;
+}
+
+static inline void
+sxnu_control_state_reset(struct sxnu_control_state *state, uint64_t session,
+                         uint32_t generation)
+{
+    if (!state) return;
+    state->session = session;
+    state->last_seq = 0;
+    state->generation = generation;
+}
+
+/* HELLO is read-only and valid only with session zero and sequence zero. All
+ * other commands require the current nonzero session and exactly the next
+ * sequence number. This function has no side effects. */
+static inline enum sxnu_control_verb
+sxnu_control_accept(const struct sxnu_control_state *state,
+                    const struct sxnu_control_frame *frame)
+{
+    if (!state || !frame) return SXNU_CONTROL_VERB_INVALID;
+    if (frame->verb < SXNU_CONTROL_VERB_HELLO ||
+        frame->verb > SXNU_CONTROL_VERB_SHOTNEXT) return SXNU_CONTROL_VERB_INVALID;
+    if (frame->verb == SXNU_CONTROL_VERB_HELLO)
+        return frame->session == 0 && frame->seq == 0 ?
+               SXNU_CONTROL_VERB_HELLO : SXNU_CONTROL_VERB_INVALID;
+    if (!state->session || frame->seq == 0 || frame->session != state->session ||
+        state->last_seq == UINT32_MAX ||
+        frame->seq != state->last_seq + 1u) return SXNU_CONTROL_VERB_INVALID;
+    return frame->verb;
+}
+
+static inline int
+sxnu_control_commit(struct sxnu_control_state *state,
+                    const struct sxnu_control_frame *frame,
+                    enum sxnu_control_verb accepted)
+{
+    if (!state || !frame || accepted < SXNU_CONTROL_VERB_HELLO ||
+        accepted > SXNU_CONTROL_VERB_SHOTNEXT || frame->verb != accepted) return 0;
+    if (accepted == SXNU_CONTROL_VERB_HELLO)
+        return frame->session == 0 && frame->seq == 0;
+    if (!state->session || frame->seq == 0 || frame->session != state->session ||
+        state->last_seq == UINT32_MAX ||
+        frame->seq != state->last_seq + 1u) return 0;
+    state->last_seq = frame->seq;
+    return 1;
+}
+
+static inline void
+sxnu_control_writer_init(struct sxnu_control_writer *writer, char *out, size_t capacity)
+{
+    writer->out = out;
+    writer->capacity = out ? capacity : 0;
+    writer->used = 0;
+    writer->failed = writer->capacity == 0u;
+    if (out && capacity) out[0] = 0;
+}
+
+static inline int
+sxnu_control_writer_put(struct sxnu_control_writer *writer, const char *text,
+                        size_t bytes)
+{
+    size_t i;
+    if (!writer || writer->failed || !text) return 0;
+    if (bytes > writer->capacity - writer->used) {
+        writer->failed = 1;
+        return 0;
+    }
+    for (i = 0; i < bytes; i++) writer->out[writer->used + i] = text[i];
+    writer->used += bytes;
+    if (writer->used < writer->capacity) writer->out[writer->used] = 0;
+    return 1;
+}
+
+static inline int
+sxnu_control_writer_text(struct sxnu_control_writer *writer, const char *text)
+{
+    size_t bytes = 0;
+    if (!text) return 0;
+    while (text[bytes]) bytes++;
+    return sxnu_control_writer_put(writer, text, bytes);
+}
+
+static inline int
+sxnu_control_writer_char(struct sxnu_control_writer *writer, char value)
+{
+    return sxnu_control_writer_put(writer, &value, 1u);
+}
+
+static inline int
+sxnu_control_writer_hex(struct sxnu_control_writer *writer, uint64_t value,
+                        unsigned int digits)
+{
+    static const char alphabet[] = "0123456789abcdef";
+    char text[16];
+    unsigned int i;
+    if (!writer || writer->failed || digits > 16u) return 0;
+    for (i = 0; i < digits; i++) {
+        text[digits - i - 1u] = alphabet[value & 15u];
+        value >>= 4;
+    }
+    return sxnu_control_writer_put(writer, text, digits);
+}
+
+static inline int
+sxnu_control_writer_decimal(struct sxnu_control_writer *writer, uint64_t value)
+{
+    char text[20];
+    unsigned int used = 0;
+    do {
+        text[used++] = (char)('0' + value % 10u);
+        value /= 10u;
+    } while (value);
+    for (unsigned int i = 0; i < used / 2u; i++) {
+        char swap = text[i];
+        text[i] = text[used - i - 1u];
+        text[used - i - 1u] = swap;
+    }
+    return sxnu_control_writer_put(writer, text, used);
+}
+
+static inline int
+sxnu_control_writer_signed(struct sxnu_control_writer *writer, int64_t value)
+{
+    uint64_t magnitude;
+    if (!writer) return 0;
+    if (value < 0) {
+        if (!sxnu_control_writer_char(writer, '-')) return 0;
+        magnitude = (uint64_t)(-(value + 1)) + 1u;
+    } else {
+        magnitude = (uint64_t)value;
+    }
+    return sxnu_control_writer_decimal(writer, magnitude);
+}
+
+static inline int
+sxnu_control_reply_start(struct sxnu_control_writer *writer, uint64_t session,
+                         uint32_t seq, enum sxnu_control_verb verb,
+                         const char *status)
+{
+    if (!writer || verb == SXNU_CONTROL_VERB_INVALID || !status) return 0;
+    return sxnu_control_writer_text(writer, "SXNU1R ") &&
+           sxnu_control_writer_hex(writer, session, SXNU_CONTROL_SESSION_HEX) &&
+           sxnu_control_writer_char(writer, ' ') &&
+           sxnu_control_writer_hex(writer, seq, SXNU_CONTROL_SEQ_HEX) &&
+           sxnu_control_writer_char(writer, ' ') &&
+           sxnu_control_writer_text(writer, sxnu_control_verb_name(verb)) &&
+           sxnu_control_writer_char(writer, ' ') &&
+           sxnu_control_writer_text(writer, status);
+}
+
+/* Append the CRC and newline. Returns the complete reply byte count including
+ * newline, or zero if the fixed 512-byte ceiling would be exceeded. */
+static inline size_t
+sxnu_control_reply_finish(struct sxnu_control_writer *writer)
+{
+    uint32_t crc;
+    if (!writer || writer->failed) return 0;
+    crc = sxnu_control_crc32(writer->out, writer->used);
+    if (!sxnu_control_writer_char(writer, ' ') ||
+        !sxnu_control_writer_hex(writer, crc, SXNU_CONTROL_CRC_HEX) ||
+        !sxnu_control_writer_char(writer, '\n')) return 0;
+    return writer->used;
+}
+
+#endif /* QCOM_USB_CONTROL_H */
diff --git a/bsd/dev/qcomusb/kernel/QcomUsbScreenshot.c b/bsd/dev/qcomusb/kernel/QcomUsbScreenshot.c
new file mode 100644
index 0000000..95a6e99
--- /dev/null
+++ b/bsd/dev/qcomusb/kernel/QcomUsbScreenshot.c
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: MIT */
+#include "QcomUsbScreenshot.h"
+#include "QcomUsbControl.h"
+
+static uint8_t pixels[QUD_SCREENSHOT_MAX_BYTES];
+static unsigned provider_state;
+static qcom_usb_screenshot_capture provider;
+static void *provider_cookie;
+static struct qcom_usb_framebuffer fixed;
+static struct qcom_usb_screenshot_info image;
+static uint32_t cursor, pixel_cursor, peek_bytes, next_pixel;
+static unsigned ready;
+
+static int dimensions(uint32_t w, uint32_t h)
+{
+    return w && h && w <= QUD_SCREENSHOT_MAX_DIMENSION &&
+           h <= QUD_SCREENSHOT_MAX_DIMENSION &&
+           (uint64_t)w * h * 3u <= QUD_SCREENSHOT_MAX_BYTES;
+}
+int qcom_usb_debug_register_screenshot(qcom_usb_screenshot_capture capture, void *cookie)
+{
+    unsigned expected = 0;
+    if (!capture || !__atomic_compare_exchange_n(&provider_state, &expected, 1u,
+        0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return 0;
+    provider = capture; provider_cookie = cookie;
+    __atomic_store_n(&provider_state, 2u, __ATOMIC_RELEASE);
+    return 1;
+}
+static int copy_fixed(void *cookie, uint8_t *rgb, size_t capacity,
+                       uint32_t *width, uint32_t *height)
+{
+    const struct qcom_usb_framebuffer *fb = cookie;
+    if (!dimensions(fb->width, fb->height) || (uint64_t)fb->width * fb->height * 3 > capacity) return 0;
+    for (uint32_t y = 0; y < fb->height; ++y) {
+        const volatile uint8_t *row = fb->pixels + (size_t)y * fb->stride;
+        for (uint32_t x = 0; x < fb->width; ++x) {
+            size_t at = ((size_t)y * fb->width + x) * 3;
+            rgb[at] = row[x * 4 + (fb->format == QCOM_USB_BGRA8888 ? 2 : 0)];
+            rgb[at + 1] = row[x * 4 + 1];
+            rgb[at + 2] = row[x * 4 + (fb->format == QCOM_USB_BGRA8888 ? 0 : 2)];
+        }
+    }
+    *width = fb->width; *height = fb->height;
+    return 1;
+}
+int qcom_usb_debug_register_framebuffer(const struct qcom_usb_framebuffer *fb)
+{
+    unsigned expected = 0;
+    if (!fb || !fb->pixels || !dimensions(fb->width, fb->height) ||
+        (fb->format != QCOM_USB_BGRA8888 && fb->format != QCOM_USB_RGBA8888) ||
+        fb->stride < (uint64_t)fb->width * 4 ||
+        (uint64_t)fb->stride * fb->height > fb->bytes ||
+        fb->bytes > (uintptr_t)-1 - (uintptr_t)fb->pixels ||
+        !__atomic_compare_exchange_n(&provider_state, &expected, 1u,
+        0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return 0;
+    fixed = *fb; provider = copy_fixed; provider_cookie = &fixed;
+    __atomic_store_n(&provider_state, 2u, __ATOMIC_RELEASE);
+    return 1;
+}
+static uint32_t run_length(uint32_t at)
+{
+    uint32_t n = 1, total = image.bytes / 3;
+    while (n < 255 && at + n < total &&
+           pixels[3 * at] == pixels[3 * (at + n)] &&
+           pixels[3 * at + 1] == pixels[3 * (at + n) + 1] &&
+           pixels[3 * at + 2] == pixels[3 * (at + n) + 2]) ++n;
+    return n;
+}
+void qcom_usb_shot_cancel(void)
+{
+    ready = 0; cursor = 0; pixel_cursor = 0; peek_bytes = 0;
+}
+int qcom_usb_shot_capture(uint32_t frame)
+{
+    uint32_t w = 0, h = 0, at = 0, encoded = 0;
+    qcom_usb_shot_cancel();
+    if (__atomic_load_n(&provider_state, __ATOMIC_ACQUIRE) != 2u) return -1;
+    if (!provider(provider_cookie, pixels, sizeof(pixels), &w, &h) || !dimensions(w, h)) return -2;
+    image.width = w; image.height = h; image.bytes = w * h * 3;
+    image.frame = frame; image.crc32 = sxnu_control_crc32(pixels, image.bytes);
+    while (at < image.bytes / 3) { at += run_length(at); encoded += 4; }
+    image.rle = encoded < image.bytes;
+    image.encoded_bytes = image.rle ? encoded : image.bytes;
+    ready = 1;
+    return 1;
+}
+int qcom_usb_shot_info(struct qcom_usb_screenshot_info *info)
+{
+    if (!ready || !info) return 0;
+    *info = image;
+    return 1;
+}
+size_t qcom_usb_shot_peek(uint8_t *out, size_t capacity, uint32_t *offset)
+{
+    size_t n = 0;
+    if (!ready || !out || !offset || !capacity) return 0;
+    if (capacity > QUD_SCREENSHOT_CHUNK) capacity = QUD_SCREENSHOT_CHUNK;
+    *offset = cursor;
+    next_pixel = pixel_cursor;
+    if (image.rle) {
+        while (n + 4 <= capacity && next_pixel < image.bytes / 3) {
+            uint32_t run = run_length(next_pixel);
+            out[n++] = (uint8_t)run;
+            for (unsigned i = 0; i < 3; ++i) out[n++] = pixels[3 * next_pixel + i];
+            next_pixel += run;
+        }
+    } else {
+        n = image.encoded_bytes - cursor;
+        if (n > capacity) n = capacity;
+        for (size_t i = 0; i < n; ++i) out[i] = pixels[cursor + i];
+    }
+    peek_bytes = (uint32_t)n;
+    return n;
+}
+int qcom_usb_shot_commit(size_t bytes)
+{
+    if (!ready || !bytes || bytes != peek_bytes || bytes > image.encoded_bytes - cursor) return 0;
+    cursor += (uint32_t)bytes; pixel_cursor = next_pixel; peek_bytes = 0;
+    return 1;
+}
