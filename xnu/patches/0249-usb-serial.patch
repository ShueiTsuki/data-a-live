+                 * write the stream table at all. */
+                QUSB_U32 idr0 = 0, sacr = 0;
+                if (!physical_read(0, QUSB_SMMU_BASE + 0x20u, &idr0) ||
+                    !physical_read(0, QUSB_SMMU_BASE + 0x10u, &sacr)) {
