+	if (!pa_ready) {
+		printf("PANDORA AMP: TDM clock up, but the amps are not loaded and started\n");
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(pa_tdm_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
