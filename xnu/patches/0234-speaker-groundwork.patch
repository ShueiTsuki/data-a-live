+	ad_shm_va = va;
+	ad_shm_pa = r[0];
+	ad_shm_size = r[1];
+	printf("PANDORA SMMU: DSP buffer %#llx + %#llx, mapped write-combined\n", ad_shm_pa, ad_shm_size);
