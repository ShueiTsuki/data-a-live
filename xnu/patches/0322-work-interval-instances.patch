     uint64_t realtime_max_latency);
 
 extern void machine_work_interval_notify(thread_t thread, struct kern_work_interval_args* kwi_args);
+#if defined(PANDORA)
+struct kern_work_interval_instance_args;
+extern void machine_work_interval_instance_ctl(thread_t thread, uint32_t ctl,
+    struct kern_work_interval_instance_args *args);   /* osfmk/arm/pandora_perfctl.c (0322) */
