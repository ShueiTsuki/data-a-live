diff --git a/bsd/kern/sys_work_interval.c b/bsd/kern/sys_work_interval.c
index 03fd05f..dd3f537 100644
--- a/bsd/kern/sys_work_interval.c
+++ b/bsd/kern/sys_work_interval.c
@@ -270,6 +270,45 @@ work_interval_ctl_inner(__unused proc_t p, struct work_interval_ctl_args *uap,
 
 		break;
 
+#if defined(PANDORA)
+	case WORK_INTERVAL_OPERATION_INSTANCE_START:
+	case WORK_INTERVAL_OPERATION_INSTANCE_UPDATE:
+	case WORK_INTERVAL_OPERATION_INSTANCE_FINISH: {
+		/* 0322: as the 20H392 kernelcache: an update or finish of an instance never started is a no-op; a start
+		 * copies the instance back with the ID the performance controller gave it. */
+		struct work_interval_instance_params instance;
+		if (uap->arg == USER_ADDR_NULL || uap->work_interval_id == 0 || uap->len < sizeof(instance)) {
+			return EINVAL;
+		}
+		if ((error = copyin(uap->arg, &instance, sizeof(instance)))) {
+			return error;
+		}
+		const bool start = operation == WORK_INTERVAL_OPERATION_INSTANCE_START;
+		if (!start && instance.wiip_instance_id == 0) {
+			break;
+		}
+		struct kern_work_interval_instance_args instance_args = {
+			.work_interval_id = uap->work_interval_id,
+			.instance_id = instance.wiip_instance_id,
+			.start = instance.wiip_start,
+			.finish = instance.wiip_finish,
+			.deadline = instance.wiip_deadline,
+			.complexity = instance.wiip_complexity,
+			.create_flags = instance.wiip_create_flags,
+		};
+		kret = kern_work_interval_instance_ctl(current_thread(),
+		    operation - WORK_INTERVAL_OPERATION_INSTANCE_START, &instance_args);
+		if (kret != KERN_SUCCESS) {
+			return EINVAL;
+		}
+		if (start) {
+			instance.wiip_instance_id = instance_args.instance_id;
+			error = copyout(&instance, uap->arg, sizeof(instance));
+		}
+		break;
+	}
+#endif /* PANDORA */
+
 	default:
 		return ENOTSUP;
 	}
