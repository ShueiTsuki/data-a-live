diff --git a/osfmk/kern/work_interval.c b/osfmk/kern/work_interval.c
index f2b9ce2..2f1fa39 100644
--- a/osfmk/kern/work_interval.c
+++ b/osfmk/kern/work_interval.c
@@ -1013,6 +1013,36 @@ kern_work_interval_notify(thread_t thread, struct kern_work_interval_args* kwi_a
 	return KERN_SUCCESS;
 }
 
+#if defined(PANDORA)
+/*
+ * 0322: a work interval instance, as the 20H392 iPhone10,3 kernelcache does it: the calling thread must have
+ * joined the work interval; an ignored one (WORK_INTERVAL_FLAG_IGNORED) succeeds without a callout; a
+ * complexity is refused where the workload has an ID without WORK_INTERVAL_WORKLOAD_ID_COMPLEXITY_ALLOWED.
+ * (Apple's also fails on one thread flag this source does not show; not modeled.)
+ */
+kern_return_t
+kern_work_interval_instance_ctl(thread_t thread, uint32_t ctl, struct kern_work_interval_instance_args *args)
+{
+	assert(thread == current_thread());
+
+	struct work_interval *work_interval = thread->th_work_interval;
+	if (args->work_interval_id == 0 || work_interval == NULL ||
+	    work_interval->wi_id != args->work_interval_id) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	if (args->create_flags & WORK_INTERVAL_FLAG_IGNORED) {
+		return KERN_SUCCESS;
+	}
+	if (args->complexity != 0 &&
+	    (work_interval->wi_wlid_flags & (WORK_INTERVAL_WORKLOAD_ID_COMPLEXITY_ALLOWED | WORK_INTERVAL_WORKLOAD_ID_HAS_ID)) ==
+	    WORK_INTERVAL_WORKLOAD_ID_HAS_ID) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	machine_work_interval_instance_ctl(thread, ctl, args);
+	return KERN_SUCCESS;
+}
+#endif /* PANDORA */
+
 /* Start at 1, 0 is not a valid work interval ID */
 static _Atomic uint64_t unique_work_interval_id = 1;
 
