--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -1157,6 +1157,44 @@
  *		activators should not be given the opportunity to attempt
  *		to activate the image.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * sweetnoexec=a,b,...: daemons that only respawn-loop on this hardware
+ * (no Bluetooth, no FairPlay). Failing their exec here, before dyld, keeps
+ * the launchd retries cheap. Each name is logged on its first refusal.
+ */
+static bool
+sweet_exec_blocked(const char *name)
+{
+	static char list[256];
+	static int state;       /* 0 unread, 1 none, 2 list */
+	static uint32_t logged;
+	if (state == 0) {
+		state = PE_parse_boot_argn("sweetnoexec", list, sizeof(list)) && list[0] ? 2 : 1;
+	}
+	if (state != 2) {
+		return false;
+	}
+	size_t len = strlen(name);
+	unsigned idx = 0;
+	for (const char *s = list; *s; idx++) {
+		const char *e = s;
+		while (*e && *e != ',') {
+			e++;
+		}
+		if ((size_t)(e - s) == len && strncmp(s, name, len) == 0) {
+			if (idx < 32 && !(logged & (1u << idx))) {
+				logged |= 1u << idx;
+				printf("exec %s blocked (sweetnoexec)\n", name);
+			}
+			return true;
+		}
+		s = *e ? e + 1 : e;
+	}
+	return false;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 static int
 exec_mach_imgact(struct image_params *imgp)
 {
@@ -7412,6 +7450,12 @@
 				goto done;
 			}
 #if defined(ARM64_BOARD_CONFIG_SWEET)
+			if (sweet_exec_blocked(p->p_name)) {
+				signature_failure_reason = os_reason_create(OS_REASON_EXEC,
+				    EXEC_EXIT_REASON_WRONG_PLATFORM);
+				error = EACCES;
+				goto done;
+			}
 			/* SWEET runs every iOS binary this way: one short line per exec. */
 			printf("exec %s\n", p->p_name);
 #else
