+
+/// Nor does its choice for one that renders or is written (`padded_targets`).
+#[test]
+fn the_runtime_s_padded_targets_choice_keys_no_profile() {
+    use crate::spirv::testing::committed_profiles_with;
+    let shadow = committed_profiles_with(DevicePolicy::UNTRUSTED).expect("profiles");
+    let alias = committed_profiles_with(DevicePolicy {
+        padded_targets: PaddedTargetsPolicy::Alias,
+        ..DevicePolicy::UNTRUSTED
+    })
+    .expect("profiles");
+    assert!(shadow.len() >= 10, "{} profiles", shadow.len());
+    assert_eq!(shadow.len(), alias.len());
+    for ((stem, s), (other, a)) in shadow.iter().zip(&alias) {
+        assert_eq!(stem, other);
+        assert_eq!(s.fingerprint(), a.fingerprint(), "{stem}");
+    }
+}
