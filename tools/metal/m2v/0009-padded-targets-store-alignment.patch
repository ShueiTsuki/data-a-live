+/// Whether the render pass stores of a padded texture of `layout` over `texels` rendering in
+/// place stay inside its own rows, where a store that ends at its right or bottom edge may write
+/// on to the next multiples of `alignment`'s width and height in texels
+/// (`DeviceOptions::render_store_alignment`): one slice, its height a multiple of the aligned
+/// height (no row past its last is written), its rows at least its aligned width apart (each
+/// row's writes end in the bytes between it and the next), and the last row's aligned bytes
+/// inside the buffer. Always, where the driver's stores write the render area alone (`None`).
+fn stores_stay_in_rows(texels: &Texels, layout: &TextureLayout, alignment: Option<[u32; 2]>) -> bool {
+    let Some([align_w, align_h]) = alignment else {
+        return true;
+    };
+    let rows = &texels.layout;
+    let [width, height, _] = layout.extent.map(u64::from);
+    if rows.slices != 1 || layout.levels != 1 || width == 0 || rows.row_bytes % width != 0 {
+        return false;
+    }
+    let texel = rows.row_bytes / width;
+    let reached = width.next_multiple_of(u64::from(align_w.max(1))) * texel;
+    let last_row = rows.offset + (height.max(1) - 1) * rows.row_pitch;
+    height % u64::from(align_h.max(1)) == 0
+        && reached <= rows.row_pitch
+        && last_row + reached <= texels.buffer.length()
+}
+
 fn view_error(call: &'static str, refusal: ViewRefusal) -> Error {
     match refusal {
         ViewRefusal::Invalid(problem) => invalid(call, Problem::TextureView(problem)),
@@ -1961,10 +1985,16 @@ impl Device {
         })?;
