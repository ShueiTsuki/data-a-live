         // where the texture only reads, by the policy (`linear_plan::holding`), and where it
-        // renders or is written under `PaddedTargetsPolicy::Alias`; else why none may.
+        // renders or is written under `PaddedTargetsPolicy::Alias`, its driver's stores staying
+        // in its rows (`stores_stay_in_rows`); else why none may.
         let policy = self.compile_device().policy();
+        let alignment = self.shared().render_store_alignment;
