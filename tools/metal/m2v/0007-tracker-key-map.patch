From 4c8632fc16f4fcc9ed5d9ab93fc9bf56ff9bb44d Mon Sep 17 00:00:00 2001
From: root <root@MSI.localdomain>
Date: Sun, 25 Oct 2026 20:11:05 +0800
Subject: [PATCH] runtime: an encoder's tracked uses keyed through KeyMap

An encoder's own maps of the resources its commands used (EncoderUses'
parts and the order of an ordered encoder's commands, UnorderedWrites, and
merged's index) hashed the runtime's own keys with the standard maps'
SipHash-1-3, which key_hash.rs replaced for the tracker's batch maps: these
keys are numbered by the runtime, not chosen to collide, and every draw
looks each of its uses up here. They take KeyMap now.

The standard maps' random keys made their iteration order differ from run
to run already, so no caller could depend on it (EncoderUses::tracked_in
collects in it; finish_parts and merged sort by key).

The equivalence runs fail the same tests as before (up to the known flaky
worker ones). frame_costs_plain's times on lavapipe vary more from run to
run than this changes them.
---
 crates/metal2vulkan-runtime/src/tracker.rs | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/crates/metal2vulkan-runtime/src/tracker.rs b/crates/metal2vulkan-runtime/src/tracker.rs
index 58ccac6..8350242 100644
--- a/crates/metal2vulkan-runtime/src/tracker.rs
+++ b/crates/metal2vulkan-runtime/src/tracker.rs
@@ -909,7 +909,7 @@ fn coalesce(entries: &mut Vec<Entry>) {
 /// The uses one per key and range, sorted by key, without the ones that touch nothing.
 fn merged<S: Copy + Ord + Hash>(uses: impl IntoIterator<Item = Use<S>>) -> Vec<Use<S>> {
     let mut merged: Vec<Use<S>> = Vec::new();
-    let mut index: HashMap<(S, UseRange), usize> = HashMap::new();
+    let mut index: KeyMap<(S, UseRange), usize> = KeyMap::default();
     for used in uses {
         if used.is_nothing() {
             continue;
@@ -945,7 +945,7 @@ pub(super) struct EncoderUses<K> {
     /// Whether Metal runs the commands in encoded order (blit encoders, serial compute encoders).
     ordered: bool,
     /// The accesses of the current part's commands so far, for that order.
-    inside: HashMap<Class<K>, Vec<Entry>>,
+    inside: KeyMap<Class<K>, Vec<Entry>>,
     /// The parts, in order: the last is the current one. Never empty.
     parts: Vec<Part<K>>,
     /// The fences waited for: before the encoder's first part.
@@ -957,7 +957,7 @@ pub(super) struct EncoderUses<K> {
 /// The uses of one part of an encoder.
 struct Part<K> {
     /// The tracked uses so far, one per range, at most [`ENTRIES_PER_KEY`] per resource.
-    tracked: HashMap<K, KeyUses<K>>,
+    tracked: KeyMap<K, KeyUses<K>>,
     stages: vk::PipelineStageFlags2,
 }
 
@@ -1008,7 +1008,7 @@ impl<K> KeyUses<K> {
 impl<K> Part<K> {
     fn new() -> Part<K> {
         Part {
-            tracked: HashMap::new(),
+            tracked: KeyMap::default(),
             stages: vk::PipelineStageFlags2::NONE,
         }
     }
@@ -1019,7 +1019,7 @@ impl<K: Copy + Ord + Hash> EncoderUses<K> {
     pub(super) fn new(ordered: bool) -> EncoderUses<K> {
         EncoderUses {
             ordered,
-            inside: HashMap::new(),
+            inside: KeyMap::default(),
             parts: vec![Part::new()],
             waits: Vec::new(),
             updates: Vec::new(),
@@ -1247,14 +1247,14 @@ impl<K> fmt::Debug for EncoderUses<K> {
 /// commands after them. One entry per range, at most [`ENTRIES_PER_KEY`] per resource, merged
 /// as [`EncoderUses`] merges its own, which claims more and stays exact.
 pub(super) struct UnorderedWrites<K> {
-    writes: HashMap<K, Vec<Use<K>>>,
+    writes: KeyMap<K, Vec<Use<K>>>,
 }
 
 impl<K: Copy + Ord + Hash> UnorderedWrites<K> {
     /// No writes.
     pub(super) fn new() -> UnorderedWrites<K> {
         UnorderedWrites {
-            writes: HashMap::new(),
+            writes: KeyMap::default(),
         }
     }
 
